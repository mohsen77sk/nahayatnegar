---
import { URLS } from "@utils/url";
import Layout from "@layouts/Layout.astro";
import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import BreadCrumb from "@components/bread-crumb.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import BannerCard from "@components/bannerCard.astro";
import ImageCard from "@components/imageCard.astro";
import Faq from "@components/faq.astro";

import Section1Img from "@assets/images/Brokerage/1-Neo Trader/Instrument/instrument-hero.png";
import Section1ImgMob from "@assets/images/Brokerage/1-Neo Trader/Instrument/instrument-hero-mob.png";
import MockupImageMob from "@assets/images/Brokerage/1-Neo Trader/Instrument/Mockups/imac.png";
import MockupImageWeb from "@assets/images/Brokerage/1-Neo Trader/Instrument/Mockups/laptop.png";
import BannerWeb from "@assets/images/Brokerage/1-Neo Trader/Instrument/banner.png";

import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import Link from "@assets/icons/iconsax/outline/link.svg";
import HomeTrendUp from "@assets/icons/iconsax/outline/home-trend-up.svg";
import User from "@assets/icons/iconsax/outline/user.svg";
import Activity from "@assets/icons/iconsax/outline/activity.svg";

const BreadCrumbItem = [
  {
    label: "کارگزاری",
    href: "/brokerage",
  },
  {
    label: "نئوتریدر",
    href: "/brokerage/neo-trader",
  },
  {
    label: "اطلاعات نماد",
  },
];

const features = [
  {
    title: "اطلاعات قیمت",
    description: `وضعیت قیمت را لحظه‌ای دنبال کنید<br/>
اطلاعات مربوط به قیمت نماد و تغییرات آن را مشاهده کنید و وضعیت جاری معاملات را زیر نظر داشته باشید.`,
    icon: HomeTrendUp,
  },
  {
    title: "اطلاعات حقیقی و حقوقی",
    description: `اطلاعات معاملات حقیقی و حقوقی نماد را مشاهده کنید و میزان مشارکت هر گروه را در معاملات بررسی کنید.<br/>
همچنین اطلاعات سرانه خرید حقیقی و حقوقی و تغییر مالکیت از حقیقی به حقوقی و بالعکس در اختیار شما قرار دارد.`,
    icon: User,
  },
  {
    title: "اطلاعات کامل نماد",
    description: `مشخصات نماد را یکجا ببینید<br/>
اطلاعاتی مانند بازه مجاز قیمت، بیشترین و کمترین قیمت، حجم مبنا و سایر مشخصات نماد در دسترس شما قرار دارد.`,
    icon: Activity,
  },
  {
    title: "دسترسی به اطلاعات و منابع مرتبط",
    description: `اطلاعات تکمیلی را سریع‌تر پیدا کنید<br/>
لینک‌های مرتبط با نماد، از جمله دسترسی به اطلاعات منتشرشده در TSE و کدال، در اختیار شما قرار دارد تا در صورت نیاز بتوانید اطلاعات تکمیلی نماد را بررسی کنید.`,
    icon: Link,
  },
];

const faqs = [
  {
    title: "بازه مجاز قیمت چیست؟",
    description:
      "بازه مجاز، محدوده قیمتی است که سفارش‌های خرید و فروش یک نماد در طول جلسه معاملاتی می‌توانند در آن ثبت شوند. این محدوده بر اساس مقررات بازار تعیین می‌شود و در صفحه اطلاعات نماد قابل مشاهده است.",
  },
  {
    title: "حجم مبنا چیست؟",
    description:
      "حجم مبنا یکی از اطلاعات معاملاتی نماد است که در محاسبه تغییر قیمت پایانی نقش دارد. مقدار حجم مبنا برای هر نماد در اطلاعات آن نمایش داده می‌شود.",
  },
  {
    title: "سرانه خرید حقیقی و حقوقی چیست؟",
    description:
      "سرانه خرید حقیقی، میانگین ارزش خرید انجام‌شده توسط هر خریدار حقیقی است. بررسی سرانه خرید حقیقی و حقوقی می‌تواند دید بهتری نسبت به اندازه معاملات انجام‌شده توسط این دو گروه ارائه دهد.",
  },
  {
    title: "تغییر مالکیت حقیقی و حقوقی یعنی چه؟",
    description:
      "تغییر مالکیت حقیقی و حقوقی نشان می‌دهد در جریان معاملات، چه مقداری از سهام از سرمایه‌گذاران حقوقی به حقیقی منتقل شده است. این اطلاعات می‌تواند برای بررسی رفتار معاملاتی حقیقی‌ها و حقوقی‌ها مورد استفاده قرار گیرد.",
  },
  {
    title: "اطلاعیه‌های مربوط به یک نماد را از کجا ببینم؟",
    description:
      "اطلاعیه‌های رسمی شرکت‌ها در سامانه کدال منتشر می‌شوند. از بخش اطلاعات نماد در NeoTrader می‌توانید به لینک مرتبط با کدال دسترسی داشته باشید و اطلاعیه‌های شرکت را در منبع اصلی آن‌ها مشاهده کنید.",
  },
  {
    title: "پیام ناظر با اطلاعیه کدال چه تفاوتی دارد؟",
    description:
      "پیام ناظر، اطلاع‌رسانی مربوط به وضعیت معاملات و تصمیمات ناظر بازار درباره نماد است؛ در حالی که اطلاعیه‌های کدال معمولاً شامل اطلاعات رسمی منتشرشده توسط شرکت‌ها و ناشران است.",
  },
  {
    title: "قیمت پایانی با آخرین قیمت معامله چه تفاوتی دارد؟",
    description:
      "آخرین قیمت معامله، قیمت آخرین معامله انجام‌شده در نماد است، در حالی که قیمت پایانی بر اساس معاملات انجام‌شده و حجم مبنای نماد، در طول جلسه معاملاتی محاسبه می‌شود.",
  },
  {
    title: "عمق بازار چه اطلاعاتی را نشان می‌دهد؟",
    description:
      "عمق بازار، وضعیت سفارش‌های خرید و فروش در سطوح مختلف قیمت را نشان می‌دهد و تصویر دقیق‌تری از عرضه و تقاضای موجود در نماد ارائه می‌کند.",
  },
];
---

<Layout title="اطلاعات نماد">
  <main>
    <SectionLayer2 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <h1 class="text-display-small text-white">اطلاعات نماد</h1>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          اطلاعات قیمت، عمق بازار، رفتار خریداران و فروشندگان، معاملات حقیقی و حقوقی و سایر اطلاعات مهم نماد را برای
          بررسی دقیق‌تر بازار مشاهده کنید.
        </p>
        <div class="flex flex-col gap-4 lg:flex-row">
          <a class="neo-button neo-button-fill-primary neo-button-large" href={URLS.neoTraderAppAddress}>
            ورود به سامانه
            <ArrowLeft aria-hidden="true" />
          </a>
        </div>
      </div>
    </SectionLayer2>

    <section class="mx-auto mb-15 flex max-w-200 flex-col gap-6 p-4">
      <BreadCrumb items={BreadCrumbItem} />

      <div>
        <h2 class="text-heading-medium leading-10">اطلاعات نماد چیست؟</h2>
      </div>

      <p class="text-body-large leading-8">
        پیش از انجام معامله، بررسی قیمت و وضعیت عرضه و تقاضا تنها بخشی از اطلاعات موردنیاز برای شناخت یک نماد است. بخش
        اطلاعات نماد در NeoTrader مجموعه‌ای از داده‌های معاملاتی و اطلاعات مرتبط با نماد را در اختیار شما قرار می‌دهد؛
        از وضعیت لحظه‌ای قیمت و عمق بازار گرفته تا اطلاعات حقیقی و حقوقی، پیام‌های ناظر و اطلاعات معاملاتی نماد. به این
        ترتیب می‌توانید وضعیت یک نماد را از جنبه‌های مختلف بررسی کنید و با اطلاعات کامل‌تری تصمیم بگیرید.
      </p>

      <ImageCard image={MockupImageMob} alt="" />

      <div class="features mb-5">
        <h2 class="pb-5 text-heading-medium leading-10">ویژگی‌های اصلی</h2>
        <FeaturesGrid features={features} rowPattern={[2, 2]} />
      </div>

      <h2 class="text-heading-medium leading-10">مزیت برای معامله‌گر</h2>

      <div>
        <h4 class="text-heading-medium leading-10">اطلاعات به‌روز، تصمیم‌گیری سریع‌تر</h4>
        <p class="text-body-large leading-8">
          در بازار سرمایه، ارزش اطلاعات به زمان دریافت آن وابسته است. تغییر قیمت، وضعیت عرضه و تقاضا و اطلاعات معاملاتی
          یک نماد می‌تواند در طول روز تغییر کند و تصمیم‌گیری بر اساس داده‌های قدیمی، تصویر دقیقی از شرایط فعلی بازار
          ارائه نمی‌دهد. در NeoTrader، اطلاعات نماد به‌صورت به‌روز در اختیار شما قرار می‌گیرد تا هنگام بررسی یک سهم،
          آخرین وضعیت بازار را مشاهده کنید و سریع‌تر شرایط نماد را ارزیابی کنید. این به‌روزرسانی سریع، به‌خصوص هنگام
          تغییرات لحظه‌ای بازار، کمک می‌کند اطلاعات مورد استفاده برای تصمیم‌گیری تا حد امکان با وضعیت جاری معاملات
          هماهنگ باشد.
        </p>
      </div>

      <ImageCard image={MockupImageWeb} alt="" />

      <Faq faqs={faqs} />

      <BannerCard desktopImage={BannerWeb} mobileImage={BannerWeb}>
        <div class="flex flex-col gap-2 text-white lg:w-94">
          <h1 class="text-heading-medium leading-10">قبل از معامله، اطلاعات نماد را بررسی کنید</h1>
          <p class="text-body-meduim leading-8 text-neutral-500">
            قیمت، عمق بازار، رفتار حقیقی و حقوقی و اطلاعات معاملاتی نماد را بررسی کنید و با دید کامل‌تری تصمیم بگیرید.
          </p>
        </div>
        <a href={URLS.neoTraderAppAddress} class="neo-button neo-button-fill-primary neo-button-large w-40 min-w-25">
          ورود به سامانه
          <ArrowLeft aria-hidden="true" />
        </a>
      </BannerCard>
    </section>
  </main>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import BreadCrumb from "@components/bread-crumb.astro";
import LineGradient from "@components/line-gradient.astro";
import Banner from "@components/banner.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";

import SectionLayer1 from "@components/@layout/section-layer-1.astro";
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";

import HeroBg from "@assets/images/Brokerage/1-Neo Trader/neo-trader-hero.png";
import HeroBgMobile from "@assets/images/Brokerage/1-Neo Trader/neo-trader-hero-mob.png";

import WatchlistBg from "@assets/images/Brokerage/1-Neo Trader/watchlist-section.png";
import WatchlistBgMobile from "@assets/images/Brokerage/1-Neo Trader/watchlist-section-mob.png";

import TechnicalBg from "@assets/images/Brokerage/1-Neo Trader/technical-section.png";
import TechnicalBgMobile from "@assets/images/Brokerage/1-Neo Trader/technical-section-mob.png";

import OptionBg from "@assets/images/Brokerage/1-Neo Trader/option-section.png";
import OptionBgMobile from "@assets/images/Brokerage/1-Neo Trader/option-section-mob.png";

import ScreenerBg from "@assets/images/Brokerage/1-Neo Trader/screener-section.png";
import ScreenerBgMobile from "@assets/images/Brokerage/1-Neo Trader/screener-section-mob.png";

import HeatMapBg from "@assets/images/Brokerage/1-Neo Trader/heatmap-bg.png";

import Global from "@assets/icons/iconsax/outline/global.svg";
import Clock from "@assets/icons/iconsax/outline/wrist-clock.svg";
import TickCircl from "@assets/icons/iconsax/outline/tick-circle.svg";
import ProfileTick from "@assets/icons/iconsax/outline/profile-tick.svg";
import Brush from "@assets/icons/iconsax/outline/brush-2.svg";
import Profile2User from "@assets/icons/iconsax/outline/profile-2user.svg";
import { siteUrl } from "@utils/url";
import URLS from "../../../scripts/constants";

const features = [
  {
    title: "همه ابزارهای مورد نیاز، در یک سامانه",
    icon: TickCircl,
  },
  {
    title: "سرعت در دسترسی، نه فقط در انجام معامله",
    icon: Clock,
  },
  {
    title: "سامانه‌ای در خدمت سبک معاملاتی شما",
    icon: ProfileTick,
  },
  {
    title: "طراحی مدرن، تجربه‌ای ساده‌تر",
    icon: Brush,
  },
  {
    title: "از مبتدی تا حرفه‌ای",
    icon: Profile2User,
  },
  {
    title: "سامانه تحت وب؛ همیشه در دسترس",
    icon: Global,
  },
];
---

<Layout title="خانه">
  <main>
    <SectionLayer1 desktopImage={HeroBg} mobileImage={HeroBgMobile}>
      <div class="flex items-center justify-end flex-1" slot="left"></div>

      <div class="flex items-center flex-1" slot="right">
        <div class="flex flex-col gap-8 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <div class="flex flex-col items-center lg:items-start">
              <h1 class="text-display-small text-white">
                <span class="block">نئوتریدر؛</span>
                سامانه معاملات آنلاین کارگزاری نهایت‌نگر
              </h1>
            </div>
          </div>

          <div class="flex flex-col gap-8 items-center lg:items-start">
            <p class="text-body-large text-body-large--font-weight leading-8 text-center text-white lg:text-justify">
              نسل جدید معاملات آنلاین در بازار سرمایه
            </p>

            <div class="flex items-center gap-4">
              <a
                href={siteUrl(URLS.registerAddress)}
                target="_blank"
                rel="noopener noreferrer"
                class="neo-button neo-button-fill-primary neo-button-large"
              >
                افتتاح حساب
                <ArrowLeft aria-hidden="true" />
              </a>
              <a
                href={siteUrl(URLS.neoTraderAppAddress)}
                target="_blank"
                rel="noopener noreferrer"
                class="neo-button neo-button-large neo-button-outline-primary"
              >
                ورود به سامانه
                <ArrowLeft aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </SectionLayer1>

    <section class="max-w-lg w-full px-3 mx-auto">
      <BreadCrumb
        items={[
          {
            label: "کارگزاری",
            href: "/brokerage",
          },
          {
            label: "نئوتریدر",
          },
        ]}
      />

      <div class="mb-10">
        <div class="flex flex-col-reverse lg:flex-row items-center gap-6 my-9">
          <LineGradient />
          <div class="flex flex-col items-center lg:items-start">
            <span class="text-secondary">NeoTrader</span>
            <h1 class="text-display-small">سامانه نئوتریدر</h1>
          </div>
        </div>

        <div class="pr-6">
          <p class="text-body-large leading-[210%] whitespace-pre-line">
            NeoTrader نسل جدید سامانه معاملات آنلاین کارگزاری نهایت‌نگر است؛ سامانه‌ای که با هدف ایجاد تجربه‌ای بهتر از
            معاملات آنلاین، بر پایه فناوری‌های روز و نیازهای واقعی سرمایه‌گذاران توسعه یافته است.
          </p>

          <p class="text-body-large leading-[210%] whitespace-pre-line">
            در طراحی این سامانه، تلاش شده است تمام مراحل یک معامله، از بررسی وضعیت بازار و تحلیل نمادها تا ثبت سفارش،
            مدیریت پرتفوی و مشاهده گزارش‌های معاملاتی، در یک محیط یکپارچه و کاربرپسند انجام شود.
          </p>

          <p class="text-body-large leading-[210%] whitespace-pre-line">
            امکان انجام معاملات بورس اوراق بهادار، صندوق‌های سرمایه‌گذاری و اختیار معامله، در کنار ابزارهایی مانند
            دیده‌بان بازار، تحلیل تکنیکال، اسکرینر، نقشه بازار و اطلاعات جامع نمادها، مجموعه‌ای کامل از امکانات مورد
            نیاز برای معامله‌گران را در اختیار شما قرار می‌دهد.
          </p>
        </div>
      </div>

      <Banner>
        <h6 class="text-title-large text-blue-800 leading-relaxed">
          <span class="block">NeoTrader تنها یک سامانه ثبت سفارش نیست؛</span>
          بلکه محیطی برای بررسی بازار، تحلیل فرصت‌های سرمایه‌گذاری و مدیریت دارایی‌ها است تا بتوانید با دیدی دقیق‌تر و
          اطلاعات کامل‌تر تصمیم‌گیری کنید.
        </h6>
      </Banner>

      <div class="features mb-9">
        <h4 class="text-heading-medium py-9">چرا معامله‌گران NeoTrader را انتخاب می‌کنند؟</h4>
        <FeaturesGrid features={features} rowPattern={[3, 3]} />
      </div>
    </section>

    <SectionLayer1 desktopImage={WatchlistBg} mobileImage={WatchlistBgMobile}>
      <div class="flex items-center flex-0 lg:flex-1 order-1 lg:order-2" slot="left">
        <div class="flex flex-col gap-6 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <LineGradient />
            <div class="flex flex-col items-center lg:items-start">
              <h1 class="text-display-small text-white">دیده‌بان بازار</h1>
              <span class="text-body-medium text-neutral-500">بازار را همان‌طور ببینید که برای شما اهمیت دارد</span>
            </div>
          </div>

          <div class="flex flex-col gap-4 items-center lg:items-start lg:pr-6">
            <div>
              <p class="text-body-large leading-[210%] text-center text-white lg:text-justify">
                دیده‌بان بازار این امکان را فراهم می‌کند تا نمادهای موردنظر خود را در فهرست‌های اختصاصی دسته‌بندی کنید و
                تنها اطلاعاتی را مشاهده کنید که برای تصمیم‌گیری به آن‌ها نیاز دارید.
              </p>
              <p class="text-body-large leading-[210%] text-center text-white lg:text-justify">
                در کنار دیده‌بان‌های شخصی، مجموعه‌ای از دیده‌بان‌های سیستمی نیز در اختیار شما قرار گرفته است تا بتوانید
                گروه‌های مختلف بازار را بدون نیاز به ایجاد فهرست جدید دنبال کنید.
              </p>
            </div>

            <a class="neo-button neo-button-fill-primary neo-button-meduim" href={siteUrl("/brokerage/watchlist")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <div class="flex items-center flex-0 lg:flex-1" slot="right"></div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={TechnicalBg} mobileImage={TechnicalBgMobile}>
      <div class="flex items-center justify-end flex-1" slot="left"></div>

      <div class="flex items-center flex-1" slot="right"></div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={OptionBg} mobileImage={OptionBgMobile}>
      <div class="flex items-center flex-0 lg:flex-1 order-1 lg:order-2" slot="left">
        <div class="flex flex-col gap-6 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <LineGradient />
            <div class="flex flex-col items-center lg:items-start gap-2">
              <h1 class="text-display-small text-white">معاملات اختیار معامله</h1>
              <span class="text-body-medium text-neutral-500">
                همه ابزارهای مورد نیاز معامله‌گران اختیار، در یک محیط واحد
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-4 items-center lg:items-start lg:pr-6 pt-3 pb-3">
              <p class="text-body-large leading-[210%] text-center text-white lg:text-right">
                بازار اختیار معامله نیازمند بررسی هم‌زمان قراردادها، قیمت‌ها و استراتژی‌های مختلف است.
                <br />
                در این بخش می‌توانید زنجیره قراردادها را مشاهده کنید، اطلاعات هر قرارداد را بررسی کنید و استراتژی‌های
                معاملاتی موردنظر خود را تعریف و مدیریت کنید. <br />
                این امکانات به شما کمک می‌کند فرصت‌های بازار اختیار معامله را سریع‌تر شناسایی کرده و تصمیم‌های خود را با
                اطلاعات کامل‌تری اتخاذ کنید.
              </p>

            <a class="neo-button neo-button-fill-primary neo-button-meduim w-50 h-8.5 min-w-15 lg:w-auto" href={siteUrl("/brokerage/option")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <div class="flex items-center flex-0 lg:flex-1" slot="right"></div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={ScreenerBg} mobileImage={ScreenerBgMobile}>
      <div class="flex items-center justify-end flex-1" slot="left"></div>

      <div class="flex items-center flex-1" slot="right"></div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={HeatMapBg} mobileImage={HeatMapBg}>
      <div class="flex items-center justify-end flex-1" slot="left"></div>

      <div class="flex items-center flex-1" slot="right"></div>
    </SectionLayer1>
  </main>
</Layout>

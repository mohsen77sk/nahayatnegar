---
import { Image } from "astro:assets";

import Layout from "@layouts/Layout.astro";

import SectionLayer1 from "@components/@layout/section-layer-1.astro";
import Banner from "@components/banner.astro";
import BreadCrumb from "@components/bread-crumb.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import LineGradient from "@components/line-gradient.astro";

import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import Brush from "@assets/icons/iconsax/outline/brush-2.svg";
import Global from "@assets/icons/iconsax/outline/global.svg";
import Profile2User from "@assets/icons/iconsax/outline/profile-2user.svg";
import ProfileTick from "@assets/icons/iconsax/outline/profile-tick.svg";
import TickCircl from "@assets/icons/iconsax/outline/tick-circle.svg";
import Clock from "@assets/icons/iconsax/outline/wrist-clock.svg";
import MarketMapBg from "@assets/images/Brokerage/1-Neo Trader/heatmap-bg.png";
import MarketMapObj from "@assets/images/Brokerage/1-Neo Trader/heatmap-object.png";
import HeroBgMobile from "@assets/images/Brokerage/1-Neo Trader/neo-trader-hero-mob.png";
import HeroBg from "@assets/images/Brokerage/1-Neo Trader/neo-trader-hero.png";
import OptionBgMobile from "@assets/images/Brokerage/1-Neo Trader/option-section-mob.png";
import OptionBg from "@assets/images/Brokerage/1-Neo Trader/option-section.png";
import PortfolioObj from "@assets/images/Brokerage/1-Neo Trader/portfolio-management-object.png";
import ScreenerBgMobile from "@assets/images/Brokerage/1-Neo Trader/screener-section-mob.png";
import ScreenerBg from "@assets/images/Brokerage/1-Neo Trader/screener-section.png";
import SymbolInfoObj from "@assets/images/Brokerage/1-Neo Trader/Symbol-info--object.png";
import TechnicalBgMobile from "@assets/images/Brokerage/1-Neo Trader/technical-section-mob.png";
import TechnicalBg from "@assets/images/Brokerage/1-Neo Trader/technical-section.png";
import WatchlistBgMobile from "@assets/images/Brokerage/1-Neo Trader/watchlist-section-mob.png";
import WatchlistBg from "@assets/images/Brokerage/1-Neo Trader/watchlist-section.png";

import { siteUrl } from "@utils/url";

import URLS from "../../../scripts/constants";

const BreadCrumbItem = [
  {
    label: "کارگزاری",
    href: "/brokerage",
  },
  {
    label: "نئوتریدر",
  },
];

const features = [
  {
    title: "همه ابزارهای مورد نیاز، در یک سامانه",
    icon: TickCircl,
  },
  {
    title: "سرعت در دسترسی، نه فقط در انجام معامله",
    icon: Clock,
  },
  {
    title: "سامانه‌ای در خدمت سبک معاملاتی شما",
    icon: ProfileTick,
  },
  {
    title: "طراحی مدرن، تجربه‌ای ساده‌تر",
    icon: Brush,
  },
  {
    title: "از مبتدی تا حرفه‌ای",
    icon: Profile2User,
  },
  {
    title: "سامانه تحت وب؛ همیشه در دسترس",
    icon: Global,
  },
];
---

<Layout title="نئو تریدر">
  <main>
    <SectionLayer1 desktopImage={HeroBg} mobileImage={HeroBgMobile}>
      <!-- right -->
      <div class="flex flex-1 items-center self-center pt-6 lg:pt-0" slot="right">
        <div class="flex flex-col items-center gap-8 lg:items-start">
          <h1 class="text-center text-display-small text-white lg:text-right">
            <span class="block">نئوتریدر؛</span>
            سامانه معاملات آنلاین کارگزاری نهایت‌نگر
          </h1>

          <div class="flex flex-col items-center gap-8 lg:items-start">
            <p class="text-center text-body-large text-body-large--font-weight leading-8 text-white lg:text-justify">
              نسل جدید معاملات آنلاین در بازار سرمایه
            </p>

            <div class="flex items-center gap-4">
              <a
                href={siteUrl(URLS.registerAddress)}
                target="_blank"
                rel="noopener noreferrer"
                class="neo-button neo-button-fill-primary neo-button-large"
              >
                افتتاح حساب
                <ArrowLeft aria-hidden="true" />
              </a>
              <a
                href={siteUrl(URLS.neoTraderAppAddress)}
                target="_blank"
                rel="noopener noreferrer"
                class="neo-button neo-button-large neo-button-outline-primary"
              >
                ورود به سامانه
                <ArrowLeft aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
      <!-- left -->
      <div class="flex-1" slot="left"></div>
    </SectionLayer1>

    <section class="mx-auto w-full max-w-lg px-3">
      <BreadCrumb items={BreadCrumbItem} />

      <div class="mb-10">
        <div class="my-9 flex flex-col-reverse items-center gap-6 lg:flex-row">
          <LineGradient />
          <div class="flex flex-col items-center lg:items-start">
            <span class="text-secondary">NeoTrader</span>
            <h1 class="text-display-small">سامانه نئوتریدر</h1>
          </div>
        </div>

        <div class="pr-6">
          <p class="text-body-large leading-[210%] whitespace-pre-line">
            NeoTrader نسل جدید سامانه معاملات آنلاین کارگزاری نهایت‌نگر است؛ سامانه‌ای که با هدف ایجاد تجربه‌ای بهتر از
            معاملات آنلاین، بر پایه فناوری‌های روز و نیازهای واقعی سرمایه‌گذاران توسعه یافته است.
          </p>

          <p class="text-body-large leading-[210%] whitespace-pre-line">
            در طراحی این سامانه، تلاش شده است تمام مراحل یک معامله، از بررسی وضعیت بازار و تحلیل نمادها تا ثبت سفارش،
            مدیریت پرتفوی و مشاهده گزارش‌های معاملاتی، در یک محیط یکپارچه و کاربرپسند انجام شود.
          </p>

          <p class="text-body-large leading-[210%] whitespace-pre-line">
            امکان انجام معاملات بورس اوراق بهادار، صندوق‌های سرمایه‌گذاری و اختیار معامله، در کنار ابزارهایی مانند
            دیده‌بان بازار، تحلیل تکنیکال، اسکرینر، نقشه بازار و اطلاعات جامع نمادها، مجموعه‌ای کامل از امکانات مورد
            نیاز برای معامله‌گران را در اختیار شما قرار می‌دهد.
          </p>
        </div>
      </div>

      <Banner>
        <h6 class="text-title-large leading-relaxed text-blue-800">
          <span class="block">NeoTrader تنها یک سامانه ثبت سفارش نیست؛</span>
          بلکه محیطی برای بررسی بازار، تحلیل فرصت‌های سرمایه‌گذاری و مدیریت دارایی‌ها است تا بتوانید با دیدی دقیق‌تر و اطلاعات
          کامل‌تر تصمیم‌گیری کنید.
        </h6>
      </Banner>

      <div class="features mb-9">
        <h4 class="py-9 text-heading-medium">چرا معامله‌گران NeoTrader را انتخاب می‌کنند؟</h4>
        <FeaturesGrid features={features} rowPattern={[3, 3]} />
      </div>
    </section>

    <!-- begin::Watchlist -->
    <SectionLayer1 desktopImage={WatchlistBg} mobileImage={WatchlistBgMobile}>
      <div class="order-1 flex flex-0 items-center lg:order-2 lg:flex-1" slot="left">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-display-small text-white">دیده‌بان بازار</h1>
              <h6 class="text-body-medium text-neutral-500">بازار را همان‌طور ببینید که برای شما اهمیت دارد</h6>
            </div>
          </div>

          <div class="flex flex-col items-center gap-4 lg:items-start lg:pr-6">
            <div>
              <p class="text-center text-body-large leading-[210%] text-white lg:text-justify">
                دیده‌بان بازار این امکان را فراهم می‌کند تا نمادهای موردنظر خود را در فهرست‌های اختصاصی دسته‌بندی کنید و
                تنها اطلاعاتی را مشاهده کنید که برای تصمیم‌گیری به آن‌ها نیاز دارید.
              </p>
              <p class="text-center text-body-large leading-[210%] text-white lg:text-justify">
                در کنار دیده‌بان‌های شخصی، مجموعه‌ای از دیده‌بان‌های سیستمی نیز در اختیار شما قرار گرفته است تا بتوانید
                گروه‌های مختلف بازار را بدون نیاز به ایجاد فهرست جدید دنبال کنید.
              </p>
            </div>

            <a class="neo-button neo-button-fill-primary neo-button-meduim" href={siteUrl("/brokerage/watchlist")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-0 items-center lg:flex-1" slot="right"></div>
    </SectionLayer1>
    <!-- end::Watchlist -->

    <!-- begin::Technical -->
    <SectionLayer1 desktopImage={TechnicalBg} mobileImage={TechnicalBgMobile}>
      <div class="flex flex-1 items-center" slot="left"></div>

      <div class="flex flex-1 items-center" slot="right">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-center text-display-small text-primary lg:text-right">
                تحلیل تکنیکال و نمودارهای پیشرفته
              </h1>
              <h6 class="text-body-medium text-secondary">
                قبل از معامله، نمودار را از زاویه‌ای که می‌خواهید بررسی کنید
              </h6>
            </div>
          </div>

          <div class="flex flex-col items-center gap-4 lg:items-start lg:pr-6">
            <div>
              <p class="text-center text-body-large leading-[210%] text-primary lg:text-justify">
                بررسی روند قیمت، یکی از مهم‌ترین مراحل تحلیل بازار است. <br />
                در ابزار تحلیل تکنیکال می‌توانید نمودار قیمت نمادها را در بازه‌های زمانی مختلف مشاهده کنید، از انواع تعدیل‌های
                قیمتی استفاده کنید و چند نمودار را به‌صورت هم‌زمان کنار یکدیگر قرار دهید. <br />
                ترکیب ابزارهای تحلیلی با اطلاعات کامل نماد، این امکان را فراهم می‌کند تا بدون خروج از سامانه، تحلیل دقیق‌تری
                از وضعیت بازار داشته باشید.
              </p>
            </div>

            <a class="neo-button neo-button-fill-primary neo-button-meduim" href={siteUrl("/brokerage/chart")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </SectionLayer1>
    <!-- end::Technical -->

    <!-- begin::Option -->
    <SectionLayer1 desktopImage={OptionBg} mobileImage={OptionBgMobile}>
      <div class="order-1 flex flex-0 items-center lg:order-2 lg:flex-1" slot="left">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-display-small text-white">معاملات اختیار معامله</h1>
              <span class="text-body-medium text-neutral-500">
                همه ابزارهای مورد نیاز معامله‌گران اختیار، در یک محیط واحد
              </span>
            </div>
          </div>

          <div class="flex flex-col items-center gap-4 pt-3 pb-3 lg:items-start lg:pr-6">
            <p class="text-center text-body-large leading-[210%] text-white lg:text-right">
              بازار اختیار معامله نیازمند بررسی هم‌زمان قراردادها، قیمت‌ها و استراتژی‌های مختلف است.
              <br />
              در این بخش می‌توانید زنجیره قراردادها را مشاهده کنید، اطلاعات هر قرارداد را بررسی کنید و استراتژی‌های معاملاتی
              موردنظر خود را تعریف و مدیریت کنید. <br />
              این امکانات به شما کمک می‌کند فرصت‌های بازار اختیار معامله را سریع‌تر شناسایی کرده و تصمیم‌های خود را با اطلاعات
              کامل‌تری اتخاذ کنید.
            </p>

            <a class="neo-button neo-button-fill-primary neo-button-meduim" href={siteUrl("/brokerage/option")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-0 items-center lg:flex-1" slot="right"></div>
    </SectionLayer1>
    <!-- end::Option -->

    <!-- begin::Instrument Info -->
    <SectionLayer1 classes="bg-white">
      <div class="order-2 flex flex-1 items-center justify-center" slot="left">
        <Image src={SymbolInfoObj} alt="اطلاعات نماد" class="h-auto max-h-100 w-auto" loading="lazy" />
      </div>

      <div class="order-1 flex flex-1 items-center" slot="right">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-center text-display-small text-primary lg:text-right">اطلاعات نماد</h1>
              <h6 class="text-body-medium text-neutral-800">هر آنچه برای بررسی یک نماد نیاز دارید</h6>
            </div>
          </div>

          <div class="flex flex-col items-center gap-4 lg:items-start lg:pr-6">
            <div>
              <p class="text-center text-body-large leading-[210%] text-primary lg:text-justify">
                برای تحلیل یک نماد، معمولاً لازم است اطلاعات مختلفی را از منابع متفاوت جمع‌آوری کنید.
                <br />
                در NeoTrader، اطلاعات لحظه‌ای بازار، سابقه معاملات، پیام‌های ناظر، معاملات حقوقی و سایر اطلاعات مورد نیاز
                در یک صفحه در اختیار شما قرار می‌گیرد تا بتوانید با سرعت بیشتری شرایط نماد را بررسی کنید.
              </p>
            </div>

            <a
              class="neo-button neo-button-fill-primary neo-button-meduim"
              href={siteUrl("/brokerage/instrument-detail")}
            >
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </SectionLayer1>
    <!-- end::Instrument Info -->

    <!-- begin::Screener -->
    <SectionLayer1 desktopImage={ScreenerBg} mobileImage={ScreenerBgMobile}>
      <div class="order-1 flex flex-0 items-center lg:order-2 lg:flex-1" slot="left">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-display-small text-white">اسکرینر (Screener)</h1>
              <span class="text-body-medium text-neutral-500">
                به‌جای جستجوی صدها نماد، اجازه دهید معیارهای شما جستجو کنند
              </span>
            </div>
          </div>

          <div class="flex flex-col items-center gap-4 pt-3 pb-3 lg:items-start lg:pr-6">
            <p class="text-center text-body-large leading-[210%] text-white lg:text-right">
              بررسی دستی تمام نمادهای بازار، زمان‌بر و دشوار است.
              <br />
              اسکرینر این امکان را فراهم می‌کند تا نمادها را بر اساس معیارهای دلخواه یا فیلترهای آماده بررسی کنید و تنها نمادهایی
              را مشاهده کنید که با استراتژی معاملاتی شما همخوانی دارند.
            </p>

            <a class="neo-button neo-button-fill-primary neo-button-meduim" href={siteUrl("/brokerage/screener")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-0 items-center lg:flex-1" slot="right"></div>
    </SectionLayer1>
    <!-- end::Screener -->

    <!-- begin::PortfolioManagment -->
    <SectionLayer1 classes="bg-white">
      <div class="order-2 flex flex-1 items-center justify-center" slot="left">
        <Image src={PortfolioObj} alt="مدیریت پورتفوی" class="h-auto max-h-125 w-auto" loading="lazy" />
      </div>

      <div class="order-1 flex flex-1 items-center" slot="right">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-center text-display-small text-primary lg:text-right">مدیریت پرتفوی</h1>
              <h6 class="text-body-medium text-neutral-800">بدانید سرمایه‌گذاری شما امروز چه وضعیتی دارد</h6>
            </div>
          </div>

          <div class="flex flex-col items-center gap-4 lg:items-start lg:pr-6">
            <div>
              <p class="text-center text-body-large leading-[210%] text-primary lg:text-justify">
                مدیریت پرتفوی تنها نمایش دارایی‌ها نیست؛ بلکه ابزاری برای ارزیابی عملکرد سرمایه‌گذاری است.
                <br />
                در این بخش می‌توانید ارزش روز دارایی‌ها، سود و زیان، عملکرد سرمایه‌گذاری در بازه‌های زمانی مختلف و اطلاعات
                مرتبط با مجامع را مشاهده کنید و تصویر دقیق‌تری از وضعیت سرمایه خود داشته باشید.
              </p>
            </div>

            <a class="neo-button neo-button-fill-primary neo-button-meduim" href={siteUrl("/brokerage/portfolio")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </SectionLayer1>
    <!-- end::PortfolioManagment -->

    <!-- begin::MarketMap -->
    <SectionLayer1 desktopImage={MarketMapBg} mobileImage={MarketMapBg}>
      <div class="flex flex-1 items-center justify-end" slot="left">
        <Image src={MarketMapObj} alt="نقشه بازار" class="h-auto w-full" loading="lazy" />
      </div>

      <div class="flex flex-1 items-center" slot="right">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-center text-display-small text-white lg:text-right">نقشه بازار</h1>
              <h6 class="text-body-medium text-neutral-500">وضعیت بازار را در یک نگاه ببینید</h6>
            </div>
          </div>

          <div class="flex flex-col items-center gap-4 lg:items-start lg:pr-6">
            <div>
              <p class="text-center text-body-large leading-[210%] text-white lg:text-justify">
                گاهی یک تصویر، اطلاعات بیشتری از چندین جدول در اختیار شما قرار می‌دهد.
                <br />
                نقشه بازار با نمایش گرافیکی وضعیت نمادها و گروه‌های مختلف، به شما کمک می‌کند روند کلی بازار، صنایع تأثیرگذار
                و جریان معاملات را سریع‌تر درک کنید.
              </p>
            </div>

            <a class="neo-button neo-button-fill-primary neo-button-meduim" href={siteUrl("/brokerage/market-map")}>
              مشاهده جزئیات
              <ArrowLeft aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </SectionLayer1>
    <!-- end::MarketMap -->
  </main>
</Layout>

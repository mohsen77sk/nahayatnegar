---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import { siteUrl } from "@utils/url";
import { URLS } from "../../../scripts/constants";

// Components
import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import BreadCrumb from "@components/bread-crumb.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import Banner from "@components/banner.astro";
import BannerCard from "@components/bannerCard.astro";
import Faq from "@components/faq.astro";
import TimeLine from "@components/time-line.astro";

// Icons & Assets
import Section1Img from "@assets/images/Brokerage/3-Credit/credit-hero.png";
import Section1ImgMob from "@assets/images/Brokerage/3-Credit/credit-hero-mob.png";
import SectionBanner1Img from "@assets/images/Brokerage/3-Credit/Mockups/web.png";
import SectionBanner1ImgMob from "@assets/images/Brokerage/3-Credit/Mockups/mob.png";
import SectionBanner2Img from "@assets/images/Brokerage/3-Credit/credit-banner.png";
import SectionBanner2ImgMob from "@assets/images/Brokerage/3-Credit/credit-banner-mob.png";

import Candle from "@assets/icons/iconsax/outline/candle.svg";
import Flash from "@assets/icons/iconsax/outline/flash.svg";
import Chart from "@assets/icons/iconsax/outline/chart-2.svg";
import Tick from "@assets/icons/iconsax/outline/tick-square.svg";
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import RefreshSquare from "@assets/icons/iconsax/outline/refresh-square.svg";
import WalletAdd from "@assets/icons/iconsax/outline/wallet-add.svg";
import TickCircle from "@assets/icons/iconsax/outline/tick-circle.svg";

const BreadCrumbItem = [
  {
    label: "کارگزاری",
    href: "/brokerage",
  },
  {
    label: "اعتبار معاملاتی",
  },
];

const features = [
  {
    title: "اعتباری که با معاملات خودتان ساخته می‌شود",
    icon: Candle,
    description:
      "اعتبار شما بر اساس میزان فعالیت و گردش معاملاتتان افزایش می‌یابد؛ هرچه بیشتر معامله کنید، اعتبار بیشتری خواهید داشت.",
  },
  {
    title: "دریافت اعتبار، هر زمان که به آن نیاز دارید",
    icon: Flash,
    description: "اعتبار خود را هر زمان که نیاز داشته باشید، بدون طی مجدد مراحل اداری دریافت و استفاده کنید.",
  },
  {
    title: "قدرت خرید بیشتر برای استفاده از فرصت‌های بازار",
    icon: Chart,
    description: "با افزایش قدرت خرید، فرصت‌های سرمایه‌گذاری را به‌موقع از دست ندهید و با انعطاف بیشتری معامله کنید.",
  },
  {
    title: "استفاده آسان، بدون درخواست‌های مکرر",
    icon: Tick,
    description: "بدون ثبت درخواست یا تکمیل فرم‌های تکراری، هر زمان به اعتبار نیاز داشتید از آن استفاده کنید.",
  },
];

const faqs = [
  {
    title: "چه کسانی می‌توانند اعتبار دریافت کنند؟",
    description: "تمام مشتریان کارگزاری که شرایط اعتباری و ضوابط تعیین‌شده را احراز کنند.",
  },
  {
    title: "مبلغ اعتبار چگونه تعیین می‌شود؟",
    description: "بر اساس گردش معاملات ، ارزش روز دارایی‌ها، رتبه اعتباری و سایر معیارهای اعتبارسنجی.",
  },
  {
    title: "آیا اعتبار نیاز به تسویه دارد؟",
    description: "بله. اعتبار در پایان دوره تعیین‌شده باید مطابق شرایط قرارداد تسویه شود.",
  },
  {
    title: "آیا امکان تمدید اعتبار وجود دارد؟",
    description: "بله. در صورت احراز شرایط و مطابق ضوابط کارگزاری، اعتبار برای دوره بعد تمدید می‌شود.",
  },
  {
    title: "در صورت کاهش ارزش دارایی چه اتفاقی می‌افتد؟",
    description: "سقف اعتباری که مشتری می تواند بگیرد به تناسب کاهش خواهد یافت.",
  },
  {
    title: "آیا برای دریافت اعتبار مراجعه حضوری لازم است؟",
    description: "خیر تمام فرآیند ارزیابی و تعیین اعتبار به صورت غیرحضوری و خودکار انجام می شود.",
  },
];

const timeline = {
  title: "اعتبار شما در چهار گام ایجاد می‌شود:",
  steps: [
    {
      title: "معامله می‌کنید",
      description: "گردش معاملات شما به‌صورت روزانه ثبت و بررسی می‌شود.",
      icon: Candle,
    },
    {
      title: "گردش معاملات شما ارزیابی می‌شود",
      description: "سامانه اعتباری، گردش معاملات دوماهه و سایر معیارهای اعتبارسنجی را محاسبه می‌کند.",
      icon: RefreshSquare,
    },
    {
      title: " اعتبار شما ایجاد می‌شود",
      description: "بر اساس نتیجه اعتبارسنجی، سهمیه اعتبار قابل دریافت شما تعیین می‌شود.",
      icon: WalletAdd,
    },
    {
      title: "هر زمان نیاز داشته باشید، از اعتبار استفاده می‌کنید",
      description:
        "اعتبار تخصیص‌یافته در چارچوب ضوابط از طریق سامانه در اختیار شما قرار می‌گیرد تا قدرت خرید بیشتری داشته باشید.",
      icon: TickCircle,
    },
  ],
};
---

<Layout title="اعتبار معاملاتی">
  <main>
    <!-- Hero Section -->

    <SectionLayer2 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <span class="text-display-small text-white">اعتبار هوشمند نهایت‌نگر</span>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          قدرت خرید خود را افزایش دهید و فرصت‌های بازار را از دست ندهید.
        </p>
        <div class="flex gap-4">
          <a class="neo-button neo-button-fill-primary neo-button-large" href={siteUrl(URLS.registerAddress)}>
            افتتاح حساب
            <ArrowLeft aria-hidden="true" />
          </a>
          <button
            class="neo-button neo-button-outline-primary neo-button-large"
            type="button"
            data-consultation-modal-trigger
          >
            دریافت مشاوره
            <ArrowLeft aria-hidden="true" />
          </button>
        </div>
      </div>
    </SectionLayer2>

    <!-- Content Section -->

    <section class="mx-auto mb-15 flex max-w-200 flex-col gap-6 p-4">
      <BreadCrumb items={BreadCrumbItem} />
      <div>
        <h2 class="text-heading-medium leading-10">اعتبار معاملاتی نهایت‌نگر</h2>
        <div class="text-body-medium leading-7 text-secondary">اعتباری که با معاملات خودتان ساخته می‌شود.</div>
      </div>

      <p class="text-body-large leading-8">
        اعتبار معاملاتی، مبلغی است که کارگزاری بر اساس گردش معاملات و میزان دارایی شما در اختیارتان قرار می‌دهد تا قدرت
        خرید بیشتری در معاملات داشته باشید.
        <br /> هرچه گردش معاملات و میزان دارایی شما بیشتر باشد، اعتبار قابل دریافت شما نیز افزایش می‌یابد؛ به بیان دیگر، اعتبار
        شما با معاملات خودتان ساخته می‌شود.
      </p>

      <Image src={SectionBanner1ImgMob} alt="" class="h-auto w-full" loading="lazy" />

      <div class="features mb-5">
        <h2 class="pb-5 text-heading-medium leading-10">ویژگی‌های متمایز اعتبار نهایت‌نگر</h2>
        <FeaturesGrid features={features} rowPattern={[2, 2]} />
      </div>
      <div>
        <h2 class="text-heading-medium leading-10">اعتبار معاملاتی شما چگونه ایجاد می‌شود؟</h2>
        <p class="text-body-large leading-8">
          اعتبار شما به واسطه معاملات خودتان ایجاد می‌شود. سامانه اعتباری نهایت‌نگر، بر مبنای رویه اعتباری کارگزاری،
          به‌صورت روزانه گردش معاملات شما را در بازه دوماهه منتهی به هر روز بررسی کرده و آن را به گردش مبنای اعتبار
          تبدیل می‌کند. سپس با در نظر گرفتن گردش مورد انتظار و سایر معیارهای اعتبارسنجی، میزان اعتبار قابل دریافت شما
          محاسبه و در اختیارتان قرار می‌گیرد. به همین دلیل، اعتبار شما به‌صورت پویا و متناسب با فعالیت معاملاتی‌تان شکل
          می‌گیرد.
        </p>
      </div>
      <TimeLine title={timeline.title} steps={timeline.steps} />

      <Banner>
        <h6 class="text-center text-title-large leading-relaxed text-blue-800">گردش معاملات شما، اعتبار شماست.</h6>
      </Banner>

      <Image src={SectionBanner1Img} alt="" class="h-auto w-full" loading="lazy" />
      <p class="text-body-large leading-8">
        اعتبار تخصیص‌یافته برای یک دوره یک‌ماهه در اختیار شما قرار می‌گیرد. در پایان سررسید، س امانه به‌صورت خودکار
        شرایط اعتباری شما را مجدداً ارزیابی می‌کند و در صورت تحقق گردش مورد انتظار و حفظ شرایط لازم، اعتبار شما برای
        دوره بعد تمدید خواهد شد.
      </p>
      <div>
        <h2 class="text-heading-medium leading-10">اعتبار اولیه برای مشتریان جدید</h2>
        <p class="text-body-large leading-8">
          گر به‌تازگی به کارگزاری نهایت‌نگر پیوسته‌اید و هنوز فرصت ایجاد سابقه معاملاتی نداشته‌اید، اعتبار اولیه شما بر
          مبنای خالص ارزش روز دارایی‌ها و مطابق ضوابط کارگزاری تعیین می‌شود.
          <br /> کافی است دارایی خود را به کارگزاری نهایت‌نگر منتقل کنید تا اعتبار بدو ورود به شما اختصاص یابد. با استفاده
          از این اعتبار، می‌توانید از همان ابتدای فعالیت، قدرت خرید خود را افزایش داده و معاملاتتان را با ظرفیت بیشتری آغاز
          کنید.
        </p>
      </div>
      <Faq faqs={faqs} />

      <!-- Footer CTA -->
      <BannerCard desktopImage={SectionBanner2Img} mobileImage={SectionBanner2ImgMob}>
        <div class="flex flex-col gap-4 text-white lg:w-1/2">
          <h1 class="text-heading-medium leading-10">اعتبار معاملاتی</h1>
          <p class="text-body-large leading-8">
            اگر مایل به استفاده از اعتبار هستید کافی است فعالیت معاملاتی خود را در کارگزاری شروع کنید .
          </p>
        </div>
        <button
          type="button"
          class="neo-button neo-button-fill-primary neo-button-large min-w-25 lg:w-40"
          data-consultation-modal-trigger
        >
          درخواست مشاوره
          <ArrowLeft aria-hidden="true" />
        </button>
      </BannerCard>
    </section>
  </main>
</Layout>

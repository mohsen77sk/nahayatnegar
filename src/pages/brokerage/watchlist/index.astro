---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import { siteUrl } from "@utils/url";

// Layout & Custom Components
import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import Banner from "@components/banner.astro";
import TimeLine from "@components/time-line.astro";
import Faq from "@components/faq.astro";
import FeatureCard from "@components/FeatureCard.astro";

// Icons
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import Link from "@assets/icons/iconsax/outline/link.svg";
import LampCharge from "@assets/icons/iconsax/outline/lamp-charge.svg";
import RulerPen from "@assets/icons/iconsax/outline/ruler-pen.svg";
import SecurityTime from "@assets/icons/iconsax/outline/security-time.svg";
import Layer from "@assets/icons/iconsax/outline/layer.svg";
import Search from "@assets/icons/iconsax/outline/search-normal.svg";
import Computing from "@assets/icons/iconsax/outline/computing.svg";
import Eye from "@assets/icons/iconsax/outline/eye.svg";

// Images
import Section2Img from "@assets/images/Brokerage/1-Neo Trader/Watchlist/watchlist-hero.png";
import Section2ImgMob from "@assets/images/Brokerage/1-Neo Trader/Watchlist/watchlist-hero-mob.png";
import SectionBanner1Img from "@assets/images/Brokerage/1-Neo Trader/Watchlist/Mockups/laptop.png";
import SectionBanner2Img from "@assets/images/Brokerage/1-Neo Trader/Watchlist/Mockups/imac.png";
import Section3BannerImg from "@assets/images/Brokerage/1-Neo Trader/Watchlist/Banner.png";
import Section3BannerImgMob from "@assets/images/Brokerage/1-Neo Trader/Watchlist/Banner-mob.png";
import BreadCrumb from "@components/bread-crumb.astro";

const breadCrumbItems = [
  {
    label: "کارگزاری",
    href: "/brokerage",
  },
  { label: "نئوتریدر", href: "/brokerage/neo-trader" },
  { label: "دیده‌بان" },
];

const features = [
  {
    title: "دیده‌بان شخصی",
    description: `<p class="leading-7">می‌توانید بدون محدودیت، دیده‌بان‌های شخصی ایجاد کنید و در هرکدام نمادهای موردنظر خود را اضافه یا حذف کنید.</p>
    <p class="leading-7">به این ترتیب می‌توانید برای هر نوع بررسی، فهرست جداگانه‌ای داشته باشید.</p>`,
    icon: Link,
    gridClass: "lg:col-start-1  lg:row-start-1",
  },
  {
    title: "دیده‌بان‌های سیستمی",
    description:
      "برای اینکه لازم نباشد همه فهرست‌ها را از ابتدا ایجاد کنید، دیده‌بان‌های سیستمی برای دسته‌بندی‌های مختلف بازار در اختیار شما قرار گرفته‌اند. برای هر صنعت، دیده‌بان اختصاصی وجود دارد، نمادهای قابل معامله در TAL دیده‌بان مربوط به خود دارند، همچنین انواع صندوق‌ها نیز در دسته‌بندی‌های مستقل مانند صندوق‌های طلا و اهرمی و... قرار گرفته‌اند.",
    icon: LampCharge,
    gridClass: "lg:col-start-2 lg:col-span-2 lg:row-start-1",
  },
  {
    title: "اطلاعات مورد نیاز در یک نگاه",
    description: `<p class="leading-7">در دیده‌بان می‌توانید اطلاعات مختلفی از نمادها را در کنار یکدیگر مشاهده کنید و ستون‌های موردنظر خود را برای نمایش انتخاب کنید.
</p>
    <ul class="list-native-circle leading-7">
    <li>حجم معاملات</li>
    <li>قیمت تابلو و قیمت پایانی</li>
    <li>حجم و قیمت عرضه و تقاضا</li>
    <li>اسپرد</li>
    <li>	قیمت سربه‌سر</li>
    <li>بازده</li>
    <li>موجودی</li>
    <li>	ارزش ریالی</li>
    <li>صنعت</li>
    <li>NAV صندوق‌ها</li>
    <li>خالص ارز دارایی صندوق‌ها</li>
    <li>حباب صندوق‌ها</li>
    </ul>
    <p class="leading-7">همچنین می‌توانید اندازه ستون‌ها را متناسب با فضای موردنظر خود تنظیم کنید.</p>`,
    icon: RulerPen,
    gridClass: "lg:col-start-1 lg:row-start-2 lg:row-span-2 lg:col-span-2",
  },
  {
    title: "به‌روزرسانی لحظه‌ای",
    description:
      "اطلاعات دیده‌بان به‌صورت لحظه‌ای به‌روزرسانی می‌شود و تغییرات قیمت، حجم و سایر اطلاعات قابل مشاهده در سریع‌ترین زمان ممکن بروز می‌شوند.",
    icon: SecurityTime,
    gridClass: "lg:col-start-3 lg:row-start-2",
  },
  {
    title: "اشتراک گذاری دیده‌بان",
    description:
      "در صورت نیاز می‌توانید از اطلاعات موجود در دیده‌بان خروجی Excel دریافت کنید و داده‌ها را برای بررسی یا استفاده‌های دیگر در اختیار داشته باشید.",
    icon: Layer,
    gridClass: "lg:col-start-3 lg:row-start-3",
  },
];

const timeline = {
  title: "نحوه استفاده و کاربرد",
  description:
    "دیده‌بان شخصی را ایجاد کنید و نمادهای موردنظر خود را به آن اضافه کنید. سپس اطلاعات بازار را به‌صورت لحظه‌ای دنبال کنید و در صورت نیاز، با انتخاب هر نماد وارد صفحه اطلاعات آن شوید.",
  steps: [
    {
      title: "پایش نمادهای موردنظر",
      description: "نمادهایی را که بیشتر دنبال می‌کنید در یک فهرست قرار دهید.",
      icon: Search,
    },
    {
      title: "بررسی یک صنعت یا گروه خاص",
      description: "از دیده‌بان‌های سیستمی برای مشاهده نمادهای یک صنعت یا گروه‌های مختلف صندوق‌ها استفاده کنید.",
      icon: Computing,
    },
    {
      title: "مشاهده گرافیکی نمادها",
      description: "دیده‌بان خود را در نقشه بازار مشاهده کنید و وضعیت نمادها را به شکل گرافیکی بررسی کنید.",
      icon: Eye,
    },
  ],
};

const faqs = [
  {
    title: "آیا می‌توانم یک نماد را در چند دیده‌بان مختلف قرار دهم؟",
    description:
      "بله. می‌توانید یک نماد را در چند دیده‌بان شخصی قرار دهید و برای هر یک از فهرست‌های موردنظر خود، ترکیب متفاوتی از نمادها داشته باشید.",
  },
  {
    title: "آیا دیده‌بان شخصی فقط برای سهام قابل استفاده است؟",
    description:
      "خیر. در دیده‌بان شخصی می‌توانید انواع نمادهای قابل معامله (صندوق سرمایه گذاری، قراردادهای اختیار معامله) را متناسب با نیاز خود اضافه کنید.",
  },
  {
    title: "آیا امکان مرتب‌سازی نمادها در دیده‌بان وجود دارد؟",
    description:
      "بله. می‌توانید اطلاعات نمایش‌داده‌شده را بر اساس ستون‌های موجود مرتب کنید تا بررسی نمادها برایتان ساده‌تر شود.",
  },
  {
    title: "آیا می‌توانم وضعیت باز یا بسته بودن نمادها را در دیده‌بان مشخص کنم؟",
    description: "بله. امکان فیلتر کردن نمادها بر اساس باز یا بسته بودن آن‌ها وجود دارد.",
  },
];
---

<Layout title="دیده‌بان">
  <main>
    <SectionLayer2 desktopImage={Section2Img} mobileImage={Section2ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <span class="text-center text-display-small text-white lg:text-start">دیده‌بان بازار </span>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          دیده‌بان بازار به شما امکان می‌دهد نمادهای موردنظر خود را در فهرست‌های شخصی یا دسته‌بندی‌های آماده قرار دهید و
          اطلاعات آن‌ها را به‌صورت لحظه‌ای دنبال کنید.
        </p>
        <div class="flex gap-4">
          <a href={siteUrl("/brokerage/neo-trader")} class="neo-button neo-button-fill-primary neo-button-large">
            ورود به نئوتریدر <ArrowLeft aria-hidden="true" />
          </a>
        </div>
      </div>
    </SectionLayer2>

    <!-- Content Section -->

    <section class="mx-auto flex max-w-200 flex-col gap-6 p-4">
      <BreadCrumb items={breadCrumbItems} />
      <div>
        <h2 class="text-heading-medium leading-10">دیده‌بان بازار چیست؟</h2>

        <p class="text-body-large leading-8">
          دیده‌بان بازار ابزاری برای پایش هم‌زمان نمادهای موردنظر شماست. به‌جای جست‌وجوی جداگانه نمادها، می‌توانید آن‌ها
          را در فهرست‌های دلخواه خود قرار دهید و اطلاعات مهم بازار را در یک محیط یکپارچه مشاهده کنید.
        </p>
        <p class="text-body-large leading-8">
          دیده‌بان برای کاربرانی طراحی شده است که می‌خواهند تغییرات نمادهای مورد توجه خود را سریع‌تر دنبال کنند؛ چه چند
          نماد مشخص را زیر نظر داشته باشند و چه بخواهند یک صنعت یا گروهی از صندوق‌ها را پایش کنند.
        </p>
      </div>

      <Image src={SectionBanner1Img} alt="" class="h-auto w-full" loading="lazy" />

      <!-- Features Section -->
      <section class="features mb-5">
        <h2 class="pb-5 text-heading-medium leading-10">ویژگی‌های اصلی</h2>
        <div class="max-w-7xl mx-auto flex flex-col gap-2">
          <div class="flex flex-col gap-2 lg:grid lg:grid-cols-[1fr_0.45fr_1.1fr] lg:grid-rows-[auto_auto_auto_auto]">
            {
              features.map((feature) => (
                <div class={`flex w-full ${feature.gridClass}`} dir="rtl">
                  <FeatureCard title={feature.title} description={feature.description} icon={feature.icon} />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Benefits Section -->

      <article class="flex flex-col gap-3">
        <h2 class="text-heading-medium leading-10">مزیت برای معامله‌گر</h2>
        <p class="text-body-medium leading-7 text-secondary">اطلاعات موردنظر، بدون جست‌وجوی مداوم.</p>

        <p class="text-body-medium leading-7 text-secondary">
          وقتی چندین نماد را دنبال می‌کنید، جابه‌جایی میان صفحات مختلف برای بررسی آن‌ها می‌تواند زمان‌بر باشد.
        </p>
        <p class="text-body-medium leading-7 text-secondary">
          دیده‌بان، نمادهای موردنظر شما و اطلاعات مهم آن‌ها را در یک محیط جمع می‌کند تا بتوانید تغییرات بازار را سریع‌تر
          دنبال کنید و در صورت نیاز، مستقیماً به اطلاعات هر نماد دسترسی داشته باشید.
        </p>
        <p class="text-body-medium leading-7 text-secondary">
          در کنار دیده‌بان‌های شخصی، فهرست‌های سیستمی نیز کمک می‌کنند بدون ایجاد و مدیریت دستی فهرست‌ها، گروه‌های مختلف
          بازار را دنبال کنید.
        </p>
      </article>

      <Banner>
        <h6 class="text-center text-title-large leading-relaxed text-blue-800">
          بازار را همانطور ببینید که برای شما اهمیت دارد
        </h6>
      </Banner>

      <TimeLine steps={timeline.steps} description={timeline.description} title={timeline.title} />
      <Image src={SectionBanner2Img} alt="" class="h-auto w-full" loading="lazy" />

      <Faq faqs={faqs} />

      <!-- Footer CTA -->
      <div
        class="flex h-72 flex-col justify-between gap-8 rounded-xl bg-fg-primary bg-(image:--bg-mobile) bg-cover bg-center p-6 lg:bg-(image:--bg-desktop)"
        style={`--bg-mobile: url('${Section3BannerImgMob.src}'); --bg-desktop: url('${Section3BannerImg.src}');`}
      >
        <div class="flex flex-col gap-2 text-white lg:w-94">
          <h1 class="text-heading-medium leading-10">بازار را ساده‌تر دنبال کنید</h1>
          <p class="text-body-large leading-8">
            نمادهای موردنظر خود را در دیده‌بان قرار دهید و اطلاعات بازار را در یک محیط یکپارچه و لحظه‌ای دنبال کنید.
          </p>
        </div>
        <a
          href={siteUrl("/brokerage/neo-trader")}
          class="neo-button neo-button-fill-primary neo-button-large min-w-25 w-40"
        >
          ورود به نئوتریدر
          <ArrowLeft aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>
</Layout>

---
import { siteUrl } from "@utils/url";
import Layout from "@layouts/Layout.astro";
import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import BreadCrumb from "@components/bread-crumb.astro";
import { Image } from "astro:assets";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import Banner from "@components/banner.astro";
import TimeLine from "@components/time-line.astro";
import BannerCard from "@components/bannerCard.astro";
import Faq from "@components/faq.astro";

import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import Section1Img from "@assets/images/Brokerage/4-Nahaban/nahaban-hero.png";
import Section1ImgMob from "@assets/images/Brokerage/4-Nahaban/nahaban-hero-mob.png";
import MockupImageMob from "@assets/images/Brokerage/4-Nahaban/Mockups/mob.png";
import MockupImageWeb from "@assets/images/Brokerage/4-Nahaban/Mockups/web.png";
import BannerWeb from "@assets/images/Brokerage/4-Nahaban/Banner.png";
import BannerMob from "@assets/images/Brokerage/4-Nahaban/Banner-mob.png";

import Clock from "@assets/icons/iconsax/outline/clock.svg";
import Candle from "@assets/icons/iconsax/outline/candle.svg";
import DiscountCircle from "@assets/icons/iconsax/outline/discount-circle.svg";
import Wallet3 from "@assets/icons/iconsax/outline/wallet-3.svg";
import Verify from "@assets/icons/iconsax/outline/verify.svg";
import TickCircl from "@assets/icons/iconsax/outline/tick-circle.svg";
import Timer from "@assets/icons/iconsax/outline/timer.svg";
import Moneys from "@assets/icons/iconsax/outline/moneys.svg";

const BreadCrumbItem = [
  {
    label: "کارگزاری",
    href: "/brokerage",
  },
  {
    label: "نهابان",
  },
];

const features = [
  {
    title: "سرمایه همیشه آماده معامله",
    description: "وجوه در حساب معاملاتی می‌ماند و هر لحظه برای معامله یا برداشت در دسترس است.",
    icon: Candle,
  },
  {
    title: "سود از همان روز نخست",
    description: "سود به‌صورت روزانه محاسبه و در حساب اختصاصی شما ثبت می‌شود.",
    icon: Clock,
  },
  {
    title: "انتقال خودکار سود هنگام استفاده",
    description: "با برداشت وجه یا خرید اوراق، سود متناظر به حساب معاملاتی شما منتقل می‌شود.",
    icon: DiscountCircle,
  },
  {
    title: "سود روزشمار برای موجودی نقد",
    description: "موجودی نقد حساب معاملاتی شما تا زمان استفاده، مشمول سود روزشمار است.",
    icon: Wallet3,
  },
  {
    title: "سود روزشمار برای وجه تضمین اختیار",
    description: "بازده مؤثر سرمایه‌گذاری شما در معاملات اختیار حفظ می‌شود.",
    icon: Verify,
  },
];

const timeline = {
  title: "نهابان در سه گام",
  steps: [
    {
      title: "ورود وجوه به طرح نهابان",
      description:
        "درصورت ماندن وجوه نزد کارگزاری، موجودی نقد حساب یا وجه تضمین معاملات اختیار شما وارد طرح نهابان می‌شود.",
      icon: TickCircl,
    },
    {
      title: "محاسبه و ثبت سود روزشمار",
      description: "سامانه نهابان، سود روزشمار را روزانه محاسبه و در حساب اختصاصی شما ثبت می‌کند.",
      icon: Timer,
    },
    {
      title: "انتقال سود به هنگام استفاده از وجوه",
      description: "با برداشت وجه یا خرید اوراق بهادار، سود روزشمار متناظر به حساب معاملاتی شما منتقل می‌شود.",
      icon: Moneys,
    },
  ],
};

const faqs = [
  {
    title: "آیا سود هر روز پرداخت می‌شود؟",
    description:
      "خیر. سود به‌صورت روزانه محاسبه و در حساب نهابان نگهداری می‌شود و هنگام خروج تمام یا بخشی از وجوه از طرح، سود متناظر آن به حساب معاملاتی شما منتقل می‌شود.",
  },
  {
    title: "آیا سود نهابان قابل برداشت است؟",
    description: "بله. با خروج تمام یا بخشی از وجوه از طرح، سود روزشمار متناظر نیز به حساب معاملاتی شما منتقل می‌شود.",
  },
  {
    title: "آیا در مدت استفاده از نهابان، سرمایه من برای معامله در دسترس است؟",
    description:
      "بله. وجوه شما در حساب معاملاتی باقی می‌ماند و هر زمان که بخواهید می‌توانید از آن برای انجام معاملات یا برداشت وجه استفاده کنید.",
  },
];
---

<Layout title="Nahaban">
  <main>
    <SectionLayer2 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <h1 class="text-display-small text-white">نهابان ؛ فراتر از یک بانک</h1>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          با نهابان ، سرمایه شما تا رسیدن فرصت بعدی خرید، بیکار نمی‌ماند و می‌تواند برایتان بازده روزشمار ایجاد کند.
        </p>
        <div class="flex flex-col gap-4 lg:flex-row">
          <a class="neo-button neo-button-fill-primary neo-button-large" href={siteUrl("/")}>
            افتتاح حساب
            <ArrowLeft aria-hidden="true" />
          </a>
          <button
            class="neo-button neo-button-outline-primary neo-button-large"
            type="button"
            data-consultation-modal-trigger
          >
            درخواست مشاوره
            <ArrowLeft aria-hidden="true" />
          </button>
        </div>
      </div>
    </SectionLayer2>

    <section class="mx-auto mb-15 flex max-w-200 flex-col gap-6 p-4">
      <BreadCrumb items={BreadCrumbItem} />

      <div>
        <h2 class="text-heading-medium leading-10">نهابان</h2>
        <div class="text-body-medium leading-7 text-secondary">
          سود روزشمار برای موجودی نقد و وجه تضمین معاملات اختیار
        </div>
      </div>

      <p class="text-body-large leading-8">
        نهابان سرویسی است که روی موجودی نقد حساب معاملاتی و همچنین وجه تضمین معاملات اختیار، سود روزشمار محاسبه و پرداخت
        می‌کند. سود محاسبه‌شده به‌صورت روزانه در حساب اختصاصی نهابان شما ثبت و تجمیع می‌شود و هر زمان تمام یا بخشی از
        موجودی خود را از طرح خارج کنید، سود متناظر آن نیز به حساب معاملاتی شما منتقل می شود .
      </p>

      <Image src={MockupImageMob} alt="صندوق ناب" class="h-auto w-full" loading="lazy" />

      <div class="features mb-5">
        <h2 class="pb-5 text-heading-medium leading-10">ویژگی‌های متمایز نهابان</h2>
        <FeaturesGrid features={features} rowPattern={[2, 3]} />
      </div>

      <h2 class="text-heading-medium leading-10">نهابان چگونه کار می‌کند؟</h2>

      <p class="text-body-large leading-8">
        اگر در حساب معاملاتی خود موجودی نقد داشته باشید یا برای معاملات اختیار، وجه تضمین نزد کارگزاری نگهداری کنید،
        نهابان مطابق شرایط طرح، سود روزشمار این مبالغ را به‌صورت روزانه محاسبه و در حساب اختصاصی نهابان شما ثبت می‌کند.<br
        />
        این سود تا زمانی که وجوه در طرح باقی بمانند، به‌صورت روزانه افزایش می‌یابد. هر زمان که تمام یا بخشی از این وجوه را
        برای خرید اوراق بهادار مصرف کنید یا از حساب معاملاتی خود برداشت نمایید، سود روزشمار محاسبه‌شده متناظر با مبلغ خارج‌شده
        نیز به حساب معاملاتی شما منتقل می‌شود.
      </p>

      <Banner>
        <h6 class="text-right text-title-large leading-relaxed text-blue-800 lg:text-center">
          حتی زمانی که معامله‌ای انجام نمی‌دهید، سرمایه شما می‌تواند برایتان بازده ایجاد کند.
        </h6>
      </Banner>

      <TimeLine title={timeline.title} steps={timeline.steps} />

      <Image src={MockupImageWeb} alt="" class="h-auto w-full" loading="lazy" />

      <Faq faqs={faqs} />

      <BannerCard desktopImage={BannerWeb} mobileImage={BannerMob} classes={"lg:h-72"}>
        <div class="flex max-w-94 flex-col gap-4 text-white lg:w-1/2">
          <h1 class="text-heading-medium leading-10">طرح نهابان</h1>
          <p class="text-body-meduim leading-8 text-neutral-500">
            سرمایه خود را در نهابان قرار دهید تا موجودی نقد حساب و وجه تضمین معاملات اختیار شما، مشمول سود روزشمار شوند
            و تا زمان رسیدن فرصت بعدی بازار، برایتان بازده ایجاد کنند.
          </p>
        </div>
        <button
          type="button"
          class="neo-button neo-button-fill-primary neo-button-large min-w-25 lg:w-40"
          data-consultation-modal-trigger
        >
          درخواست مشاوره
          <ArrowLeft aria-hidden="true" />
        </button>
      </BannerCard>
    </section>
  </main>
</Layout>

---
import { siteUrl } from "@utils/url";
import Layout from "@layouts/Layout.astro";
import SectionLayer1 from "@components/@layout/section-layer-1.astro";
import LineGradient from "@components/line-gradient.astro";

import Section1Img from "@assets/images/Nahayatnegar/Contact Us/contact-us-hero.png";
import Section1ImgMob from "@assets/images/Nahayatnegar/Contact Us/contact-us-hero-mob.png";
import IconInstagram from "@assets/icons/iconsax/outline/instagram.svg";
import IconWhatsapp from "@assets/icons/iconsax/outline/whatsapp.svg";
import IconLocation from "@assets/icons/iconsax/bulk/location.svg";
import IconCall from "@assets/icons/iconsax/bulk/call.svg";
import IconSMS from "@assets/icons/iconsax/bulk/sms.svg";
---

<Layout title="تماس با ما">
  <main>
    <SectionLayer1 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <!-- right -->
      <div class="flex flex-1 items-center self-center" slot="right">
        <div class="flex flex-col items-center gap-8 lg:items-start">
          <span class="text-display-small text-white">تماس با ما</span>
          <h1 class="text-center text-body-large text-white">راه‌های ارتباطی با کارگزاری نهایت‌نگر</h1>
        </div>
      </div>
      <!-- left -->
      <div class="flex-1" slot="left"></div>
    </SectionLayer1>

    <section class="flex bg-white px-4 py-8 lg:py-16">
      <div class="relative mx-auto flex w-full max-w-lg flex-col gap-4 lg:flex-row">
        <div class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col-reverse items-center gap-6 lg:flex-row">
            <LineGradient />
            <div class="flex flex-col items-center lg:items-start">
              <span class="text-secondary">تماس با ما</span>
              <h1 class="text-center text-display-small">ما اینجا هستیم تا به شما کمک کنیم</h1>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="text-center text-title-large lg:text-start">دفتر مرکزی</h3>
            <div class="flex items-center gap-4 p-2">
              <IconLocation />
              <span>تهران، خیابان ملاصدرا، شیخ بهایی جنوبی، پلاک ۳۱</span>
            </div>
            <div class="flex items-center gap-4 p-2">
              <IconCall />
              <a class="ltr" href="tel:02184450"> ۰۲۱ ۸۴۴۵۰ </a>
            </div>
            <div class="flex items-center gap-4 p-2">
              <IconSMS />
              <a href="mailto:Info@nahayatnegar.com">Info@nahayatnegar.com</a>
            </div>
          </div>

          <div class="flex justify-center gap-2 lg:justify-start">
            <a class="neo-button neo-icon-button neo-button-neutral" href="/" aria-label="واتساپ">
              <IconWhatsapp aria-hidden="true" />
            </a>
            <a class="neo-button neo-icon-button neo-button-neutral" href="/" aria-label="اینستاگرام">
              <IconInstagram aria-hidden="true" />
            </a>
          </div>

          <div class="flex justify-center gap-2 lg:justify-start">
            <a class="neo-button neo-button-primary" href={siteUrl("/branches")}> آدرس و تلفن شعب </a>
          </div>
        </div>

        <form class="flex flex-1 flex-col gap-4 rounded-3xl bg-fg-secondary p-8">
          <div class="flex flex-col gap-3">
            <span class="text-title-large">نام و نام‌خانوادگی</span>
            <input class="neo-input-large" type="text" name="name" placeholder="به فارسی" />
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-title-large">ایمیل</span>
            <input class="neo-input-large" type="text" name="email" placeholder="email@gmail.com" />
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-title-large">پیام شما</span>
            <textarea class="neo-input-large" name="message" placeholder="پیام خود را بنویسید."></textarea>
          </div>

          <button type="submit" class="neo-button neo-button-fill-primary neo-button-large"> ارسال </button>
        </form>
      </div>
    </section>

    <section class="flex bg-white px-4 py-8 lg:py-16">
      <div class="relative mx-auto h-80 w-full max-w-lg rounded-3xl border bg-secondary"></div>
    </section>
  </main>
</Layout>

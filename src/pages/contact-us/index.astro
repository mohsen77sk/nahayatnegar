---
import Layout from "@layouts/Layout.astro";
import SectionLayer1 from "@components/@layout/section-layer-1.astro";
import Section1Img from "@assets/images/Nahayatnegar/Contact Us/contact-us-hero.png";
import Section1ImgMob from "@assets/images/Nahayatnegar/Contact Us/contact-us-hero-mob.png";
import IconInstagram from "@assets/icons/iconsax/outline/instagram.svg";
import IconWhatsapp from "@assets/icons/iconsax/outline/whatsapp.svg";
import IconLocation from "@assets/icons/iconsax/bulk/location.svg";
import IconCall from "@assets/icons/iconsax/bulk/call.svg";
import IconSMS from "@assets/icons/iconsax/bulk/sms.svg";
import { siteUrl } from "@utils/url";
---

<Layout title="تماس با ما">
  <main>
    <SectionLayer1 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <!-- right -->
      <div class="flex items-center self-center flex-1" slot="right">
        <div class="flex flex-col items-center gap-8 lg:items-start">
          <span class="text-display-small text-white">تماس با ما</span>
          <h1 class="text-body-large text-white text-center">راه‌های ارتباطی با کارگزاری نهایت‌نگر</h1>
        </div>
      </div>
      <!-- left -->
      <div class="flex-1" slot="left"></div>
    </SectionLayer1>

    <section class="flex py-8 lg:py-16 px-4 bg-white">
      <div class="flex flex-col lg:flex-row gap-4 max-w-lg w-full mx-auto relative">
        <div class="flex flex-col gap-6 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <div class="rounded-round h-1 w-16 lg:h-18 lg:w-1 bg-linear-to-r lg:bg-linear-to-b from-[#0170F3] via-[#7766E2] to-[#E64086]"></div>
            <div class="flex flex-col items-center lg:items-start">
              <span class="text-secondary">تماس با ما</span>
              <h1 class="text-display-small text-center">ما اینجا هستیم تا به شما کمک کنیم</h1>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="text-title-large text-center lg:text-start">دفتر مرکزی</h3>
            <div class="flex items-center gap-4 p-2">
              <IconLocation />
              <span>تهران، خیابان ملاصدرا، شیخ بهایی جنوبی، پلاک ۳۱</span>
            </div>
            <div class="flex items-center gap-4 p-2">
              <IconCall />
              <a class="ltr" href="tel:02184450">
                ۰۲۱ ۸۴۴۵۰
              </a>
            </div>
            <div class="flex items-center gap-4 p-2">
              <IconSMS />
              <a href="mailto:Info@nahayatnegar.com">Info@nahayatnegar.com</a>
            </div>
          </div>

          <div class="flex justify-center lg:justify-start gap-2">
            <a class="neo-button neo-icon-button neo-button-primary" href="/" aria-label="واتساپ">
              <IconWhatsapp aria-hidden="true" />
            </a>
            <a class="neo-button neo-icon-button neo-button-primary" href="/" aria-label="اینستاگرام">
              <IconInstagram aria-hidden="true" />
            </a>
          </div>

          <div class="flex">
            <a class="neo-button neo-button-primary" href={siteUrl("/branches")}>
              آدرس و تلفن شعب
            </a>
          </div>
        </div>

        <form class="flex flex-col gap-4 p-8 rounded-3xl bg-fg-secondary flex-1">
          <div class="flex flex-col gap-3">
            <span class="text-title-large">نام و نام‌خانوادگی</span>
            <input type="text" name="name" placeholder="به فارسی" />
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-title-large">ایمیل</span>
            <input type="text" name="email" placeholder="email@gmail.com" />
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-title-large">پیام شما</span>
            <textarea name="message" placeholder="پیام خود را بنویسید."></textarea>
          </div>

          <button type="submit" class="neo-button neo-button-fill-primary neo-button-large">
            ارسال
          </button>
        </form>
      </div>
    </section>

    <section class="flex py-8 lg:py-16 px-4 bg-white">
      <div class="border rounded-3xl w-full max-w-lg h-80 mx-auto relative bg-secondary"></div>
    </section>
  </main>
</Layout>

---
import SectionLayer1 from "@components/@layout/section-layer-1.astro";
import Layout from "@layouts/Layout.astro";

import IconSearch from "@assets/icons/iconsax/outline/search-normal-1.svg";
import ArrowDown from "@assets/icons/iconsax/outline/arrow-down-2.svg";
import IconClose from "@assets/icons/iconsax/outline/close-circle.svg";
import Timer from "@assets/icons/iconsax/bulk/Timer1.svg";
import Medal from "@assets/icons/iconsax/bulk/Medal.svg";

import Section1Img from "@assets/images/Learning/learning-hero.png";
import Section1ImgMob from "@assets/images/Learning/learning-hero-mob.png";

import {
  ARTICLE_LEVELS,
  fetchLatestArticles,
  type ArticleLevel,
  type PostsResponseDto,
} from "../../services/learning/article.service";

type Article = {
  id: string;
  title: string;
  description: string;
  level: ArticleLevel;
  readingTime: number;
  publishedAt: string;
  image: { url: string; alt: string };
};

const levels = ARTICLE_LEVELS;

const WORDS_PER_MINUTE = 120;

const getReadingTime = (html: string) => {
  const words = html
    .replace(/<[^>]*>/g, " ")
    .split(/\s+/)
    .filter(Boolean).length;

  return Math.max(1, Math.ceil(words / WORDS_PER_MINUTE));
};

let rawArticles: PostsResponseDto[] = [];
try {
  rawArticles = await fetchLatestArticles();
} catch (error) {
  console.error("Failed to load articles:", error);
}

const toLevel = (raw?: string): ArticleLevel => {
  if (!raw) return "beginner";
  return levels.find((item) => item.value === raw || raw.includes(item.label))?.value ?? "beginner";
};

const articles: Article[] = rawArticles
  .filter((article) => article.published)
  .map((article) => ({
    id: article.id,
    title: article.title,
    description: article.description ?? "",
    level: toLevel(article.level),
    readingTime: getReadingTime(article.content ?? ""),
    publishedAt: article.publishedAt || article.createdAt,
    image: { url: article.imageUrl ?? "", alt: article.title },
  }));

const articlesJson = JSON.stringify(
  articles.map((article) => ({
    ...article,
    levelLabel: levels.find((item) => item.value === article.level)?.label ?? "",
  })),
).replace(/</g, "\\u003c");
---

<Layout title="Learning">
  <main class="bg-white">
    <SectionLayer1 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <!-- right -->
      <div class="flex flex-1 items-center self-center" slot="right">
        <div class="flex flex-col items-center gap-8 lg:items-start">
          <span class="text-display-small text-white">آموزش</span>
          <h1 class="text-center text-body-large text-white">منابع آموزشی حرفه‌ای برای سرمایه‌گذاران آینده‌نگر</h1>
          <div class="flex flex-wrap items-center justify-center gap-2 text-body-large text-white">
            <div class="neo-chip">آموزش مقدماتی بورس</div>
            <div class="neo-chip">روانشناسی بازار</div>
            <div class="neo-chip">تحلیل بنیادی</div>
          </div>
        </div>
      </div>
      <!-- left -->
      <div class="flex-1" slot="left"></div>
    </SectionLayer1>

    <!-- Tabs and Search -->
    <section class="neo-page-content flex bg-fg-primary px-0 py-8 lg:py-2" aria-label="Post filters">
      <div class="relative mx-auto flex w-full max-w-lg flex-col gap-6">
        <h4 class="text-heading-medium">مقالات آموزشی</h4>

        <div class="flex w-full flex-1 flex-col items-center justify-between gap-4 lg:w-auto lg:flex-row">
          <div id="article-level" class="neo-tabs w-full lg:w-auto" aria-label="Post categories">
            {
              levels.map((level) => (
                <button class="neo-tab-label w-full lg:w-auto" type="button" data-account-tab={level.value}>
                  {level.label}
                </button>
              ))
            }
          </div>

          <div class="flex w-full justify-end gap-2">
            <div class="relative flex w-full lg:w-30">
              <select
                id="article-sort"
                class="text-2xl h-8.75 w-full appearance-none rounded-lg border border-(--border-color-secondary) pr-2 pl-2 text-right text-secondary outline-none focus:border-brand"
              >
                <option value="newest" selected>جدیدترین</option>
                <option value="oldest">قدیمی‌ترین</option>
              </select>

              <ArrowDown class="pointer-events-none absolute top-2.5 left-3 h-4 w-4" />
            </div>

            <div class="relative flex w-full lg:w-55">
              <input
                id="article-search"
                class="flex-1 pl-10"
                type="text"
                name="search"
                placeholder="جستجو"
                aria-label="جستجو"
                autocomplete="off"
                aria-controls="article-list"
                data-article-search
              />
              <IconSearch class="absolute top-2.5 left-3 h-4 w-4" data-article-search-icon />
              <button
                class="absolute top-2.5 left-3 hidden cursor-pointer"
                type="button"
                aria-label="پاک کردن جستجو"
                data-article-search-clear
              >
                <IconClose class="h-4 w-4" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Posts List -->
    <section class="neo-page-content px-0" aria-label="Posts">
      <div class="flex flex-wrap gap-4" id="article-list">
        <div
          id="article-loader"
          class="hidden w-full basis-full items-center justify-center py-6"
          role="status"
          aria-live="polite"
        >
          <span class="h-8 w-8 animate-spin rounded-full border-4 border-[#E9EBF2] border-t-brand"></span>
          <span class="sr-only">در حال بارگذاری</span>
        </div>
        <div id="article-sentinel" class="h-px w-full basis-full" aria-hidden="true"></div>
      </div>
    </section>

    <script is:inline id="articles-data" type="application/json" set:html={articlesJson} />

    <!-- Card template: cloned by the script, 6 at a time -->
    <template id="article-card-template">
      <article class="h-66 w-64 overflow-hidden rounded-lg bg-secondary">
        <a data-field="link" href="#" class="block h-full cursor-pointer px-2 pt-2 pb-4">
          <header class="overflow-hidden rounded-xl bg-[#E9EBF2]">
            <img
              data-field="image"
              src=""
              alt=""
              width="256"
              height="141"
              class="h-[141px] w-full rounded-xl object-cover opacity-0 transition-opacity duration-500"
              loading="lazy"
              decoding="async"
            />
            <div data-field="placeholder" class="h-[141px] w-full rounded-xl bg-[#E9EBF2]"></div>
          </header>

          <footer class="flex flex-col gap-3 px-2 pt-2">
            <div class="flex gap-2">
              <div class="flex items-center gap-1">
                <Timer class="h-4 w-4 text-[#767D98]" />
                <span data-field="readingTime" class="text-caption-medium text-[#767D98]"></span>
              </div>
              <div class="flex items-center gap-1">
                <Medal class="h-4 w-4 text-[#767D98]" />
                <span data-field="level" class="text-caption-medium text-[#767D98]"></span>
              </div>
            </div>

            <div class="flex flex-col gap-1">
              <h6 data-field="title" class="text-title-medium"></h6>
              <p data-field="description" class="text-body-small"></p>
            </div>
          </footer>
        </a>
      </article>
    </template>
  </main>
</Layout>

<script>
  type ArticleCard = {
    id: string;
    title: string;
    description: string;
    level: string;
    levelLabel: string;
    readingTime: number;
    publishedAt: string;
    image: { url: string; alt: string } | string | null;
  };

  const PAGE_SIZE = 6;
  const LOAD_DELAY = 600;
  const defaultLevel = "beginner";

  const levelTabs = document.querySelectorAll<HTMLButtonElement>("#article-level [data-account-tab]");
  const searchInput = document.querySelector<HTMLInputElement>("#article-search");
  const sortSelect = document.querySelector<HTMLSelectElement>("#article-sort");
  const articleList = document.querySelector<HTMLElement>("#article-list");
  const sentinel = document.querySelector<HTMLElement>("#article-sentinel");
  const loader = document.querySelector<HTMLElement>("#article-loader");
  const searchIcon = document.querySelector<SVGElement>("[data-article-search-icon]");
  const clearSearchButton = document.querySelector<HTMLButtonElement>("[data-article-search-clear]");
  const template = document.querySelector<HTMLTemplateElement>("#article-card-template");
  const dataElement = document.querySelector<HTMLScriptElement>("#articles-data");

  const allArticles: ArticleCard[] = JSON.parse(dataElement?.textContent ?? "[]");

  let matched: ArticleCard[] = [];
  let renderedCount = 0;
  let isLoading = false;
  let loadTimer: number | undefined;

  const normalize = (value: string) => value.toLocaleLowerCase("fa").replace(/ي/g, "ی").replace(/ك/g, "ک").trim();

  const getActiveLevel = () =>
    document.querySelector<HTMLButtonElement>("#article-level [data-account-tab].active")?.dataset.accountTab ??
    defaultLevel;

  const setText = (root: ParentNode, field: string, value: string) => {
    const element = root.querySelector<HTMLElement>(`[data-field="${field}"]`);
    if (element) element.textContent = value;
  };

  const createCard = (article: ArticleCard) => {
    const fragment = template!.content.cloneNode(true) as DocumentFragment;

    const link = fragment.querySelector<HTMLAnchorElement>('[data-field="link"]');
    if (link) link.href = `/learning/${encodeURIComponent(article.id)}`;

    const image = fragment.querySelector<HTMLImageElement>('[data-field="image"]');
    const placeholder = fragment.querySelector<HTMLElement>('[data-field="placeholder"]');
    const imageUrl = typeof article.image === "string" ? article.image : article.image?.url;
    const imageAlt = typeof article.image === "string" ? article.title : (article.image?.alt ?? article.title);

    if (imageUrl && image) {
      image.addEventListener("load", () => image.classList.remove("opacity-0"), { once: true });
      image.src = imageUrl;
      image.alt = imageAlt;
      placeholder?.remove();
    } else {
      image?.remove();
    }

    setText(fragment, "readingTime", String(article.readingTime));
    setText(fragment, "level", article.levelLabel);
    setText(fragment, "title", article.title);
    setText(fragment, "description", article.description);

    return fragment;
  };

  const renderNext = () => {
    if (!template || !articleList) return;

    const next = matched.slice(renderedCount, renderedCount + PAGE_SIZE);
    const fragment = document.createDocumentFragment();

    next.forEach((article) => fragment.appendChild(createCard(article)));
    articleList.insertBefore(fragment, loader ?? sentinel);

    renderedCount += next.length;
  };

  const filterArticles = (selectedLevel: string) => {
    levelTabs.forEach((tab) => {
      tab.classList.toggle("active", tab.dataset.accountTab === selectedLevel);
    });

    const query = normalize(searchInput?.value ?? "");
    const sortBy = sortSelect?.value ?? "newest";

    matched = allArticles
      .filter((article) => {
        const matchesLevel = selectedLevel === "all" || article.level === selectedLevel;
        const matchesSearch =
          normalize(article.title).includes(query) || normalize(article.description).includes(query);

        return matchesLevel && matchesSearch;
      })
      .sort((a, b) => {
        const dateA = new Date(a.publishedAt).getTime();
        const dateB = new Date(b.publishedAt).getTime();

        return sortBy === "oldest" ? dateA - dateB : dateB - dateA;
      });

    window.clearTimeout(loadTimer);
    isLoading = false;
    setLoader(false);

    articleList?.querySelectorAll("article").forEach((element) => element.remove());
    renderedCount = 0;
    renderNext();
    recheckSentinel();
  };

  const setLoader = (visible: boolean) => {
    loader?.classList.toggle("hidden", !visible);
    loader?.classList.toggle("flex", visible);
  };

  const loadMore = () => {
    isLoading = true;
    setLoader(true);

    loadTimer = window.setTimeout(() => {
      renderNext();
      setLoader(false);
      isLoading = false;
      recheckSentinel();
    }, LOAD_DELAY);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      if (!entries[0].isIntersecting) return;
      if (isLoading || renderedCount >= matched.length) return;

      loadMore();
    },
    { rootMargin: "0px 0px 300px 0px" },
  );

  function recheckSentinel() {
    if (!sentinel) return;
    requestAnimationFrame(() => {
      observer.unobserve(sentinel);
      observer.observe(sentinel);
    });
  }

  if (sentinel) observer.observe(sentinel);

  levelTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const level = tab.dataset.accountTab;
      if (level) filterArticles(level);
    });
  });

  sortSelect?.addEventListener("change", () => filterArticles(getActiveLevel()));
  const updateSearchControls = () => {
    const hasSearchTerm = Boolean(searchInput?.value);
    searchIcon?.classList.toggle("hidden", hasSearchTerm);
    clearSearchButton?.classList.toggle("hidden", !hasSearchTerm);
  };

  searchInput?.addEventListener("input", () => {
    updateSearchControls();
    filterArticles(getActiveLevel());
  });

  clearSearchButton?.addEventListener("click", () => {
    if (!searchInput) return;

    searchInput.value = "";
    searchInput.dispatchEvent(new Event("input", { bubbles: true }));
    searchInput.focus();
  });

  filterArticles(defaultLevel);
</script>

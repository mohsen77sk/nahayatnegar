---
import Layout from "@layouts/Layout.astro";
import { fetchAllArticles, resolveImageUrl } from "./article.service";

const articles = (await fetchAllArticles()).filter((article) => article.published);
---

<Layout title="مقالات آموزشی">
  <main class="mx-auto min-h-screen w-full max-w-280 px-4 py-10">
    <h1 class="mb-8 text-heading-large font-bold">مقالات آموزشی</h1>
    <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" aria-label="مقالات آموزشی">
      {articles.map((article) => (
        <a
          href={`/learning/${article.id}`}
          class="overflow-hidden rounded-xl border border-slate-200 shadow-sm transition hover:shadow-md"
        >
          <img
            src={resolveImageUrl(article.imageUrl)}
            alt={article.title}
            class="aspect-video w-full object-cover"
            loading="lazy"
          />
          <div class="p-5">
            <h2 class="text-lg font-bold">{article.title}</h2>
            <p class="mt-3 line-clamp-3 text-sm leading-7 text-slate-600">
              {typeof article.description === "string" ? article.description : article.description?.text || ""}
            </p>
          </div>
        </a>
      ))}
    </section>
  </main>
</Layout>

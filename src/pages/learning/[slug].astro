---
import Layout from "../../layouts/Layout.astro";
import {
  fetchLatestArticles,
  calculateReadingTime,
  formatPersianDate,
  getLevelLabel,
  resolveImageUrl,
  type PostsResponseDto,
} from "../../services/learning/article.service";

import Book from "@assets/icons/iconsax/outline/book.svg";
import Calendar from "@assets/icons/iconsax/outline/calendar.svg";
import Medal from "@assets/icons/iconsax/outline/medal.svg";
import BreadCrumb from "@components/bread-crumb.astro";

export async function getStaticPaths() {
  const posts = (await fetchLatestArticles()).filter((post) => post.published && post.id);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { article: post },
  }));
}

interface Props {
  article: PostsResponseDto;
}
const id = Astro.params.slug;
const { article } = Astro.props;

if (!id || id !== article.id) {
  throw new Error(`Article route "${id ?? ""}" does not match its generated article.`);
}

interface TocItem {
  id: string;
  title: string;
  order: number;
}

const tocItems: TocItem[] = [...(article.headings || [])].sort((a, b) => a.order - b.order);
const processedContent = (article.content || "").replace(/&nbsp;|&#160;|&#xA0;|\u00a0/gi, " ");

const bannerSrc = resolveImageUrl(article.imageUrl);
const readingTime = calculateReadingTime(article.content).toLocaleString("fa-IR");
const publishDate = formatPersianDate(article.publishedAt || article.createdAt);
const levelLabel = getLevelLabel(article.level);

const breadCrumbItems = [{ label: "مقالات آموزشی", href: "/learning" }, { label: article.title }];
---

<Layout
  title={article.title}
  description={article.description ||
    `${article.title}؛ راهنمایی آموزشی از گروه مالی نهایت‌نگر درباره بازار سرمایه و سرمایه‌گذاری.`}
  image={bannerSrc}
>
  <div class="h-21 w-full bg-[#131C3C] lg:h-25"></div>
  <main class="m-auto flex min-h-screen flex-col gap-6 lg:w-280">
    <BreadCrumb items={breadCrumbItems} />
    {/* 1. Article Header */}
    <header class="py-4 text-start">
      <h1 class="text-heading-large leading-12 font-bold tracking-tight">{article.title}</h1>
    </header>

    {/* 2. Top Hero Banner */}
    <div class="shadow-md relative w-full overflow-hidden">
      <img src={bannerSrc} alt={article.title} class="h-full w-full object-cover" loading="eager" />
    </div>

    {/* 3. Two-Column Layout: Sidebar TOC + Main Content */}
    <div class="grid grid-cols-1 items-start gap-8 pt-2 lg:grid-cols-12">
      {/* Article Body */}
      <div class="text-slate-700 text-base order-1 space-y-8 leading-relaxed lg:col-span-9">
        {/* Metadata Header Bar */}
        <div
          class="border-sky-100 text-xs text-sky-800 flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-brand/16 px-4 py-3"
        >
          <div class="flex items-center gap-2">
            <Medal class="w-5 text-brand" />
            <span>
              سطح: <span class="font-bold">{levelLabel}</span>
            </span>
          </div>

          <div class="flex items-center gap-2">
            <Book class="w-5 text-brand" />
            <span>
              زمان مطالعه: <span class="font-bold">{readingTime} دقیقه</span>
            </span>
          </div>

          <div class="flex items-center gap-2">
            <Calendar class="w-5 text-brand" />
            <span>
              زمان انتشار: <span class="font-bold">{publishDate}</span>
            </span>
          </div>
        </div>

        <article
          id="article-content"
          class="prose prose-slate max-w-none p-6 text-justify leading-8 wrap-break-word lg:col-span-8 [&_a]:text-brand [&_a]:no-underline [&_h2]:scroll-mt-10 [&_h2]:text-heading-small [&_h2]:leading-9 [&_h2]:font-bold"
          set:html={processedContent}
        />
      </div>

      {/* Sticky Sidebar (Table of Contents) */}
      {
        tocItems.length > 0 && (
          <aside class="order-1 hidden w-full flex-col self-start wrap-break-word lg:sticky lg:top-24 lg:col-span-3 lg:flex">
            <nav class="shadow-sm text-xs flex flex-col gap-3" aria-label="فهرست مطالب">
              <div class="flex items-center justify-center rounded-lg bg-neutral-300 p-3">
                <h2 class="font-bold">فهرست مطالب</h2>
              </div>

              <div class="flex flex-col space-y-2.5 text-secondary" id="toc-list">
                {tocItems.map((item, index) => (
                  <div class="flex flex-col space-y-1">
                    <a
                      href={`#${item.id}`}
                      class:list={[
                        "toc-item block border-r-2 p-2 leading-snug transition-all duration-200",
                        index === 0 ? "border-r-brand font-semibold" : "border-transparent text-secondary",
                      ]}
                      set:html={item.title}
                    />
                  </div>
                ))}
              </div>
            </nav>
          </aside>
        )
      }
    </div>
  </main>
</Layout>
<script>
  let tocEventController: AbortController | undefined;
  let tocScrollFrame = 0;

  function initDynamicTOC() {
    tocEventController?.abort();
    cancelAnimationFrame(tocScrollFrame);

    const article = document.getElementById("article-content");
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-item"));
    if (!article || tocLinks.length === 0) return;

    const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>("h2"));
    if (headings.length === 0) return;

    headings?.forEach((heading, index) => {
      if (!heading.id) {
        heading.id = tocLinks[index]?.getAttribute("href")?.slice(1) || `topic-${index}`;
      }
    });

    const controller = new AbortController();
    tocEventController = controller;
    const setActiveLink = (activeLink: HTMLAnchorElement) => {
      tocLinks.forEach((link) => {
        const isActive = link === activeLink;
        link.classList.toggle("border-r-brand", isActive);
        link.classList.toggle("font-semibold", isActive);
        link.classList.toggle("border-transparent", !isActive);
        link.classList.toggle("text-secondary", !isActive);
      });
    };

    tocLinks.forEach((link) => {
      link.addEventListener(
        "click",
        (e) => {
          e.preventDefault();
          const targetId = link.getAttribute("href")?.substring(1);
          const targetHeading = document.getElementById(targetId || "");

          if (targetHeading) {
            targetHeading.scrollIntoView({ behavior: "smooth", block: "start" });
            history.pushState(null, "", `#${targetId}`);
          }

          setActiveLink(link);
        },
        { signal: controller.signal },
      );
    });

    const updateActiveLink = () => {
      const activationLine = 120;
      let activeIndex = 0;

      headings.forEach((heading, index) => {
        if (heading.getBoundingClientRect().top <= activationLine) {
          activeIndex = index;
        }
      });

      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        activeIndex = headings.length - 1;
      }

      const activeId = headings[activeIndex]?.id;
      const activeLink = tocLinks.find((link) => link.getAttribute("href") === `#${activeId}`);
      if (activeLink) setActiveLink(activeLink);
    };

    const scheduleActiveLinkUpdate = () => {
      cancelAnimationFrame(tocScrollFrame);
      tocScrollFrame = requestAnimationFrame(updateActiveLink);
    };

    window.addEventListener("scroll", scheduleActiveLinkUpdate, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", scheduleActiveLinkUpdate, {
      signal: controller.signal,
    });
    updateActiveLink();
  }

  document.addEventListener("DOMContentLoaded", initDynamicTOC);
  document.addEventListener("astro:page-load", initDynamicTOC);
</script>

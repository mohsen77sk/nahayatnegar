---
import { siteUrl } from "@utils/url";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import BannerCard from "@components/bannerCard.astro";
import PageContent from "@components/PageContent.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import TimeLine from "@components/time-line.astro";
import Faq from "@components/faq.astro";

import Section1Img from "@assets/images/Asset Management/3-Pooya/pooya-hero.png";
import Section1ImgMob from "@assets/images/Asset Management/3-Pooya/pooya-hero-mob.png";
import SectionBanner1Img from "@assets/images/Asset Management/3-Pooya/pooya-pic1.png";
import SectionBanner2Img from "@assets/images/Asset Management/3-Pooya/pooya-pic2.png";
import SectionBanner3Img from "@assets/images/Asset Management/3-Pooya/Banner.png";
import SectionBanner3ImgMob from "@assets/images/Asset Management/3-Pooya/Banner-mob.png";
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import ChartIcon from "@assets/icons/iconsax/outline/chart-2.svg";
import GraphIcon from "@assets/icons/iconsax/outline/graph.svg";
import ProfileIcon from "@assets/icons/iconsax/outline/profile-2user.svg";
import DocumentIcon from "@assets/icons/iconsax/outline/document-text-1.svg";
import ShoppingCartIcon from "@assets/icons/iconsax/outline/shopping-cart.svg";
import LinkIcon from "@assets/icons/iconsax/outline/link.svg";
import ArchiveIcon from "@assets/icons/iconsax/outline/archive.svg";
import SearchIcon from "@assets/icons/iconsax/outline/search-normal-1.svg";

const BreadCrumbItem = [
  {
    label: "مدیریت دارایی",
    href: "/portfolio-management",
  },
  {
    label: "صندوق پویا",
    href: "/portfolio-management/pooya",
  },
];

const features = [
  {
    icon: ProfileIcon,
    title: "مدیریت حرفه‌ای",
    description: "تصمیم‌گیری درباره ترکیب دارایی‌ها توسط مدیر صندوق و تیم تحلیل بازار سرمایه.",
  },
  {
    icon: ChartIcon,
    title: "سبدی متنوع از سهام",
    description: "سرمایه‌گذاری در صنایع و شرکت‌های مختلف برای کاهش ریسک غیرسیستماتیک.",
  },
  {
    icon: GraphIcon,
    title: "مدیریت مستمر پرتفوی",
    description: "بازنگری و به‌روزرسانی ترکیب دارایی‌ها متناسب با شرایط بازار.",
  },
  {
    icon: ShoppingCartIcon,
    title: "سرمایه‌گذاری آسان",
    description: "بدون نیاز به تحلیل، انتخاب و مدیریت روزانه سهام.",
  },
  {
    icon: DocumentIcon,
    title: "شفافیت اطلاعات",
    description: "دسترسی به NAV، ترکیب دارایی‌ها و گزارش‌های عملکرد صندوق.",
  },
];

const different = [
  {
    fund: "تحلیل و تصمیم‌گیری توسط تیم متخصص",
    comparison: "تصمیم‌گیری",
    physical: "نیاز به صرف زمان برای تحلیل بازار",
  },
  {
    fund: "مدیریت حرفه‌ای سبد توسط مدیر صندوق",
    comparison: "مدیریت سبد",
    physical: "انتخاب و مدیریت سبد بر عهده سرمایه‌گذار",
  },
  {
    fund: "پایش مداوم بازار توسط تیم مدیریت صندوق",
    comparison: "رصد بازار",
    physical: "نیاز به پیگیری مستمر اخبار و تحولات بازار",
  },
  {
    fund: "سرمایه‌گذاری در یک سبد متنوع با خرید واحدهای صندوق",
    comparison: "انعطاف",
    physical: "تنوع‌بخشی مستلزم خرید سهام متعدد",
  },
  {
    fund: "تصمیم‌گیری بر پایه تحلیل و استراتژی سرمایه‌گذاری",
    comparison: "رویکرد",
    physical: "تصمیم‌گیری احساسی در شرایط نوسانی",
  },
];

const timeline = {
  title: "سرمایه‌گذاری در صندوق پویا در سه گام",
  steps: [
    {
      title: "ثبت‌نام در کارگزاری",
      description: "افتتاح حساب و دریافت کد بورسی",
      icon: LinkIcon,
    },
    {
      title: "ثبت درخواست سرمایه‌گذاری از طریق سامانه فین وست",
      description: "از طریق این لینک وارد سامانه فین‌وست شوید: www.finvest.ir",
      icon: SearchIcon,
    },
    {
      title: " آغاز سرمایه‌گذاری",
      description: "صدور واحدهای صندوق و مدیریت سرمایه توسط تیم حرفه‌ای صندوق.",
      icon: ArchiveIcon,
    },
  ],
};

const faqs = [
  {
    title: "حداقل مبلغ سرمایه‌گذاری چقدر است؟",
    description: "مطابق مقررات معاملات صندوق‌های قابل معامله در بورس",
  },
  {
    title: "سرمایه‌گذاری در صندوق پویا چگونه انجام می‌شود؟",
    description:
      "سرمایه‌گذاری از طریق صدور واحدهای صندوق و ابطال آن‌ها بر اساس ارزش خالص دارایی‌ها (NAV) انجام می‌شود.",
  },
  {
    title: "آیا صندوق پویا سود تضمین‌شده دارد؟",
    description: "خیر. بازده صندوق به عملکرد بازار سهام و مدیریت دارایی‌های صندوق وابسته است و تضمین‌شده نیست.",
  },
  {
    title: "آیا امکان برداشت سرمایه وجود دارد؟",
    description: "بله. سرمایه‌گذاران می‌توانند مطابق مقررات صندوق، درخواست ابطال واحدهای خود را ثبت کنند.",
  },
  {
    title: "NAV چیست؟",
    description: "NAV یا ارزش خالص دارایی‌ها، ارزش واقعی هر واحد صندوق است که مبنای صدور و ابطال واحدها قرار می‌گیرد.",
  },
  {
    title: "صندوق پویا برای چه افق زمانی مناسب است؟",
    description: "صندوق‌های سهامی معمولاً برای سرمایه‌گذاری میان‌مدت و بلندمدت مناسب‌تر هستند.",
  },
  {
    title: "اطلاعات عملکرد صندوق را از کجا می‌توان مشاهده کرد؟",
    description:
      "NAV، گزارش‌های عملکرد، ترکیب دارایی‌ها و سایر اطلاعات صندوق از طریق وب‌سایت صندوق و سامانه‌های رسمی بازار سرمایه منتشر می‌شود.",
  },
];
---

<Layout title="صندوق سرمایه‌گذاری پویا">
  <main>
    <SectionLayer2 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <h1 class="text-display-small text-white">صندوق سرمایه‌گذاری پویا</h1>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          صندوق سرمایه‌گذاری سهامی پویا، با مدیریت حرفه‌ای و سرمایه‌گذاری در سبدی متنوع از سهام، راهکاری برای رشد
          بلندمدت سرمایه و بهره‌مندی از فرصت‌های بازار سرمایه است.
        </p>
        <div class="flex gap-4">
          <a class="neo-button neo-button-fill-primary neo-button-large" href={siteUrl("/")}>
            خرید صندوق
            <ArrowLeft aria-hidden="true" />
          </a>
          <a class="neo-button neo-button-outline-primary neo-button-large" href={siteUrl("/")}>
            دریافت کد بورسی
            <ArrowLeft aria-hidden="true" />
          </a>
        </div>
      </div>
    </SectionLayer2>

    <PageContent items={BreadCrumbItem} classes="mx-auto mb-15 flex max-w-200 flex-col gap-6 p-4">

      <div>
        <h2 class="text-heading-medium leading-10">چرا صندوق پویا؟</h2>
        <div class="text-body-medium leading-7 text-secondary">سرمایه‌گذاری را به متخصصان بسپارید.</div>
      </div>

      <p class="text-body-large leading-8">
        موفقیت در بازار سهام تنها به انتخاب چند سهم مناسب محدود نمی‌شود. تحلیل مستمر بازار، مدیریت ریسک، پایش اخبار و
        بازنگری ترکیب سبد، همگی در دستیابی به بازدهی مطلوب نقش دارند. صندوق پویا این مسئولیت را به تیمی از متخصصان بازار
        سرمایه می‌سپارد تا شما بتوانید با اطمینان بیشتری سرمایه‌گذاری کنید.
      </p>

      <FeaturesGrid features={features} rowPattern={[2, 3]} />

      <div class="rounded-xl bg-fg-primary p-2 shadow-primary">
        <Image src={SectionBanner1Img} alt="صندوق پویا" class="h-auto w-full rounded-xl" loading="lazy" />
      </div>

      <h2 class="text-heading-medium leading-10">صندوق پویا چگونه سرمایه‌گذاری می‌کند؟</h2>

      <p class="text-body-large leading-8">
        صندوق پویا بخش عمده دارایی‌های خود را در سهام شرکت‌های پذیرفته‌شده در بورس و فرابورس سرمایه‌گذاری می‌کند. مدیر
        صندوق با تحلیل مستمر شرایط بازار، فرصت‌های سرمایه‌گذاری را شناسایی کرده و ترکیب دارایی‌های صندوق را با هدف رشد
        بلندمدت سرمایه مدیریت می‌کند.
      </p>

      <h2 class="text-heading-medium leading-10">مقایسه خرید مستقیم سهام با صندوق پویا</h2>

      <div class="rounded-xl bg-fg-primary p-2">
        <table class="w-full table-fixed text-center text-body-medium">
          <colgroup>
            <col class="w-[40%]" />
            <col class="w-[20%]" />
            <col class="w-[40%]" />
          </colgroup>
          <thead class="bg-blue-900 text-white">
            <tr>
              <th scope="col" class="h-11 rounded-r-lg px-4 py-2 text-start">صندوق پویا</th>
              <th scope="col" class="h-11 px-4 py-2">مقایسه</th>
              <th scope="col" class="h-11 rounded-l-lg px-4 py-2 text-end">سرمایه‌گذاری مستقیم</th>
            </tr>
          </thead>
          <tbody>
            {
              different.map((item, index) => (
                <tr class:list={[{ "border-b": index < different.length - 1 }]}>
                  <td class="p-4 text-start">{item.fund}</td>
                  <th scope="row" class="py-4 font-medium">
                    <span class="inline-block rounded-md bg-blue-100 px-2 py-1 text-brand lg:px-3">
                      {item.comparison}
                    </span>
                  </th>
                  <td class="p-4 text-end">{item.physical}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="text-heading-medium leading-10">چرا صندوق سهامی؟</h2>

      <p class="text-body-large leading-8">
        صندوق‌های سرمایه‌گذاری سهامی، امکان حضور در بازار سهام را با بهره‌گیری از دانش و تجربه مدیران سرمایه‌گذاری فراهم
        می‌کنند. به‌جای صرف زمان برای انتخاب سهام و مدیریت پرتفوی، سرمایه شما در قالب یک سبد متنوع و بر اساس یک استراتژی
        مشخص مدیریت می‌شود.
      </p>

      <h2 class="text-heading-medium leading-10">نمودار بازدهی صندوق پویا</h2>

      <div class="rounded-xl bg-fg-primary p-2"></div>

      <h2 class="text-heading-medium leading-10">صندوق پویا مناسب چه کسانی است؟</h2>

      <ul class="space-y-4 text-body-large leading-8">
        <li>سرمایه‌گذارانی که ترجیح می‌دهند مدیریت سرمایه خود را به متخصصان بسپارند.</li>
        <li>افرادی که فرصت کافی برای تحلیل و رصد روزانه بازار ندارند.</li>
        <li>افرادی که به دنبال رشد سرمایه در افق میان‌مدت و بلندمدت هستند.</li>
        <li>سرمایه‌گذارانی که به دنبال تنوع‌بخشی به سبد دارایی‌های خود هستند.</li>
        <li>افرادی که می‌خواهند بدون درگیری با انتخاب سهام، در بازار سرمایه حضور داشته باشند.</li>
      </ul>

      <div class="rounded-xl bg-fg-primary p-2 shadow-primary">
        <Image src={SectionBanner2Img} alt="صندوق ناب" class="h-auto w-full rounded-xl" loading="lazy" />
      </div>

      <TimeLine steps={timeline.steps} title={timeline.title} />

      <Faq faqs={faqs} />

      <div class="flex">
        <a class="neo-button neo-button-primary" href="./">
          <span>وبسایت صندوق</span>
          <ArrowLeft aria-hidden="true" />
        </a>
      </div>

      <!-- Footer CTA -->
      <BannerCard desktopImage={SectionBanner3Img} mobileImage={SectionBanner3ImgMob}>
        <div class="flex flex-col gap-4 text-white lg:w-2/3">
          <h1 class="text-heading-medium leading-10">آینده سرمایه خود را به تیمی متخصص بسپارید.</h1>
          <p class="text-body-large leading-8 text-neutral-500">
            صندوق سرمایه‌گذاری سهامی پویا با مدیریت حرفه‌ای، تحلیل مستمر بازار و تشکیل سبدی متنوع از سهام، این امکان را
            فراهم می‌کند تا بدون نیاز به مدیریت مستقیم پرتفوی، در مسیر رشد بلندمدت سرمایه حرکت کنید.
          </p>
        </div>
        <a href="" class="neo-button neo-button-fill-primary neo-button-large min-w-25 lg:w-40">
          خرید صندوق
          <ArrowLeft aria-hidden="true" />
        </a>
      </BannerCard>
    </PageContent>
  </main>
</Layout>

---
import { Image } from "astro:assets";

import Layout from "@layouts/Layout.astro";

import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import BannerCard from "@components/bannerCard.astro";
import Faq from "@components/faq.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import FundChart from "@components/FundChart.astro";
import PageContent from "@components/PageContent.astro";
import TimeLine from "@components/time-line.astro";

import ArchiveIcon from "@assets/icons/iconsax/outline/archive.svg";
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import DiagramIcon from "@assets/icons/iconsax/outline/diagram.svg";
import DocumentIcon from "@assets/icons/iconsax/outline/document-text-1.svg";
import LinkIcon from "@assets/icons/iconsax/outline/link.svg";
import ProfileIcon from "@assets/icons/iconsax/outline/profile-2user.svg";
import SearchIcon from "@assets/icons/iconsax/outline/search-normal-1.svg";
import SecurityIcon from "@assets/icons/iconsax/outline/security.svg";
import ShoppingCartIcon from "@assets/icons/iconsax/outline/shopping-cart.svg";
import WalletIcon from "@assets/icons/iconsax/outline/wallet-1.svg";
import SectionBanner3ImgMob from "@assets/images/Asset Management/1-Naab/Banner-mob.png";
import SectionBanner3Img from "@assets/images/Asset Management/1-Naab/Banner.png";
import Section1ImgMob from "@assets/images/Asset Management/1-Naab/naab-hero-mob.png";
import Section1Img from "@assets/images/Asset Management/1-Naab/naab-hero.png";
import SectionBanner1Img from "@assets/images/Asset Management/1-Naab/naab-pic1.png";
import SectionBanner2Img from "@assets/images/Asset Management/1-Naab/naab-pic2.png";

import { siteUrl } from "@utils/url";

const BreadCrumbItem = [
  {
    label: "مدیریت دارایی",
    href: "/portfolio-management",
  },
  {
    label: "صندوق ناب",
    href: "/portfolio-management/nab",
  },
];

const features = [
  {
    icon: DiagramIcon,
    title: "حفظ ارزش سرمایه",
    description: "بهره‌مندی از ظرفیت بازار طلا برای حفظ ارزش دارایی در برابر تورم و کاهش قدرت خرید.",
  },
  {
    icon: SecurityIcon,
    title: "بدون دغدغه نگهداری طلا",
    description: "بدون نگرانی از سرقت، مفقودی، هزینه نگهداری یا تشخیص اصالت طلای فیزیکی.",
  },
  {
    icon: ShoppingCartIcon,
    title: "سرمایه‌گذاری آسان",
    description: "خرید و فروش واحدهای صندوق همانند سایر صندوق‌های قابل معامله (ETF) از طریق سامانه معاملاتی.",
  },
  {
    icon: WalletIcon,
    title: "نقدشوندگی مناسب",
    description: "امکان خرید و فروش واحدهای صندوق در روزهای معاملاتی بورس.",
  },
  {
    icon: ProfileIcon,
    title: "مدیریت حرفه‌ای",
    description: "مدیریت دارایی‌های صندوق توسط تیم متخصص و در چارچوب مقررات بازار سرمایه.",
  },
  {
    icon: DocumentIcon,
    title: "شفافیت اطلاعات",
    description: "انتشار مستمر ارزش خالص دارایی‌ها (NAV)، ترکیب دارایی‌ها و گزارش‌های صندوق.",
  },
];

const different = [
  {
    fund: "بدون نیاز به نگهداری طلا",
    comparison: "امنیت",
    physical: "نیاز به نگهداری و حفاظت",
  },
  {
    fund: "دارایی‌های تحت نظارت بازار سرمایه",
    comparison: "اصالت",
    physical: "نگرانی از اصالت",
  },
  {
    fund: "بدون دغدغه اجرت ساخت و نگهداری",
    comparison: "هزینه",
    physical: "احتمال هزینه‌های جانبی",
  },
  {
    fund: "معامله آنلاین از طریق بورس",
    comparison: "خرید و فروش",
    physical: "خرید و فروش سنتی",
  },
  {
    fund: "خرید و فروش آسان در بورس",
    comparison: "نقدشوندگی",
    physical: "نقدشوندگی وابسته به بازار فیزیکی",
  },
];

const timeline = {
  title: "سرمایه‌گذاری در صندوق ناب در سه گام",
  steps: [
    {
      title: "ثبت‌نام در کارگزاری",
      description: "افتتاح حساب و دریافت کد بورسی",
      icon: LinkIcon,
    },
    {
      title: "ورود به سامانه معاملاتی",
      description: "جستجوی نماد ناب در سامانه معاملاتی نهایت‌نگر.",
      icon: SearchIcon,
    },
    {
      title: "خرید واحدهای صندوق",
      description: "ثبت سفارش خرید و آغاز سرمایه‌گذاری در صندوق ناب.",
      icon: ArchiveIcon,
    },
  ],
};

const faqs = [
  {
    title: "آیا صندوق ناب سود تضمین‌شده دارد؟",
    description: "خیر. بازده صندوق به عملکرد دارایی‌های آن و تغییرات قیمت طلا وابسته است و سود تضمین‌شده ندارد.",
  },
  {
    title: "آیا هر زمان بخواهم می‌توانم واحدهای صندوق را بفروشم؟",
    description: "بله، در روزهای معاملاتی بورس امکان خرید و فروش واحدهای صندوق وجود دارد.",
  },
  {
    title: "تفاوت صندوق ناب با خرید طلای فیزیکی چیست؟",
    description:
      "در صندوق ناب نیازی به خرید، حمل و نگهداری طلای فیزیکی ندارید و سرمایه‌گذاری شما از طریق بازار سرمایه و با شفافیت بیشتر انجام می‌شود.",
  },
  {
    title: "NAV صندوق چیست؟",
    description: "NAV یا ارزش خالص دارایی‌ها، ارزش واقعی هر واحد صندوق است که به‌صورت مستمر محاسبه و منتشر می‌شود.",
  },
  {
    title: "حداقل مبلغ سرمایه‌گذاری چقدر است؟",
    description: "حتی با 100 هزارتومان هم می توان در صندوق طلای ناب سرمایه گذاری کرد.",
  },
  {
    title: "سرمایه صندوق در چه دارایی‌هایی سرمایه‌گذاری می‌شود؟",
    description:
      "بخش عمده دارایی‌های صندوق در گواهی سپرده کالایی طلا و سایر دارایی‌های مجاز مندرج در امیدنامه صندوق سرمایه‌گذاری می‌شود.",
  },
];
---

<Layout title="صندوق سرمایه‌گذاری ناب">
  <main>
    <SectionLayer2 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <h1 class="text-display-small text-white">صندوق سرمایه‌گذاری ناب</h1>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          با صندوق ناب، بدون نیاز به خرید، حمل و نگهداری طلای فیزیکی، می‌توانید از فرصت‌های بازار طلا برای حفظ ارزش
          دارایی خود بهره‌مند شوید.
        </p>
        <div class="flex gap-4">
          <a class="neo-button neo-button-fill-primary neo-button-large" href={siteUrl("/")}>
            خرید صندوق
            <ArrowLeft aria-hidden="true" />
          </a>
          <a class="neo-button neo-button-outline-primary neo-button-large" href={siteUrl("/")}>
            دریافت کد بورسی
            <ArrowLeft aria-hidden="true" />
          </a>
        </div>
      </div>
    </SectionLayer2>

    <PageContent items={BreadCrumbItem} classes="mx-auto mb-15 flex max-w-200 flex-col gap-6 p-4">

      <div>
        <h2 class="text-heading-medium leading-10">چرا صندوق ناب؟</h2>
        <div class="text-body-medium leading-7 text-secondary">محافظت از سرمایه خود در برابر تورم</div>
      </div>

      <p class="text-body-large leading-8">
        سرمایه‌گذاری در طلا همواره یکی از راهکارهای مورد توجه سرمایه‌گذاران برای حفظ ارزش دارایی بوده است. صندوق ناب این
        امکان را فراهم می‌کند تا بدون پیچیدگی‌های خرید طلای فیزیکی، از مزایای سرمایه‌گذاری در این بازار بهره‌مند شوید.
      </p>

      <FeaturesGrid features={features} rowPattern={[3, 3]} />

      <div class="rounded-xl bg-fg-primary p-2 shadow-primary">
        <Image src={SectionBanner1Img} alt="صندوق ناب" class="h-auto w-full rounded-xl" loading="lazy" />
      </div>

      <h2 class="text-heading-medium leading-10">صندوق ناب چگونه کار می‌کند؟</h2>

      <p class="text-body-large leading-8">
        دارایی‌های صندوق ناب عمدتاً در گواهی سپرده کالایی طلا سرمایه‌گذاری می‌شود. به همین دلیل، ارزش واحدهای صندوق
        عمدتاً متناسب با تغییرات قیمت طلا تغییر می‌کند. شما بدون خرید طلای فیزیکی، در بازار طلا سرمایه‌گذاری می‌کنید و
        هر زمان که بخواهید، می‌توانید واحدهای صندوق را از طریق بورس خرید یا فروش کنید.
      </p>

      <h2 class="text-heading-medium leading-10">مقایسه خرید فیزیکی طلا با خرید صندوق ناب</h2>

      <div class="overflow-hidden rounded-xl bg-fg-primary p-2">
        <table class="w-full table-fixed text-center text-body-medium">
          <colgroup>
            <col class="w-[40%]" />
            <col class="w-[20%]" />
            <col class="w-[40%]" />
          </colgroup>
          <thead class="bg-blue-900 text-white">
            <tr>
              <th scope="col" class="h-11 rounded-r-lg px-4 py-2 text-start">صندوق ناب</th>
              <th scope="col" class="h-11 px-4 py-2">مقایسه</th>
              <th scope="col" class="h-11 rounded-l-lg px-4 py-2 text-end">خرید طلای فیزیکی</th>
            </tr>
          </thead>
          <tbody>
            {
              different.map((item, index) => (
                <tr class:list={[{ "border-b": index < different.length - 1 }]}>
                  <td class="p-4 text-start">{item.fund}</td>
                  <th scope="row" class="py-4 font-medium">
                    <span class="inline-block rounded-md bg-blue-100 px-2 py-1 text-brand lg:px-3">
                      {item.comparison}
                    </span>
                  </th>
                  <td class="p-4 text-end">{item.physical}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="text-heading-medium leading-10">چرا سرمایه‌گذاری در صندوق طلا؟</h2>

      <p class="text-body-large leading-8">
        صندوق‌های سرمایه‌گذاری مبتنی بر طلا، امکان سرمایه‌گذاری غیرمستقیم در این بازار را با شفافیت، امنیت و سهولت فراهم
        می‌کنند. به جای خرید طلای فیزیکی، سرمایه شما در دارایی‌های مبتنی بر طلا سرمایه‌گذاری می‌شود و می‌توانید بدون
        دغدغه نگهداری، از تغییرات ارزش این بازار بهره‌مند شوید.
      </p>

      <h2 class="text-heading-medium leading-10">نمودار بازدهی صندوق طلای ناب</h2>

      <FundChart apiUrl="https://landing-api.nahayatnegar.com/assetDailyInfo" />

      <h2 class="text-heading-medium leading-10">صندوق ناب مناسب چه کسانی است؟</h2>

      <ul class="space-y-4 text-body-large leading-8">
        <li>افرادی که به دنبال حفظ ارزش سرمایه در برابر تورم هستند.</li>
        <li>سرمایه‌گذارانی که به آینده بازار طلا خوش‌بین هستند.</li>
        <li>افرادی که تمایلی به نگهداری طلای فیزیکی ندارند.</li>
        <li>کسانی که به دنبال سرمایه‌گذاری شفاف و تحت نظارت بازار سرمایه هستند.</li>
        <li>سرمایه‌گذارانی که خرید و فروش آنلاین را به روش‌های سنتی ترجیح می‌دهند.</li>
      </ul>

      <div class="rounded-xl bg-fg-primary p-2 shadow-primary">
        <Image src={SectionBanner2Img} alt="صندوق ناب" class="h-auto w-full rounded-xl" loading="lazy" />
      </div>

      <TimeLine steps={timeline.steps} title={timeline.title} />

      <Faq faqs={faqs} />

      <div class="flex">
        <a class="neo-button neo-button-primary" href="./">
          <span>وبسایت صندوق</span>
          <ArrowLeft aria-hidden="true" />
        </a>
      </div>

      <!-- Footer CTA -->
      <BannerCard desktopImage={SectionBanner3Img} mobileImage={SectionBanner3ImgMob}>
        <div class="flex flex-col gap-4 text-white lg:w-2/3">
          <h1 class="text-heading-medium leading-10">سرمایه‌گذاری در طلا، آسان‌تر از همیشه</h1>
          <p class="text-body-large leading-8 text-neutral-500">
            اگر به دنبال راهکاری مطمئن، شفاف و آسان برای حفظ ارزش سرمایه خود در برابر تورم هستید، صندوق سرمایه‌گذاری در
            گواهی سپرده کالایی طلا ناب می‌تواند انتخابی مناسب برای شما باشد.
          </p>
        </div>
        <a href="" class="neo-button neo-button-fill-primary neo-button-large min-w-25 lg:w-40">
          خرید صندوق
          <ArrowLeft aria-hidden="true" />
        </a>
      </BannerCard>
    </PageContent>
  </main>
</Layout>

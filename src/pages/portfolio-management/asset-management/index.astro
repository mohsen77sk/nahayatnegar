---
import { siteUrl } from "@utils/url";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import BannerCard from "@components/bannerCard.astro";
import BreadCrumb from "@components/bread-crumb.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import TimeLine from "@components/time-line.astro";
import Faq from "@components/faq.astro";

import Section1Img from "@assets/images/Asset Management/5-Portfolio Management/PM-hero.png";
import Section1ImgMob from "@assets/images/Asset Management/5-Portfolio Management/PM-hero-mob.png";
import Section2ImgSub1 from "@assets/images/Asset Management/5-Portfolio Management/image1.png";
import Section2ImgSub2 from "@assets/images/Asset Management/5-Portfolio Management/image2.png";
import Section2ImgSub3 from "@assets/images/Asset Management/5-Portfolio Management/image3.png";
import Section2ImgSub4 from "@assets/images/Asset Management/5-Portfolio Management/image4.png";
import SectionBanner1Img from "@assets/images/Asset Management/5-Portfolio Management/pm-pic1.png";
import SectionBanner2Img from "@assets/images/Asset Management/5-Portfolio Management/pm-pic2.png";
import SectionBanner3Img from "@assets/images/Asset Management/5-Portfolio Management/Banner.png";
import SectionBanner3ImgMob from "@assets/images/Asset Management/5-Portfolio Management/Banner-mob.png";
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import Warning2 from "@assets/icons/iconsax/outline/warning-2.svg";
import GraphIcon from "@assets/icons/iconsax/outline/graph.svg";
import BagIcon from "@assets/icons/iconsax/outline/bag.svg";
import EyeIcon from "@assets/icons/iconsax/outline/eye.svg";
import ChartIcon from "@assets/icons/iconsax/outline/chart.svg";
import DocumentIcon from "@assets/icons/iconsax/outline/document-text-1.svg";
import UserTagIcon from "@assets/icons/iconsax/outline/user-tag.svg";
import MessageEditIcon from "@assets/icons/iconsax/outline/message-edit.svg";
import NoteIcon from "@assets/icons/iconsax/outline/note.svg";

const BreadCrumbItem = [
  {
    label: "مدیریت دارایی",
    href: "/portfolio-management",
  },
  {
    label: "سبدگردانی اختصاصی",
    href: "/portfolio-management/asset-management",
  },
];

const features = [
  {
    icon: GraphIcon,
    title: "طراحی اختصاصی استراتژی سرمایه‌گذاری",
    description:
      "هیچ دو سرمایه‌گذاری شرایط یکسانی ندارند؛ بنابراین هر سبد متناسب با ویژگی‌های همان سرمایه‌گذار طراحی می‌شود.",
  },
  {
    icon: BagIcon,
    title: "مدیریت حرفه‌ای دارایی‌ها",
    description: "سبد سرمایه‌گذاری توسط مدیران حرفه‌ای و تیم تحلیل بازار سرمایه به‌صورت مستمر مدیریت می‌شود.",
  },
  {
    icon: EyeIcon,
    title: "بازنگری مستمر",
    description: "ترکیب دارایی‌ها متناسب با شرایط بازار و اهداف سرمایه‌گذار بازبینی و اصلاح می‌شود.",
  },
  {
    icon: ChartIcon,
    title: "تنوع‌بخشی به سرمایه‌گذاری",
    description: "سرمایه در ترکیبی از دارایی‌ها و صنایع مختلف توزیع می‌شود تا ریسک غیرسیستماتیک کاهش یابد.",
  },
  {
    icon: DocumentIcon,
    title: "شفافیت کامل",
    description: "گزارش عملکرد، ارزش دارایی‌ها و وضعیت سبد به‌صورت مستمر در اختیار سرمایه‌گذار قرار می‌گیرد.",
  },
];

const different = [
  {
    fund: "سبد اختصاصی برای هر سرمایه‌گذار",
    comparison: "مدیریت",
    physical: "یک پرتفوی برای همه",
  },
  {
    fund: "متناسب با اهداف هر فرد",
    comparison: "استراتژی",
    physical: "ثابت",
  },
  {
    fund: "تصمیم‌گیری متناسب با شرایط هر مشتری",
    comparison: "دارایی",
    physical: "یکسان برای همه سرمایه‌گذاران",
  },
  {
    fund: "قابل بازنگری",
    comparison: "انعطاف",
    physical: "انعطاف محدود",
  },
  {
    fund: "سرمایه‌گذاری شخصی",
    comparison: "سرمایه‌گذاری",
    physical: "سرمایه‌گذاری عمومی",
  },
];

const timeline = {
  title: "سبدگردانی چگونه آغاز می‌شود؟",
  steps: [
    {
      title: "جلسه مشاوره",
      description: "شناخت اهداف مالی، میزان ریسک‌پذیری و افق سرمایه‌گذاری",
      icon: UserTagIcon,
    },
    {
      title: "طراحی استراتژی",
      description: "تدوین سیاست سرمایه‌گذاری و ترکیب اولیه دارایی‌ها",
      icon: GraphIcon,
    },
    {
      title: "انعقاد قرارداد",
      description: "افتتاح حساب اختصاصی و آغاز فرآیند مدیریت سبد",
      icon: MessageEditIcon,
    },
    {
      title: "مدیریت و گزارش‌دهی مستمر",
      description: "پایش بازار، بازنگری سبد و ارائه گزارش‌های دوره‌ای",
      icon: NoteIcon,
    },
  ],
};

const faqs = [
  {
    title: "حداقل سرمایه موردنیاز برای سبدگردانی چقدر است؟",
    description: "مطابق مقررات سازمان بورس و شرایط شرکت سبدگردان تعیین می‌شود.",
  },
  {
    title: "آیا بازدهی سبدگردانی تضمین‌شده است؟",
    description: "خیر. عملکرد سبد به شرایط بازار و نتایج سرمایه‌گذاری وابسته است و هیچ بازدهی تضمین نمی‌شود.",
  },
  {
    title: "دارایی‌ها به نام چه کسی خواهد بود؟",
    description: "تمام دارایی‌ها در مالکیت سرمایه‌گذار باقی می‌ماند و در حساب اختصاصی وی نگهداری می‌شود.",
  },
  {
    title: "آیا در طول قرارداد امکان تغییر استراتژی وجود دارد؟",
    description: "در صورت تغییر اهداف یا شرایط سرمایه‌گذار، استراتژی سرمایه‌گذاری می‌تواند با توافق طرفین بازنگری شود.",
  },
];
---

<Layout title="سبدگردانی اختصاصی">
  <main>
    <SectionLayer2 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <h1 class="text-display-small text-white">سبدگردانی اختصاصی</h1>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          سبدگردانی اختصاصی نهایت‌نگر، مدیریت حرفه‌ای سرمایه بر اساس اهداف، میزان ریسک‌پذیری و نیازهای مالی شماست.
        </p>
        <div class="flex gap-4">
          <a class="neo-button neo-button-fill-primary neo-button-large" href={siteUrl("/")}>
            درخواست سبدگردانی
            <ArrowLeft aria-hidden="true" />
          </a>
          <a class="neo-button neo-button-outline-primary neo-button-large" href={siteUrl("/")}>
            مشاوره سرمایه‌گذاری
            <ArrowLeft aria-hidden="true" />
          </a>
        </div>
      </div>
    </SectionLayer2>

    <section class="mx-auto mb-15 flex max-w-200 flex-col gap-6 p-4">
      <BreadCrumb items={BreadCrumbItem} />

      <div>
        <h2 class="text-heading-medium leading-10">چرا سبدگردانی اختصاصی؟</h2>
        <div class="text-body-medium leading-7 text-secondary">
          سرمایه‌گذاری متناسب با اهداف، ریسک‌پذیری و افق سرمایه‌گذاری شما
        </div>
      </div>

      <p class="text-body-large leading-8">
        سرمایه‌گذاری موفق تنها به انتخاب چند سهم مناسب محدود نمی‌شود؛ بلکه به داشتن استراتژی درست بستگی دارد. برخی
        سرمایه‌گذاران به دنبال رشد حداکثری سرمایه هستند، برخی ترجیح می‌دهند ریسک کمتری بپذیرند و گروهی نیز میان ریسک و
        بازده تعادل برقرار می‌کنند. در سبدگردانی اختصاصی نهایت‌نگر، به جای ارائه یک پرتفوی یکسان به همه سرمایه‌گذاران،
        برای هر مشتری استراتژی اختصاصی طراحی می‌شود.
      </p>


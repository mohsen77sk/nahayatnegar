            <span class="text-body-medium leading-7 text-secondary">
              مناسب سرمایه‌گذارانی که حفظ سرمایه و دریافت بازدهی با نوسان کمتر را ترجیح می‌دهند.
            </span>
          </div>
          <Image class="h-auto w-25 lg:w-28" src={Section2ImgSub3} alt="نهایت نگر" />
        </div>
        <div class="flex items-center gap-4 rounded-md bg-fg-primary p-6">

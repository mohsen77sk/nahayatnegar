      </div>

      <h2 class="text-heading-medium leading-10">مزایای سبدگردانی اختصاصی نهایت‌نگر</h2>

      <FeaturesGrid features={features} rowPattern={[2, 3]} />

      <h2 class="text-heading-medium leading-10">سبدگردانی اختصاصی در مقایسه با صندوق سرمایه‌گذاری</h2>

      <div class="rounded-xl bg-fg-primary p-2">
        <table class="w-full table-fixed text-center text-body-medium">
          <colgroup>
            <col class="w-[40%]" />
            <col class="w-[20%]" />
            <col class="w-[40%]" />
          </colgroup>
          <thead class="bg-blue-900 text-white">
            <tr>
              <th scope="col" class="h-11 rounded-r-lg px-4 py-2 text-start">صندوق ناب</th>
              <th scope="col" class="h-11 px-4 py-2">مقایسه</th>
              <th scope="col" class="h-11 rounded-l-lg px-4 py-2 text-end">خرید طلای فیزیکی</th>
            </tr>
          </thead>
          <tbody>
            {
              different.map((item, index) => (
                <tr class:list={[{ "border-b": index < different.length - 1 }]}>
                  <td class="p-4 text-start">{item.fund}</td>
                  <th scope="row" class="py-4 font-medium">
                    <span class="inline-block rounded-md bg-blue-100 px-2 py-1 text-brand lg:px-3">
                      {item.comparison}
                    </span>
                  </th>
                  <td class="p-4 text-end">{item.physical}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="rounded-xl bg-fg-primary p-2 shadow-primary">
        <Image src={SectionBanner2Img} alt="نهایت‌نگر" class="h-auto w-full rounded-xl" loading="lazy" />
      </div>

      <TimeLine steps={timeline.steps} title={timeline.title} />

      <Faq faqs={faqs} />

      <!-- Footer CTA -->
      <BannerCard desktopImage={SectionBanner3Img} mobileImage={SectionBanner3ImgMob}>
        <div class="flex flex-col gap-4 text-white lg:w-1/2">
          <h1 class="text-heading-medium leading-10">سرمایه‌گذاری متناسب با اهداف شما</h1>
          <p class="text-body-large leading-8 text-neutral-500">
            در سبدگردانی اختصاصی نهایت‌نگر، استراتژی سرمایه‌گذاری متناسب با اهداف، ریسک‌پذیری و افق زمانی شما طراحی
            می‌شود.
          </p>
        </div>
        <a href="" class="neo-button neo-button-fill-primary neo-button-large min-w-25 lg:w-50">
          درخواست سبدگردانی
          <ArrowLeft aria-hidden="true" />
        </a>
      </BannerCard>
    </section>
  </main>
</Layout>

<style is:global>
  .portfolio-orbit {
    animation: portfolio-orbit-flow 8s linear infinite;
  }

  .portfolio-orbit-point {
    animation: portfolio-orbit-pulse 2.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .portfolio-badge {
    transform-box: view-box;
    transform-origin: 50% 88.5%;
    animation: portfolio-badge-orbit 2.6s ease-in-out infinite alternate;
  }

  .portfolio-badge-2 {
    animation-delay: 0.2s;
  }

  .portfolio-badge-3 {
    animation-delay: 0.4s;
  }

  .portfolio-badge-4 {
    animation-delay: 0.6s;
  }

  .portfolio-badge-5 {
    animation-delay: 0.8s;
  }

  @keyframes portfolio-orbit-flow {
    to {
      stroke-dashoffset: -60;
    }
  }

  @keyframes portfolio-orbit-pulse {
    50% {
      fill-opacity: 0.8;
      transform: scale(1.5);
    }
  }

  @keyframes portfolio-badge-orbit {
    from {
      transform: rotate(-1.6deg);
    }

    to {
      transform: rotate(1.6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-orbit,
    .portfolio-orbit-point,
    .portfolio-badge {
      animation: none;
    }
  }
</style>

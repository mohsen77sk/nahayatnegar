---
import { Image } from "astro:assets";

import Layout from "@layouts/Layout.astro";

import SectionLayer2 from "@components/@layout/section-layer-2.astro";
import BannerCard from "@components/bannerCard.astro";
import Faq from "@components/faq.astro";
import FeaturesGrid from "@components/FeaturesGrid.astro";
import PageContent from "@components/PageContent.astro";
import TimeLine from "@components/time-line.astro";

import ArchiveIcon from "@assets/icons/iconsax/outline/archive.svg";
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import ArrowUpIcon from "@assets/icons/iconsax/outline/arrow-up.svg";
import ChartIcon from "@assets/icons/iconsax/outline/chart-2.svg";
import DocumentIcon from "@assets/icons/iconsax/outline/document-text-1.svg";
import GraphIcon from "@assets/icons/iconsax/outline/graph.svg";
import LinkIcon from "@assets/icons/iconsax/outline/link.svg";
import SearchIcon from "@assets/icons/iconsax/outline/search-normal-1.svg";
import WalletIcon from "@assets/icons/iconsax/outline/wallet-add.svg";
import Section1ImgMob from "@assets/images/Asset Management/4-Asil/asil-hero-mob.png";
import Section1Img from "@assets/images/Asset Management/4-Asil/asil-hero.png";
import SectionBanner1Img from "@assets/images/Asset Management/4-Asil/asil-pic1.png";
import SectionBanner2Img from "@assets/images/Asset Management/4-Asil/asil-pic2.png";
import SectionBanner3ImgMob from "@assets/images/Asset Management/4-Asil/Banner-mob.png";
import SectionBanner3Img from "@assets/images/Asset Management/4-Asil/Banner.png";

import { siteUrl } from "@utils/url";

const BreadCrumbItem = [
  {
    label: "مدیریت دارایی",
    href: "/portfolio-management",
  },
  {
    label: "صندوق اصیل",
    href: "/portfolio-management/asil",
  },
];

const features = [
  {
    icon: ArrowUpIcon,
    title: "بازدهی باثبات",
    description: "سرمایه‌گذاری در اوراق بهادار با درآمد ثابت با هدف ایجاد بازدهی مستمر",
  },
  {
    icon: ChartIcon,
    title: "ریسک کمتر",
    description:
      "ترکیب دارایی‌های صندوق به گونه‌ای مدیریت می‌شود که نوسانات آن نسبت به بسیاری از ابزارهای سرمایه‌گذاری کمتر باشد.",
  },
  {
    icon: GraphIcon,
    title: "تنوع دارایی‌ها",
    description: "سرمایه‌گذاری در مجموعه‌ای از اوراق بهادار با درآمد ثابت و سایر دارایی‌های مجاز.",
  },
  {
    icon: WalletIcon,
    title: "نقدشوندگی مناسب",
    description: "امکان خرید و فروش واحدهای صندوق و دسترسی آسان به سرمایه، مطابق سازوکار صندوق.",
  },
  {
    icon: DocumentIcon,
    title: "شفافیت اطلاعات",
    description: "انتشار مستمر ارزش خالص دارایی‌ها (NAV)، گزارش عملکرد و ترکیب دارایی‌های صندوق.",
  },
];

const different = [
  {
    fund: "بدون داشتن محدودیت زمانی",
    comparison: "نقدشوندگی",
    physical: "محدودیت درتعیین زمان سپرده گذاری",
  },
  {
    fund: "یکسان بودن نرخ سود برای هر دوره زمانی ",
    comparison: "بازدهی",
    physical: "کاهش نرخ سود درصورت برداشت زودتر از موعد ",
  },
  {
    fund: "سرمایه‌گذاری در سبدی متنوع از اوراق بهادار با درآمد ثابت",
    comparison: "ترکیب دارایی",
    physical: "سرمایه‌گذاری محدود به سپرده بانکی",
  },
  {
    fund: "مدیریت حرفه‌ای توسط مدیر صندوق",
    comparison: "مدیریت",
    physical: "مدیریت سرمایه توسط بانک",
  },
  {
    fund: "مدیریت فعال و متناسب با شرایط بازار",
    comparison: "استراتژی",
    physical: "انعطاف کمتر در مدیریت دارایی",
  },
  {
    fund: "انتشار مستمر NAV و گزارش عملکرد",
    comparison: "شفافیت",
    physical: "اطلاعات محدود",
  },
];

const timeline = {
  title: "سرمایه‌گذاری در صندوق اصیل در سه گام",
  steps: [
    {
      title: "ثبت‌نام در کارگزاری",
      description: "افتتاح حساب و دریافت کد بورسی",
      icon: LinkIcon,
    },
    {
      title: "جستجوی نماد «اصیل»",
      description: "ورود به سامانه معاملاتی و انتخاب نماد صندوق.",
      icon: SearchIcon,
    },
    {
      title: "خرید واحدهای صندوق",
      description: "ثبت سفارش خرید و آغاز سرمایه‌گذاری در صندوق اصیل.",
      icon: ArchiveIcon,
    },
  ],
};

const faqs = [
  {
    title: "آیا سرمایه‌گذاری در صندوق اصیل بدون ریسک است؟",
    description:
      "خیر. هیچ سرمایه‌گذاری بدون ریسک نیست، اما صندوق‌های با درآمد ثابت معمولاً نسبت به بسیاری از ابزارهای سرمایه‌گذاری، نوسان کمتری دارند.",
  },
  {
    title: "آیا بازده صندوق تضمین‌شده است؟",
    description: "خیر. بازده صندوق به عملکرد دارایی‌های آن وابسته است و تضمین‌شده نیست.",
  },
  {
    title: "آیا می‌توانم هر زمان واحدهای صندوق را بفروشم؟",
    description: "بله. مطابق سازوکار صندوق، امکان فروش واحدها و دریافت وجه وجود دارد.",
  },
  {
    title: "حداقل مبلغ سرمایه‌گذاری چقدر است؟",
    description: "حداقل مبلغ سرمایه‌گذاری مطابق مقررات صندوق تعیین می‌شود.",
  },
  {
    title: "NAV چیست؟",
    description: "NAV یا ارزش خالص دارایی‌ها، ارزش واقعی هر واحد صندوق است که به‌صورت مستمر محاسبه و منتشر می‌شود.",
  },
  {
    title: "وجوه صندوق در چه دارایی‌هایی سرمایه‌گذاری می‌شود؟",
    description:
      "بخش عمده دارایی‌های صندوق در اوراق بهادار با درآمد ثابت، سپرده‌های بانکی و سایر دارایی‌های مجاز سرمایه‌گذاری می‌شود.",
  },
  {
    title: "گزارش عملکرد صندوق را از کجا می‌توان مشاهده کرد؟",
    description:
      "اطلاعات، گزارش‌های دوره‌ای، NAV و ترکیب دارایی‌های صندوق از طریق وب‌سایت صندوق و سامانه‌های رسمی بازار سرمایه در دسترس است.",
  },
];
---

<Layout title="صندوق سرمایه‌گذاری اصیل">
  <main>
    <SectionLayer2 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <div class="flex flex-1 flex-col items-center justify-center gap-8 lg:items-start">
        <h1 class="text-display-small text-white">صندوق سرمایه‌گذاری اصیل</h1>
        <p class="text-center text-body-large leading-8 text-white lg:text-start">
          اگر به دنبال سرمایه‌گذاری کم‌ریسک برای مدیریت سرمایه و کسب بازدهی باثبات هستید، صندوق اصیل راهکاری حرفه‌ای
          برای سرمایه‌گذاری در اوراق بهادار با درآمد ثابت است.
        </p>
        <div class="flex gap-4">
          <a class="neo-button neo-button-fill-primary neo-button-large" href={siteUrl("/")}>
            خرید صندوق
            <ArrowLeft aria-hidden="true" />
          </a>
          <a class="neo-button neo-button-outline-primary neo-button-large" href={siteUrl("/")}>
            دریافت کد بورسی
            <ArrowLeft aria-hidden="true" />
          </a>
        </div>
      </div>
    </SectionLayer2>

    <PageContent items={BreadCrumbItem} withBottomSpacing>

      <div>
        <h2 class="text-heading-medium leading-10">چرا صندوق اصیل؟</h2>
        <div class="text-body-medium leading-7 text-secondary">بازدهی باثبات، با ریسک کمتر</div>
      </div>

      <p class="text-body-large leading-8">
        صندوق اصیل با هدف ایجاد تعادل میان بازدهی، نقدشوندگی و مدیریت ریسک طراحی شده است تا سرمایه‌گذاران بتوانند با
        آسودگی بیشتری سرمایه خود را مدیریت کنند.
      </p>

      <FeaturesGrid features={features} rowPattern={[2, 3]} />

      <div class="rounded-xl bg-fg-primary p-2 shadow-primary">
        <Image src={SectionBanner1Img} alt="صندوق اصیل" class="h-auto w-full rounded-xl" loading="lazy" />
      </div>

      <h2 class="text-heading-medium leading-10">صندوق اصیل چگونه سرمایه‌گذاری می‌کند؟</h2>

      <p class="text-body-large leading-8">
        صندوق اصیل بخش عمده دارایی‌های خود را در اوراق بهادار با درآمد ثابت، سپرده‌های بانکی و سایر دارایی‌های مجاز
        سرمایه‌گذاری می‌کند. این ترکیب با هدف کاهش ریسک، ایجاد بازدهی باثبات و حفظ نقدشوندگی دارایی‌ها مدیریت می‌شود.
      </p>

      <h2 class="text-heading-medium leading-10">مقایسه صندوق اصیل با سپرده بانکی</h2>

      <div class="rounded-xl bg-fg-primary p-2">
        <table class="w-full table-fixed text-center text-body-medium">
          <colgroup>
            <col class="w-[40%]" />
            <col class="w-[20%]" />
            <col class="w-[40%]" />
          </colgroup>
          <thead class="bg-blue-900 text-white">
            <tr>
              <th scope="col" class="h-11 rounded-r-lg px-4 py-2 text-start">صندوق اصیل</th>
              <th scope="col" class="h-11 px-4 py-2">مقایسه</th>
              <th scope="col" class="h-11 rounded-l-lg px-4 py-2 text-end">سپرده بانکی</th>
            </tr>
          </thead>
          <tbody>
            {
              different.map((item, index) => (
                <tr class:list={[{ "border-b": index < different.length - 1 }]}>
                  <td class="p-4 text-start">{item.fund}</td>
                  <th scope="row" class="py-4 font-medium">
                    <span class="inline-block rounded-md bg-blue-100 px-2 py-1 text-brand lg:px-3">
                      {item.comparison}
                    </span>
                  </th>
                  <td class="p-4 text-end">{item.physical}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="text-heading-medium leading-10">چرا صندوق با درآمد ثابت؟</h2>

      <p class="text-body-large leading-8">
        صندوق‌های سرمایه‌گذاری با درآمد ثابت، یکی از مناسب‌ترین گزینه‌ها برای افرادی هستند که به دنبال مدیریت حرفه‌ای
        سرمایه، کاهش نوسانات و کسب بازدهی باثبات هستند. این صندوق‌ها به جای سرمایه‌گذاری مستقیم در اوراق بهادار، امکان
        بهره‌مندی از یک سبد متنوع و مدیریت‌شده را فراهم می‌کنند.
      </p>

      <h2 class="text-heading-medium leading-10">صندوق اصیل مناسب چه کسانی است؟</h2>

      <ul class="space-y-4 text-body-large leading-8">
        <li>افرادی که ریسک‌پذیری پایینی دارند.</li>
        <li>سرمایه‌گذارانی که به دنبال بازدهی باثبات هستند.</li>
        <li>اشخاص و شرکت‌هایی که قصد مدیریت وجوه نقد خود را دارند.</li>
        <li>افرادی که می‌خواهند بدون مدیریت مستقیم، سرمایه‌گذاری کنند.</li>
        <li>سرمایه‌گذارانی که به دنبال تنوع‌بخشی به سبد دارایی‌های خود هستند.</li>
      </ul>

      <div class="rounded-xl bg-fg-primary p-2 shadow-primary">
        <Image src={SectionBanner2Img} alt="صندوق اصیل" class="h-auto w-full rounded-xl" loading="lazy" />
      </div>

      <TimeLine steps={timeline.steps} title={timeline.title} />

      <Faq faqs={faqs} />

      <div class="flex">
        <a class="neo-button neo-button-primary" href="./">
          <span>وبسایت صندوق</span>
          <ArrowLeft aria-hidden="true" />
        </a>
      </div>

      <!-- Footer CTA -->
      <BannerCard desktopImage={SectionBanner3Img} mobileImage={SectionBanner3ImgMob}>
        <div class="flex flex-col gap-4 text-white lg:w-2/3">
          <h1 class="text-heading-medium leading-10">سرمایه‌گذاری مطمئن، با مدیریت حرفه‌ای</h1>
          <p class="text-body-large leading-8 text-neutral-500">
            اگر به دنبال راهکاری برای مدیریت سرمایه، کاهش ریسک و کسب بازدهی باثبات هستید، صندوق سرمایه‌گذاری در اوراق
            بهادار با درآمد ثابت اصیل می‌تواند انتخابی مناسب برای شما باشد.
          </p>
        </div>
        <a href="" class="neo-button neo-button-fill-primary neo-button-large min-w-25 lg:w-40">
          خرید صندوق
          <ArrowLeft aria-hidden="true" />
        </a>
      </BannerCard>
    </PageContent>
  </main>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import SectionLayer1 from "@components/@layout/section-layer-1.astro";
import Section1Img from "@assets/images/Nahayatnegar/About Us/about-us-hero.png";
import Section2ImgMob from "@assets/images/Nahayatnegar/About Us/about-us-pic1-mob.png";
import BrokerageBg from "@assets/images/Home/brokerage-bg.png";
import BrokerageObj from "@assets/images/Home/brokerage-object.png";
import HeroVideo from "@assets/images/Home/Sunrise over Earth.mp4";
import VideoHero from "@components/@layout/video-hero.astro";
import Section3Bg from "@assets/images/Home/chatGPT_image.png";
import Section3Obj from "@assets/images/Home/chatGPT_image-object.png";
import ArrowLeft from "@assets/icons/iconsax/outline/arrow-left.svg";
import SectionLearningBg from "@assets/images/Home/learning-bg.png";
import SectionLearningBgMobile from "@assets/images/Home/learning-bg-mob.png";
---

<Layout title="خانه">
  <main>
    <VideoHero desktopVideo={HeroVideo} mobileVideo="/videos/hero-mobile.mp4" poster={Section1Img}>
      <div slot="right" class="text-center">
        <h1 class="text-display-large text-white mb-2">گروه مالی نهایت‌نگر</h1>
        <p class="text-heading-large text-white mb-6">ارائه دهنده انواع سرویس‌ها و خدمات معاملاتی بازار سرمایه</p>
        <div class="flex gap-3 justify-center">
          <button class="neo-button neo-button-large neo-button-fill-primary hidden px-4.25 py-1.25 leading-normal font-normal lg:block">
            ثبت‌نام در بورس
          </button>
          <button class="neo-button neo-button-large neo-button-outline-primary hidden px-4.25 py-1.25 leading-normal font-normal lg:block">
            درخواست مشاوره
          </button>
        </div>
      </div>
    </VideoHero>

    <SectionLayer1 desktopImage={BrokerageBg} mobileImage={Section2ImgMob}>
      <!-- right -->
      <div class="flex items-center flex-1" slot="right">
        <img src={BrokerageObj.src} alt="" aria-hidden="true" />
      </div>

      <!-- left -->
      <div class="flex items-center flex-1" slot="left">
        <div class="flex flex-col gap-6 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <div class="rounded-round h-1 w-16 lg:h-18 lg:w-1 bg-linear-to-r lg:bg-linear-to-b from-[#0170F3] via-[#7766E2] to-[#E64086]"></div>
            <div class="flex flex-col items-center gap-2 lg:items-start">
              <h1 class="text-display-small">یک کارگزاری تمام بازار سرمایه</h1>
              <div class="flex flex-row-reverse items-center gap-2">
                <span class="py-1 px-3 rounded-full inline-flex items-center justify-center text-secondary bg-blue-100 text-body-medium whitespace-nowrap">
                  انرژی
                </span>

                <span class="py-1 px-3.5 inline-flex items-center justify-center rounded-full text-secondary bg-blue-100 text-body-medium whitespace-nowrap">
                  کالا
                </span>

                <span class="py-1 px-3 inline-flex items-center justify-center rounded-full text-secondary bg-blue-100 text-body-medium whitespace-nowrap">
                  فرابورس
                </span>

                <span class="py-1 px-3 inline-flex items-center justify-center rounded-full text-secondary bg-blue-100 text-body-medium whitespace-nowrap">
                  بورس اوراق بهادار
                </span>
              </div>
            </div>
          </div>

          <div class="flex flex-col items-start gap-4 pt-3 pb-3 pr-6">
            <p class="text-body-large font-medium leading-8 text-center lg:text-justify">
              با نهایت‌نگر، به همه بازارها و ابزارهای سرمایه‌گذاری دسترسی داشته باشید.
            </p>

            <button class="neo-button neo-button-fill-primary neo-button-large leading-normal font-normal flex gap-4">
              بیشتر
              <ArrowLeft class="neo-icon-button w-4.5 h-4.5" aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={Section3Bg} mobileImage={Section3Bg} hasGap={false}>
      <div class="flex items-center justify-end flex-1" slot="left">
        <img src={Section3Obj.src} alt="" class="w-[333px] h-[500px] md:w-[500px] md:h-[750px]" aria-hidden="true" />
      </div>

      <div class="flex items-center flex-1" slot="right">
        <div class="flex flex-col gap-6 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <div class="rounded-round h-1 w-16 lg:h-18 lg:w-1 bg-linear-to-r lg:bg-linear-to-b from-[#0170F3] via-[#7766E2] to-[#E64086]"></div>
            <div class="flex flex-col items-center lg:items-start">
              <h1 class="text-display-small text-white">مدیریت دارایی حرفه‌ای</h1>
              <span class="text-body-medium text-neutral-900">
                امنیت، سود پایدار و سرمایه‌گذاری هوشمند در بازار سرمایه
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-4 items-start pr-6">
            <p class="text-body-large font-medium leading-8 text-center text-white lg:text-justify">
              مدیریت سرمایه خود را به متخصصان نهایت‌نگر بسپارید و با آرامش خاطر از فرصت‌های بازار سرمایه بهره‌مند شوید.
            </p>

            <button class="neo-button neo-button-fill-primary neo-button-large leading-normal font-normal flex gap-4">
              بیشتر
              <ArrowLeft class="neo-icon-button w-4.5 h-4.5" aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={SectionLearningBg} mobileImage={SectionLearningBgMobile}>
      <div class="flex items-center flex-1" slot="right">
      </div>

      <div class="flex items-center flex-1" slot="left">
        <div class="flex flex-col gap-6 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <div class="rounded-round h-1 w-16 lg:h-18 lg:w-1 bg-linear-to-r lg:bg-linear-to-b from-[#0170F3] via-[#7766E2] to-[#E64086]"></div>
            <div class="flex flex-col items-center lg:items-start">
              <h1 class="text-display-small text-white">آموزش</h1>
              <span class="text-body-medium text-white">
                از علم به ثروت؛ دانش مالی، کلید رشد پایدار در بازار سرمایه
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-4 items-start pr-6">
            <p class="text-body-large font-medium leading-8 text-center text-white lg:text-justify">
              با دسترسی به اطلاعات و دانش مالی، آگاهانه‌تر تصمیم بگیرید و در بازار سرمایه ، حرفه‌ای‌ سرمایه‌گذاری کنید.
            </p>

            <button class="neo-button neo-button-fill-primary neo-button-large leading-normal font-normal flex gap-4">
              مقالات آموزشی
              <ArrowLeft class="neo-icon-button w-4.5 h-4.5" aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>
    </SectionLayer1>
  </main>
</Layout>

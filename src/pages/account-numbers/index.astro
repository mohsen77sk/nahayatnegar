---

<Layout title="شماره حساب‌های نهایت‌نگر">
  <main>
    <SectionLayer1 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <!-- right -->
      <div class="flex flex-1 items-center self-center" slot="right">
        <div class="flex flex-col items-center gap-8 lg:items-start">
          <h1 class="text-center text-display-small text-white">شماره حساب‌های نهایت‌نگر</h1>
          <div class="flex flex-wrap items-center justify-center gap-2 text-body-large text-white">
            <div class="neo-chip">بورس اوراق بهادار</div>
            <div class="neo-chip">بورس کالا</div>
            <div class="neo-chip">بورس انرژی</div>
            <div class="neo-chip">اختیار معامله</div>
          </div>
        </div>
      </div>
      <!-- left -->
      <div class="flex-1" slot="left"></div>
    </SectionLayer1>

    <section class="flex bg-fg-primary px-4 py-8 lg:py-16">
      <div class="relative mx-auto flex w-full max-w-lg flex-col gap-8">
        <div class="flex w-full flex-1 flex-col items-center justify-between gap-4 lg:w-auto lg:flex-row">
          <div class="neo-tabs w-full lg:w-auto">
            <button class="neo-tab-label active w-full lg:w-auto" type="button" data-account-tab="securities">
              حساب اوراق
            </button>
            <button class="neo-tab-label w-full lg:w-auto" type="button" data-account-tab="commodity">
              بورس کالا
            </button>
            <button class="neo-tab-label w-full lg:w-auto" type="button" data-account-tab="brokerage">
              کارگزاری
            </button>
            <button class="neo-tab-label w-full lg:w-auto" type="button" data-account-tab="energy"> بورس انرژی </button>
          </div>
          <div class="relative flex w-full lg:w-80">
            <input
              class="flex-1 pl-10"
              type="text"
              name="search"
              placeholder="جستجوی نام بانک، شماره حساب و ..."
              aria-label="جستجوی نام بانک، شماره حساب و ..."
              aria-controls="account-list"
              data-account-search
            />
            <IconSearch class="absolute top-2.5 left-3 h-4 w-4" data-account-search-icon />
            <button
              class="absolute top-2.5 left-3 hidden cursor-pointer"
              type="button"
              aria-label="پاک کردن جستجو"
              data-account-search-clear
            >
              <IconClose class="h-4 w-4" />
            </button>
          </div>
        </div>

        <div
          id="account-list"
          class="grid grid-cols-1 gap-4 rounded-xl bg-fg-secondary p-2 lg:grid-cols-2 lg:gap-8 lg:p-8"
        >
          {
            accountGroups.flatMap(({ key, accounts }) =>
              accounts.map(({ bankImg, bankName, accountType, accountNumber, iban }) => (
                <div
                  class:list={["grid gap-4 rounded-xl bg-fg-primary p-5", { hidden: key !== "securities" }]}
                  data-account-card
                  data-account-category={key}
                  data-search-text={`${bankName} ${accountType} ${accountNumber} ${iban}`}
                >
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                      <div class="h-13 w-13 overflow-hidden rounded-full border">
                        <Image class="h-full w-full object-none" src={bankImg} alt={bankName} loading="lazy" />
                      </div>
                      <div class="flex flex-col gap-1">
                        <span class="text-title-large">{bankName}</span>
                        <span class="text-body-large text-secondary">{accountType}</span>
                      </div>
                    </div>
                    <div />
                  </div>

                  <div class="flex flex-col gap-2 text-body-medium">
                    <div class="flex items-center justify-between">
                      <span class="text-secondary">شماره حساب</span>
                      <div class="flex items-center gap-2">
                        <span class="font-medium">{accountNumber}</span>
                        <button
                          class="neo-button neo-icon-button neo-button-neutral neo-button-small copy-tooltip"
                          type="button"
                          data-copy-value={accountNumber}
                          data-default-tooltip="کپی شماره حساب"
                          data-tooltip="کپی شماره حساب"
                          aria-label={`کپی شماره حساب ${bankName}`}
                        >
                          <span class="copy-icon">
                            <IconCopy />
                          </span>
                          <span class="check-icon hidden">
                            <IconCheck />
                          </span>
                        </button>
                      </div>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-secondary">شماره شبا</span>
                      <div class="flex items-center gap-2">
                        <span class="font-medium">{iban}</span>
                        <button
                          class="neo-button neo-icon-button neo-button-neutral neo-button-small copy-tooltip"
                          type="button"
                          data-copy-value={iban}
                          data-default-tooltip="کپی شماره شبا"
                          data-tooltip="کپی شماره شبا"
                          aria-label={`کپی شماره شبا ${bankName}`}
                        >
                          <span class="copy-icon">
                            <IconCopy />
                          </span>
                          <span class="check-icon hidden">
                            <IconCheck />
                          </span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              )),
            )
          }
          <p class="col-span-2 hidden p-4 text-center text-body-medium" data-no-results>نتیجه‌ای پیدا نشد.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .copy-tooltip {
    position: relative;
  }

  .copy-tooltip::after {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    padding: 8px;
    border-radius: 4px;
    background: #262b3e;
    color: #ffffff;
    content: attr(data-tooltip);
    font-size: 12px;
    line-height: 130%;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%);
    transition:
      opacity 150ms ease,
      visibility 150ms ease;
  }

  .copy-tooltip:hover::after,
  .copy-tooltip:focus-visible::after,
  .copy-tooltip[data-tooltip-visible]::after {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("[data-account-search]");
  const searchIcon = document.querySelector<SVGElement>("[data-account-search-icon]");
  const clearSearchButton = document.querySelector<HTMLButtonElement>("[data-account-search-clear]");
  const accountCards = document.querySelectorAll<HTMLElement>("[data-account-card]");
  const accountTabs = document.querySelectorAll<HTMLButtonElement>("[data-account-tab]");
  const noResults = document.querySelector<HTMLElement>("[data-no-results]");
  let activeCategory = "securities";

  const normalize = (value: string) => value.trim().toLocaleLowerCase().replace(/ي/g, "ی").replace(/ك/g, "ک");

  const updateSearchControls = () => {
    const hasSearchTerm = Boolean(searchInput?.value);
    searchIcon?.classList.toggle("hidden", hasSearchTerm);
    clearSearchButton?.classList.toggle("hidden", !hasSearchTerm);
  };

  const updateAccountList = () => {
    const searchTerm = normalize(searchInput?.value ?? "");
    let visibleCards = 0;

    accountCards.forEach((card) => {
      const belongsToCategory = card.dataset.accountCategory === activeCategory;
      const matchesSearch = normalize(card.dataset.searchText ?? "").includes(searchTerm);
      const isVisible = belongsToCategory && matchesSearch;

      card.classList.toggle("hidden", !isVisible);
      visibleCards += Number(isVisible);
    });

    noResults?.classList.toggle("hidden", visibleCards > 0);
  };

  accountTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      activeCategory = tab.dataset.accountTab ?? "securities";
      accountTabs.forEach((item) => item.classList.toggle("active", item === tab));
      updateAccountList();
    });
  });

  searchInput?.addEventListener("input", () => {
    updateSearchControls();
    updateAccountList();
  });

  clearSearchButton?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
      searchInput.dispatchEvent(new Event("input", { bubbles: true }));
      searchInput.focus();
    }
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((button) => {
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      const value = button.dataset.copyValue;

      if (value) {
        await navigator.clipboard.writeText(value);

        button.querySelector(".copy-icon")?.classList.add("hidden");
        button.querySelector(".check-icon")?.classList.remove("hidden");
        button.dataset.tooltip = "کپی شد";
        button.dataset.tooltipVisible = "";
        button.setAttribute("aria-label", "کپی شد");

        if (resetTimer) {
          clearTimeout(resetTimer);
        }

        resetTimer = setTimeout(() => {
          button.querySelector(".copy-icon")?.classList.remove("hidden");
          button.querySelector(".check-icon")?.classList.add("hidden");
          button.dataset.tooltip = button.dataset.defaultTooltip;
          delete button.dataset.tooltipVisible;
          button.setAttribute("aria-label", button.dataset.defaultTooltip ?? "کپی");
        }, 1000);
      }
    });
  });
</script>

---
import Layout from "@layouts/Layout.astro";
import SectionLayer1 from "@components/@layout/section-layer-1.astro";
import Section1Img from "@assets/images/Nahayatnegar/About Us/about-us-hero.png";
import Section1ImgMob from "@assets/images/Nahayatnegar/About Us/about-us-hero-mob.png";
import Section2Img from "@assets/images/Nahayatnegar/About Us/about-us-pic1.png";
import Section2ImgMob from "@assets/images/Nahayatnegar/About Us/about-us-pic1-mob.png";
import Section3Img from "@assets/images/Nahayatnegar/About Us/about-us-bg.png";
import Section3ImgMob from "@assets/images/Nahayatnegar/About Us/about-us-bg-mob.png";
---

<Layout title="درباره ما">
  <main>
    <SectionLayer1 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <!-- right -->
      <div class="flex items-center flex-1" slot="right">
        <div class="flex flex-col items-center gap-8 lg:items-start">
          <span class="text-display-small text-white">درباره ما</span>
          <h1 class="text-body-large text-white text-center">
            گروه مالی نهایت نگر، جایی که سرمایه‌گذاری به تخصص، سرعت و اعتماد گره می‌خورد
          </h1>
        </div>
      </div>
      <!-- left -->
      <div class="flex-1" slot="left"></div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={Section2Img} mobileImage={Section2ImgMob}>
      <!-- right -->
      <div class="hidden lg:flex flex-1" slot="right"></div>
      <!-- left -->
      <div class="flex items-center flex-1" slot="left">
        <div class="flex flex-col gap-10 flex-1">
          <div class="flex flex-col-reverse lg:flex-row items-center gap-6">
            <div class="rounded-round h-1 w-16 lg:h-18 lg:w-1 bg-linear-to-r lg:bg-linear-to-b from-[#0170F3] via-[#7766E2] to-[#E64086]"></div>
            <div class="flex flex-col items-center lg:items-start">
              <span class="text-secondary">درباره ما</span>
              <h1 class="text-display-small">گروه مالی نهایت نگر</h1>
            </div>
          </div>
          <p class="text-body-large font-medium leading-8 text-center lg:text-justify">
            گروه مالی نهایت نگر، با بیش از دو دهه فعالیت تخصصی در بازار سرمایه، امروز به‌عنوان یکی از پیشگامان صنعت مالی
            کشور شناخته می‌شود. این مجموعه از سال ۱۳۷۸ با تأسیس شرکت کارگزاری نهایت نگر آغاز به کار کرد و به‌تدریج با
            توسعه زیرساخت‌های فناورانه و جذب سرمایه انسانی متخصص، زنجیره‌ای کامل از خدمات مالی را برای مشتریان حقیقی و
            حقوقی فراهم کرده است.
            <br />
            نهایت نگر با راه‌اندازی شرکت‌های تخصصی در حوزه‌های نرم‌افزار مالی، سبدگردانی، سرمایه‌گذاری بلندمدت و خدمات
            یکپارچه بازار سرمایه، توانسته است نیازهای متنوع سرمایه‌گذاران را به‌صورت حرفه‌ای و هماهنگ پاسخ دهد.
            <br />
            امروز، نهایت نگر نماد تلفیق تجربه، دانش و نوآوری در مدیریت دارایی، مشاوره مالی، طراحی پرتفوی‌های استراتژیک و
            ارائه راهکارهای فناورانه برای بازار سرمایه ایران است.
          </p>
        </div>
      </div>
    </SectionLayer1>

    <SectionLayer1 desktopImage={Section3Img} mobileImage={Section3ImgMob} />
  </main>
</Layout>

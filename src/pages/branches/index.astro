---

<Layout title="شعب و نمایندگی‌ها">
  <main>
    <SectionLayer1 desktopImage={Section1Img} mobileImage={Section1ImgMob}>
      <!-- right -->
      <div class="flex flex-1 items-center self-center" slot="right">
        <div class="flex flex-col items-center gap-8 lg:items-start">
          <span class="text-display-small text-white">شعب و نمایندگی‌ها</span>
          <h1 class="text-center text-body-large text-white">بیش از ۲۰ شعبه در سراسر ایران</h1>
        </div>
      </div>
      <!-- left -->
      <div class="flex-1" slot="left"></div>
    </SectionLayer1>

    <section class="flex bg-fg-primary px-4 py-8 lg:py-16">
      <div class="relative mx-auto flex w-full max-w-lg flex-col gap-8">
        <div class="flex w-full flex-1 flex-col items-center justify-between gap-4 lg:w-auto lg:flex-row">
          <div class="neo-tabs w-full lg:w-auto">
            <button class="neo-tab-label active w-full lg:w-auto" type="button" data-branch-tab="branches">
              شعب
            </button>
            <button class="neo-tab-label w-full lg:w-auto" type="button" data-branch-tab="representativeOffices">
              دفاتر نمایندگی
            </button>
            <button class="neo-tab-label w-full lg:w-auto" type="button" data-branch-tab="marketers">
              بازاریاب‌ها
            </button>
          </div>
          <div class="relative flex w-full lg:w-80">
            <input
              class="flex-1 pl-10"
              type="text"
              name="search"
              placeholder="جستجوی شهر، نشانی و ..."
              aria-label="جستجوی شهر، نشانی و ..."
              aria-controls="branch-list"
              data-branch-search
            />
            <IconSearch class="absolute top-2.5 left-3 h-4 w-4" data-branch-search-icon />
            <button
              class="absolute top-2.5 left-3 hidden cursor-pointer"
              type="button"
              aria-label="پاک کردن جستجو"
              data-branch-search-clear
            >
              <IconClose class="h-4 w-4" />
            </button>
          </div>
        </div>

        <div id="branch-list" class="gap-4 rounded-xl bg-fg-secondary p-2 lg:gap-8 lg:p-8">
          {
            accountGroups.flatMap(({ key, accounts }) =>
              accounts.map(({ city, branch }) => (
                <div class:list={[{ hidden: key !== "branches" }]} data-branch-category={key} data-branch-city={city}>
                  <h4 class="mb-3 text-heading-medium">{city}</h4>
                  <div class="mb-4 flex flex-1 flex-col gap-4">
                    {branch.map((branchItem) => {
                      const { title } = branchItem;
                      const number = (branchItem as { number?: string }).number ?? "";
                      const address = (branchItem as { address?: string }).address ?? "";
                      const data = (branchItem as { data?: { city: string; number: string[] }[] }).data ?? [];
                      const dataSearchText = data
                        .map(({ city: dataCity, number: dataNumbers }) => `${dataCity} ${dataNumbers.join(" ")}`)
                        .join(" ");

                      return (
                        <div
                          class="grid gap-4 rounded-xl bg-fg-primary p-5"
                          data-branch-card
                          data-search-text={`${city} ${title} ${address} ${number} ${dataSearchText}`}
                        >
                          <span class="text-title-medium">{title}</span>
                          {address && <span class="text-body-medium">{address}</span>}
                          {number && <span class="text-body-medium whitespace-pre-wrap text-secondary">{number}</span>}
                          {data.map(({ city: dataCity, number: dataNumbers }) => (
                            <div class="grid gap-2">
                              <span class="text-body-medium font-semibold">{dataCity}</span>
                              {dataNumbers.map((dataNumber) => (
                                <span class="text-body-medium whitespace-pre-wrap text-secondary">{dataNumber}</span>
                              ))}
                            </div>
                          ))}
                        </div>
                      );
                    })}
                  </div>
                </div>
              )),
            )
          }
          <p class="hidden p-4 text-center text-body-medium" data-branch-empty>شعبه‌ای پیدا نشد.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("[data-branch-search]");
  const searchIcon = document.querySelector<SVGElement>("[data-branch-search-icon]");
  const clearSearchButton = document.querySelector<HTMLButtonElement>("[data-branch-search-clear]");
  const branchTabs = document.querySelectorAll<HTMLButtonElement>("[data-branch-tab]");
  const branchGroups = document.querySelectorAll<HTMLElement>("[data-branch-category]");
  const cityGroups = document.querySelectorAll<HTMLElement>("[data-branch-city]");
  const emptyMessage = document.querySelector<HTMLElement>("[data-branch-empty]");
  let activeCategory = "branches";

  const normalize = (value: string) => value.trim().toLocaleLowerCase().replace(/ي/g, "ی").replace(/ك/g, "ک");

  const updateSearchControls = () => {
    const hasSearchTerm = Boolean(searchInput?.value);
    searchIcon?.classList.toggle("hidden", hasSearchTerm);
    clearSearchButton?.classList.toggle("hidden", !hasSearchTerm);
  };

  const updateBranchList = () => {
    const query = normalize(searchInput?.value ?? "");
    let visibleBranches = 0;

    branchGroups.forEach((group) => {
      group.classList.toggle("hidden", group.dataset.branchCategory !== activeCategory);
    });

    cityGroups.forEach((cityGroup) => {
      const belongsToCategory = cityGroup.dataset.branchCategory === activeCategory;
      const cityName = normalize(cityGroup.dataset.branchCity ?? "");
      const cards = cityGroup.querySelectorAll<HTMLElement>("[data-branch-card]");
      let visibleCityBranches = 0;

      cards.forEach((card) => {
        const matches =
          belongsToCategory && normalize(card.dataset.searchText ?? `${cityName} ${card.textContent}`).includes(query);
        card.classList.toggle("hidden", !matches);
        visibleCityBranches += matches ? 1 : 0;
      });

      cityGroup.classList.toggle("hidden", visibleCityBranches === 0);
      visibleBranches += visibleCityBranches;
    });

    emptyMessage?.classList.toggle("hidden", visibleBranches > 0);
  };

  branchTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      activeCategory = tab.dataset.branchTab ?? "branches";
      branchTabs.forEach((item) => item.classList.toggle("active", item === tab));
      updateBranchList();
    });
  });

  searchInput?.addEventListener("input", () => {
    updateSearchControls();
    updateBranchList();
  });

  clearSearchButton?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
      searchInput.dispatchEvent(new Event("input", { bubbles: true }));
      searchInput.focus();
    }
  });
</script>

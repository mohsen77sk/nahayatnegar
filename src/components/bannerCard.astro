---
import type { ImageMetadata } from "astro";

interface Props {
  classes?: string;
  desktopImage?: ImageMetadata;
  mobileImage?: ImageMetadata;
}

const { desktopImage, mobileImage, classes } = Astro.props;
---

<section
  class:list={[
    "flex min-h-72 flex-col justify-between gap-8 rounded-xl bg-fg-primary bg-(image:--bg-mobile) bg-cover bg-center p-8 lg:bg-(image:--bg-desktop)",
    classes,
  ]}
  style={`--bg-desktop: url('${desktopImage?.src}'); --bg-mobile: url('${mobileImage?.src}')`}
>
  <slot />
</section>

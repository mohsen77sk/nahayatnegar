---
import { readFile } from 'node:fs/promises'
import path from 'path';
interface Props {
  src?: string
  class?: string
}

const { src, class: className = '' } = Astro.props

// خواندن فایل SVG از پوشه public
const filePath = path.join(process.cwd(), 'src', 'assets',  src ?? '');
const svgContent = await readFile(filePath, 'utf8')
---

<div class={className} set:html={svgContent??''} />

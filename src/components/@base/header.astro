---
import Logo from "@assets/icons/logo-header.svg";
import LogoNoText from "@assets/icons/logo-no-text.svg";
import MobileMenu from "@assets/icons/iconsax/outline/hamburger-menu.svg";
import Close from "@assets/icons/iconsax/outline/close-x.svg";
import DownArrow from "@assets/icons/iconsax/outline/arrow-down-2.svg";
import Building from "@assets/icons/menu/building.svg";
import Chart from "@assets/icons/menu/graph.svg";
import Learning from "@assets/icons/menu/teacher.svg";
import TwoUser from "@assets/icons/menu/profile-2user.svg";
import Phone from "@assets/icons/menu/call-calling.svg";
import Cards from "@assets/icons/menu/cards.svg";
import Location from "@assets/icons/menu/location.svg";
import Sms from "@assets/icons/menu/sms.svg";
import AboutUsMenuImg from "@assets/images/Nahayatnegar/About Us/about-us-menu.png";

import { siteUrl } from "@utils/url";
import { Image } from "astro:assets";

import { URLS } from "../../scripts/constants";

const menus = [
  {
    title: "کارگزاری",
    width: "322px",
    link: "/brokerage",
  },
  {
    title: "مدیریت دارایی ",
    width: "260px",
    link: "/portfolio-management",
  },
  {
    title: "آموزش",
    width: "260px",
    link: "/learning",
  },
  {
    title: "نهایت‌نگر",
    width: "350px",
    subMenus: [
      {
        title: "درباره ما",
        subTitle: "اطلاعات و تاریخچه شرکت",
        link: "/about-us",
        icon: TwoUser,
      },
      {
        title: "تماس با ما",
        subTitle: "راه‌های ارتباطی",
        link: "/contact-us",
        icon: Phone,
      },
      {
        title: "شماره حساب‌های کارگزاری",
        subTitle: "اطلاعات حساب‌های بانکی",
        link: "/account-numbers",
        icon: Cards,
      },
      {
        title: "شعب و دفاتر پیشخوان",
        subTitle: "آدرس و اطلاعات شعب",
        link: "/branches",
        icon: Location,
      },
    ],
  },
  {
    title: "نئوتریدر",
    width: "260px",
    link: URLS.neoTraderAppAddress,
  },
];

const mobileMenu = [
  {
    title: "کارگزاری",
    icon: Building,
    link: "brokerage",
  },
  {
    title: "مدیریت دارایی ",
    icon: Chart,
    link: "portfolio-management",
  },
  {
    title: "آموزش",
    icon: Learning,
    link: "learning",
  },
  {
    title: "درباره ما",
    icon: TwoUser,
    link: "about-us",
  },
  {
    title: "تماس با ما",
    icon: Phone,
    link: "contact-us",
  },
  {
    title: "شماره حساب‌های کارگزاری",
    icon: Cards,
    link: "account-numbers",
  },
  {
    title: "شعب و دفاتر پیشخوان",
    icon: Location,
    link: "",
  },
];
---

<header
  id="main-header"
  class="fixed inset-x-0 top-3 z-50 mx-auto flex w-full justify-center px-3 transition-all duration-700 ease-in-out lg:pointer-events-none"
>
  <div
    id="header-inner"
    class="flex h-15 w-full max-w-lg items-center justify-between gap-2 rounded-2xl p-4 transition-all duration-700 ease-in-out lg:pointer-events-auto lg:px-6"
  >
    <div class="flex w-full items-center justify-between gap-2">
      <!-- Logo -->
      <a href={siteUrl("/")}>
        <LogoNoText class="m-icon-nav hidden h-8 w-auto text-brand" />
        <Logo class="d-icon-nav block h-8 w-auto text-white" />
      </a>

      <!-- Desktop Menu -->
      <nav class="hidden items-center gap-1 lg:flex lg:gap-2">
        {
          menus.map((menu, i) => {
            const isExternal = menu.link && (/^https?:\/\//i.test(menu.link) || menu.link.startsWith("//"));
            return (
              <div class="group relative">
                <div class="menu-trigger text-base flex cursor-pointer items-center gap-1.5 rounded-md px-3 py-2 text-white transition-all duration-300 hover:bg-[#1C2754]">
                  <a
                    href={siteUrl(menu.link)}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                  >
                    <span> {menu.title} </span>
                  </a>
                  {menu.subMenus && menu.subMenus.length > 0 && (
                    <DownArrow class="block h-4 w-4 transition duration-300 group-hover:rotate-180" />
                  )}
                </div>

                {menu?.subMenus && menu?.subMenus.length > 0 && (
                  <div
                    class="max-w[500px] pointer-events-none invisible absolute top-full right-0 flex w-max flex-col gap-4 rounded-2xl bg-white p-4 opacity-0 transition-[opacity,transform,visibility] duration-300 ease-out group-hover:pointer-events-auto group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
                    style={`min-width: ${menu.width}`}
                  >
                    <div class="absolute -top-2 right-10 h-2 w-4 border-r-7 border-b-7 border-l-7 border-r-transparent border-l-transparent" />

                    <div class="grid grid-cols-2 gap-x-10">
                      {menu.subMenus.map((sub, j) => {
                        const Icon = sub.icon;
                        return (
                          <a
                            href={siteUrl(sub.link)}
                            target={isExternal ? "_blank" : undefined}
                            rel={isExternal ? "noopener noreferrer" : undefined}
                            class="flex min-h-12 min-w-0 items-center gap-3 rounded-lg px-4 py-3 text-body-small leading-5.25 transition-colors duration-150 hover:bg-hover-primary focus-visible:outline-none"
                          >
                            {Icon && <Icon class="shrink-0 text-brand" />}
                            <span class="text-title-medium">{sub.title}</span>
                          </a>
                        );
                      })}
                    </div>
                    <div class="text-xs space-y-3 rounded-lg bg-fg-secondary px-4 py-3 pt-4">
                      <div class="flex items-center gap-3">
                        <div class="font-bold">دفتر مرکزی کارگزاری</div>
                      </div>

                      <div class="flex items-stretch gap-6">
                        <div class="flex flex-col gap-1">
                          <div class="flex items-start gap-2.5 p-2">
                            <Location class="mt-0.5 h-4 w-4 shrink-0 text-brand" />
                            <span class="text-body-small wrap-normal">
                              تهران، خیابان ملاصدرا، شیخ بهایی جنوبی، پلاک ۳۱
                            </span>
                          </div>
                          <div class="flex items-center gap-2.5 p-2">
                            <Phone class="h-4 w-4 shrink-0 text-brand" />
                            <a href="tel:02184450" class="ltr text-body-small">
                              ۰۲۱ ۸۴۴۵۰
                            </a>
                          </div>
                          <div class="flex items-center gap-2.5 p-2">
                            <Sms class="h-4 w-4 shrink-0 text-brand" />
                            <a href="mailto:info@nahayatnegar.com" class="text-body-small">
                              Info@nahayatnegar.com
                            </a>
                          </div>
                        </div>
                        <div class="align-stretch relative w-56 shrink-0 justify-center overflow-hidden rounded-lg">
                          <Image
                            src={AboutUsMenuImg}
                            alt="دفتر مرکزی نهایت‌نگر"
                            class="h-full w-full object-cover"
                            loading="lazy"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            );
          })
        }
      </nav>

      <!-- Desktop CTA -->
      <a class="neo-button neo-button-fill-primary hidden px-4.25 py-1.25 lg:block" href={URLS.registerAddress}>
        افتتاح حساب
      </a>

      <!-- Mobile Menu Button -->
      <div class="flex items-stretch gap-2 lg:hidden">
        <a href={URLS.registerAddress} class="neo-button neo-button-fill-primary"> افتتاح حساب </a>

        <button id="mobile-menu-btn" class="neo-button neo-icon-button items-center bg-[#1C2754] p-1 text-white">
          <MobileMenu class="main-kabab-icon shrink-0" />
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Drawer -->
<aside
  id="mobile-drawer"
  class="shadow-2xl fixed top-0 right-0 z-50 flex h-full w-full max-w-sm translate-x-full flex-col bg-fg-primary transition-transform duration-300 ease-in-out lg:hidden"
  aria-label="منوی موبایل"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-end border-b border-white/10 px-5 py-4">
    <button
      id="drawer-close"
      type="button"
      class="flex size-9 cursor-pointer items-center justify-center rounded-lg transition-colors hover:bg-white/5 hover:text-white"
      aria-label="بستن منو"
    >
      <Close class="h-6 w-6" />
    </button>
  </div>

  <!-- Drawer Content -->
  <div class="flex-1 space-y-6 overflow-y-auto px-4 py-4">
    <ul class="space-y-1">
      {
        mobileMenu.map((menu) => {
          const Icon = menu.icon;
          return (
            <li>
              <a class="flex items-center gap-3 rounded-xl px-5 py-3 transition-colors" href={siteUrl(menu.link)}>
                {Icon && <Icon class="shrink-0 text-brand" />}
                <span class="text-title-medium">{menu.title}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Contact / Info Section -->
    <div class="text-xs space-y-3 rounded-lg bg-fg-secondary px-4 py-3 pt-4">
      <div class="flex items-center gap-3">
        <div class="font-bold">دفتر مرکزی</div>
      </div>

      <div class="relative w-full shrink-0 overflow-hidden rounded-lg">
        <Image src={AboutUsMenuImg} alt="دفتر مرکزی نهایت‌نگر" class="h-full w-full object-cover" loading="lazy" />
      </div>

      <div class="flex items-start gap-2.5 pt-1">
        <Location class="mt-0.5 h-4 w-4 shrink-0 text-brand" />
        <span class="text-body-small">تهران، خیابان ملاصدرا، شیخ بهایی جنوبی، پلاک ۳۱</span>
      </div>

      <div class="flex items-center gap-2.5">
        <Phone class="h-4 w-4 shrink-0 text-brand" />
        <a href="tel:02184450" class="ltr text-body-small"> ۰۲۱ ۸۴۴۵۰ </a>
      </div>

      <div class="flex items-center gap-2.5">
        <Sms class="h-4 w-4 shrink-0 text-brand" />
        <a href="mailto:info@nahayatnegar.com" class="text-body-small"> Info@nahayatnegar.com </a>
      </div>
    </div>
    <a href={siteUrl(URLS.moboTraderAppAddress)} class="neo-button neo-button-large neo-button-fill-primary">
      ورود به موبوتریدر
    </a>
  </div>
</aside>

<script is:inline>
  const headerInner = document.getElementById("header-inner");
  const dIcon = document.querySelector(".d-icon-nav");
  const mIcon = document.querySelector(".m-icon-nav");

  function toggleMenu(button) {
    const content = button.nextElementSibling;
    const li = button.closest("li");
    li.classList.toggle("expanded");

    content.classList.toggle("max-h-0");
    content.classList.toggle("max-h-[1000px]");

    const svg = button.querySelector("svg");
    svg.classList.toggle("rotate-270");
  }

  // منوی موبایل
  const drawer = document.getElementById("mobile-drawer");
  const backdrop = document.getElementById("mobile-drawer-backdrop");
  const menuBtn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("drawer-close");

  function openDrawer() {
    drawer.classList.remove("translate-x-full");
    backdrop.classList.remove("opacity-0", "pointer-events-none");
    backdrop.classList.add("opacity-100");
    document.body.classList.add("overflow-hidden");
  }

  function closeDrawer() {
    drawer.classList.add("translate-x-full");
    backdrop.classList.add("opacity-0", "pointer-events-none");
    backdrop.classList.remove("opacity-100");
    document.body.classList.remove("overflow-hidden");
  }

  menuBtn?.addEventListener("click", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);

  // بستن دراور با کلید Escape
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !drawer.classList.contains("translate-x-full")) {
      closeDrawer();
    }
  });

  function resetHeaderStyles() {
    headerInner.classList.remove("bg-[#102550]/75", "shadow-lg", "lg:py-2", "lg:px-4", "lg:w-md");
    headerInner.classList.add("lg:py-4", "lg:px-6", "w-full");
    mIcon.classList.add("hidden");
    dIcon.classList.remove("hidden");
  }

  function applyScrolledStyles() {
    headerInner.classList.remove("lg:py-4", "px-6");
    headerInner.classList.add("lg:px-4", "bg-[#102550]/75", "backdrop-blur-md", "lg:w-md", "shadow-xl");

    mIcon.classList.remove("hidden");
    dIcon.classList.add("hidden");
  }

  const handleScroll = () => {
    if (window.scrollY > 50) {
      applyScrolledStyles();
    } else {
      resetHeaderStyles();
    }
  };

  window.addEventListener("scroll", handleScroll);
</script>

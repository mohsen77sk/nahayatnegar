---
import { siteUrl } from "@utils/url";
import Instagram from "@assets/icons/iconsax/outline/instagram.svg";
import Whatsapp from "@assets/icons/iconsax/outline/whatsapp.svg";
import Call from "@assets/icons/iconsax/outline/call.svg";
import Map from "@assets/icons/iconsax/outline/map.svg";
import Logo from "@assets/icons/logo-footer.svg";

const phone = "02184450";
const columns = [
  {
    title: "دسترسی سریع",
    links: [
      { label: "سامانه معاملاتی نئوتردیدر", href: "/" },
      { label: "سامانه معاملاتی پرو تریدر", href: "/" },
      { label: "آموزش", href: "/" },
      { label: "کد بورسی و سجام", href: "/" },
    ],
  },
  {
    title: "خدمات",
    links: [
      { label: "صندوق‌های سرمایه‌گذاری", href: "/" },
      { label: "سبد گردانی اختصاصی", href: "/" },
      { label: "کد بورسی و سجام", href: "/" },
    ],
  },
  {
    title: "درباره نهایت‌نگر",
    links: [
      { label: "درباره ما", href: "/about-us" },
      { label: "تماس با ما", href: "/contact-us" },
      { label: "شعب و دفاتر پیشخوان", href: "/branches" },
    ],
  },
];
---

<footer class="flex w-full justify-center px-2">
  <div class="flex w-full max-w-lg flex-col items-center gap-8">
    <!-- Support -->
    <div class="flex w-full flex-col gap-4 border-b border-secondary py-10 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center justify-center gap-3 rounded-full bg-blue-100 px-4 py-2 leading-8 sm:px-6">
        <span>مشاوره و پاسخگویی</span>
        <span class="h-5 w-px bg-blue-300" aria-hidden="true"></span>
        <span>۲۴ ساعته در ۷ روز هفته</span>
      </div>
      <div class="flex justify-end gap-2">
        <a
          href={`tel:${phone}`}
          class="ltr flex flex-1 items-center justify-center rounded-full bg-blue-100 p-2 text-brand sm:px-6 sm:py-3"
        >
          ۰۲۱ ۸۴۴۵۰
        </a>
        <a
          href={`tel:${phone}`}
          class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100"
          aria-label="تماس با کارگزاری نهایت‌نگر"
        >
          <Call class="h-6 w-6 text-brand" aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Main footer -->
    <div class="flex w-full flex-col gap-6 pt-5 sm:gap-10">
      <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-[3fr_1fr_1fr_1fr] sm:gap-x-8">
        <!-- Company -->
        <div class="flex flex-col items-start gap-9">
          <a href="/" aria-label="نهایت‌نگر">
            <Logo aria-hidden="true" />
          </a>
          <div class="flex flex-col gap-4">
            <address class="flex flex-col gap-4 text-sm not-italic">
              <p class="flex gap-2">
                <span>آدرس:</span> <span>تهران، خیابان ملاصدرا، شیخ بهایی جنوبی، پلاک ۳۱</span>
              </p>
              <p class="flex gap-2">
                <span>تماس:</span>
                <span class="ltr">
                  ۰۲۱-{" "}
                  <a href={`tel:${phone}`} class="text-brand">
                    ۸۴۴۵۰
                  </a>
                </span>
              </p>
            </address>
            <a
              class="flex items-center gap-1 py-4 font-bold text-brand"
              href="https://www.google.com/maps/search/?api=1&query=35.XXXXX,51.XXXXX"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="مسیریابی روی نقشه"
            >
              <Map aria-hidden="true" /> <span class="ltr">مسیریابی رو نقشه</span>
            </a>
            <div class="flex gap-4">
              <a href="/" aria-label="واتساپ">
                <Whatsapp aria-hidden="true" />
              </a>
              <a href="/" aria-label="اینستاگرام">
                <Instagram aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
        <!-- Quick links -->
        {columns.map(({ title, links }) => (
          <div class="flex flex-col items-start gap-4">
            <span class="text-sm font-semibold text-brand">{title}</span>

            <nav class="flex flex-col text-sm font-bold">
              {links.map(({ label, href }) => (
                <a class="py-4" href={siteUrl(href)}>
                  {label}
                </a>
              ))}
            </nav>
          </div>
        ))}
      </div>
      <!-- Copyright -->
      <div class="border-t border-secondary py-3 text-body-large font-normal text-secondary">
        تمامی حقوق برای کارگزاری نهایت‌نگر محفوظ است.
      </div>
    </div>
  </div>
</footer>

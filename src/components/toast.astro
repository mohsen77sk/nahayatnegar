<app-toast dir="rtl" aria-label="اعلان‌ها">
  <div data-toast-list></div>
  <template>
    <div class="toast" data-toast>
      <span class="toast-icon" aria-hidden="true">
        <svg class="toast-icon-success" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" fill="currentColor"></circle>
          <path
            d="m7.5 12 3 3 6-6"
            class="toast-icon-detail"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="toast-icon-error" viewBox="0 0 24 24" fill="none">
          <path
            d="M10.2 3.7a2.1 2.1 0 0 1 3.6 0l8 14A2.2 2.2 0 0 1 19.9 21H4.1a2.2 2.2 0 0 1-1.9-3.3l8-14Z"
            fill="currentColor"></path>
          <path d="M12 8v5m0 3v.2" class="toast-icon-detail" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <svg class="toast-icon-warning" viewBox="0 0 24 24" fill="none">
          <path d="m12 1.5 9 5.25v10.5l-9 5.25-9-5.25V6.75l9-5.25Z" fill="currentColor"></path>
          <path d="M12 7v6m0 3v.2" class="toast-icon-detail" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <svg class="toast-icon-info" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" fill="currentColor"></circle>
          <path d="M12 7v6m0 3v.2" class="toast-icon-detail" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </span>
      <div class="toast-content" data-toast-content aria-atomic="true">
        <p class="toast-title" data-toast-title></p>
        <p class="toast-message" data-toast-message></p>
      </div>
      <button type="button" data-toast-close aria-label="بستن اعلان">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="m5 5 6 6m0-6-6 6" stroke="currentColor" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </template>
</app-toast>

<script>
  import type { ToastOptions } from "@utils/toast";

  const titles = {
    success: "عملیات موفقیت‌آمیز بود",
    error: "خطایی رخ داده است",
    warning: "هشدار سیستم",
    info: "اطلاعیه جدید",
  };

  class AppToast extends HTMLElement {
    private timers = new Set<ReturnType<typeof setTimeout>>();

    connectedCallback() {
      document.addEventListener("app:toast", this.show);
    }

    disconnectedCallback() {
      document.removeEventListener("app:toast", this.show);
      this.timers.forEach(clearTimeout);
      this.timers.clear();
    }

    private show = (event: Event) => {
      // Dialogs render above the page: use their toast host while they are open.
      const activeDialog = document.querySelector("dialog[open]");
      if (activeDialog ? !activeDialog.contains(this) : this.closest("dialog")) return;

      const { message, title, type = "success", duration = 6000 } = (event as CustomEvent<ToastOptions>).detail;
      const template = this.querySelector("template");
      const list = this.querySelector("[data-toast-list]");
      if (!template || !list) return;

      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const toast = fragment.querySelector<HTMLElement>("[data-toast]")!;
      const heading = toast.querySelector<HTMLElement>("[data-toast-title]")!;
      const text = toast.querySelector<HTMLElement>("[data-toast-message]")!;
      toast.dataset.type = type;
      toast
        .querySelector("[data-toast-content]")!
        .setAttribute("role", type === "error" || type === "warning" ? "alert" : "status");

      const dismiss = () => {
        clearTimeout(timer);
        this.timers.delete(timer);
        toast.remove();
      };
      const timer = setTimeout(dismiss, duration);
      this.timers.add(timer);
      toast.querySelector("[data-toast-close]")?.addEventListener("click", dismiss);
      list.append(fragment);
      // Populate the live region after it is mounted so assistive tools announce it.
      requestAnimationFrame(() => {
        heading.textContent = title?.trim() || titles[type];
        text.textContent = message;
      });
    };
  }

  if (!customElements.get("app-toast")) customElements.define("app-toast", AppToast);
</script>

<style>
  app-toast {
    position: fixed;
    inset-block-end: max(24px, env(safe-area-inset-bottom));
    inset-inline-end: 16px;
    z-index: 2000;
    width: min(300px, calc(100% - 32px));
    pointer-events: none;
  }

  [data-toast-list] {
    display: grid;
    gap: 8px;
  }

  .toast {
    --toast-background: #2dcc70;

    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 60px;
    padding: 8px;
    border-radius: 8px;
    background: var(--toast-background);
    color: #fff;
    text-align: start;
    pointer-events: auto;
  }

  .toast[data-type="error"] {
    --toast-background: #f23645;
  }

  .toast[data-type="warning"] {
    --toast-background: #ff9800;
  }

  .toast[data-type="info"] {
    --toast-background: #2196f3;
  }

  .toast-icon {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
  }

  .toast-icon svg {
    display: none;
    width: 100%;
    height: 100%;
  }

  .toast[data-type="success"] .toast-icon-success,
  .toast[data-type="error"] .toast-icon-error,
  .toast[data-type="warning"] .toast-icon-warning,
  .toast[data-type="info"] .toast-icon-info {
    display: block;
  }

  .toast-icon-detail {
    stroke: var(--toast-background);
  }

  .toast-content {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 12px;
    line-height: 20px;
  }

  .toast-title {
    margin: 0;
    font-weight: 700;
  }

  .toast-message {
    margin: 0;
    font-weight: 400;
  }

  [data-toast-close] {
    display: flex;
    flex: 0 0 16px;
    align-self: flex-start;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: inherit;
    opacity: 0.8;
    cursor: pointer;
  }

  [data-toast-close] svg {
    width: 16px;
    height: 16px;
  }

  [data-toast-close]:hover {
    opacity: 1;
  }

  [data-toast-close]:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>

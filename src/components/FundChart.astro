---
import { FUND_TIMEFRAMES, isFundTimeframe, type FundTimeframe } from "@utils/fund-chart";

export interface Props {
  fund: string;
  defaultTimeframe?: FundTimeframe;
}

const { fund, defaultTimeframe = "YEARLY" } = Astro.props;
const timeframe = isFundTimeframe(defaultTimeframe) ? defaultTimeframe : "YEARLY";
---

<dynamic-fund-chart class="fund-card" data-fund={fund} data-default-timeframe={timeframe}>
  <div class="flex">
    <div
      class="neo-tabs w-full rounded-full border bg-fg-primary px-4 lg:w-auto"
      role="group"
      aria-label="بازه زمانی نمودار"
    >
      {
        FUND_TIMEFRAMES.map(({ value, label }) => (
          <button
            class:list={["neo-tab-label", { active: value === timeframe }]}
            type="button"
            data-timeframe={value}
            aria-pressed={value === timeframe}
          >
            {label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-4" data-legends aria-label="راهنمای نمودار"></div>
    <div class="flex items-center gap-1 text-body-small">
      <span>بازدهی صندوق</span>
      <span class="flex rounded-lg bg-green-100 px-2 py-1 text-green-500" data-return-rate dir="ltr">--٪</span>
    </div>
  </div>

  <div class="chart-wrapper" data-state="loading" aria-busy="true">
    <div class="chart-status" data-status>
      <p role="status" aria-live="polite" data-status-message>در حال دریافت اطلاعات...</p>
      <button class="neo-button neo-button-light-primary" type="button" data-retry hidden>تلاش دوباره</button>
    </div>
    <canvas role="img" aria-label="نمودار مقایسه بازدهی صندوق و شاخص بازار"></canvas>
    <div class="chart-tooltip" data-tooltip dir="rtl" aria-hidden="true" hidden>
      <div class="mb-1 text-center text-body-small text-secondary" data-tooltip-title></div>
      <div class="flex flex-col gap-2" data-tooltip-rows></div>
    </div>
  </div>

  <template data-legend-template>
    <button class="legend-item flex items-center gap-1 text-body-small" type="button" aria-pressed="true">
      <span class="h-2 w-2 rounded-full" data-dot aria-hidden="true"></span>
      <span data-label></span>
    </button>
  </template>
  <template data-tooltip-template>
    <div class="flex items-center justify-between gap-4 text-body-small">
      <div class="flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full" data-dot></span>
        <span data-label></span>
      </div>
      <span data-value dir="ltr"></span>
    </div>
  </template>
</dynamic-fund-chart>

<script>
  import {
    Chart,
    LineController,
    LineElement,
    PointElement,
    LinearScale,
    CategoryScale,
    Tooltip,
    type TooltipModel,
  } from "chart.js";
  import { fetchFundChart } from "../services/fund-chart.service";
  import { getApiErrorMessage } from "@utils/api-error";
  import {
    isFundTimeframe,
    prepareFundChartData,
    toFarsiDigits,
    type FundChartData,
    type FundTimeframe,
  } from "@utils/fund-chart";

  Chart.register(LineController, LineElement, PointElement, LinearScale, CategoryScale, Tooltip);

  class DynamicFundChart extends HTMLElement {
    private chart: Chart<"line", (number | null)[], string> | null = null;
    private request: AbortController | null = null;
    private events: AbortController | null = null;
    private timeframe: FundTimeframe = "YEARLY";
    private axisLabels: string[] = [];
    private tooltipKey = "";
    private cache = new Map<FundTimeframe, FundChartData>();
    private hiddenSeries = new Set<string>();

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      this.addEventListener("click", this.handleClick, { signal: this.events.signal });
      this.timeframe = isFundTimeframe(this.dataset.defaultTimeframe) ? this.dataset.defaultTimeframe : "YEARLY";
      void this.load(this.timeframe);
    }

    disconnectedCallback() {
      this.request?.abort();
      this.request = null;
      this.events?.abort();
      this.chart?.destroy();
      this.chart = null;
      this.cache.clear();
    }

    private handleClick = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>("button");
      if (!button || button.closest("dynamic-fund-chart") !== this) return;

      const timeframe = button.dataset.timeframe;
      if (isFundTimeframe(timeframe)) {
        if (timeframe !== this.timeframe) void this.load(timeframe);
      } else if (button.hasAttribute("data-retry")) {
        void this.load(this.timeframe);
      } else if (button.dataset.series && this.chart) {
        const index = Number(button.dataset.index);
        const visible = !this.chart.isDatasetVisible(index);
        this.chart.setDatasetVisibility(index, visible);
        this.chart.update();
        button.setAttribute("aria-pressed", String(visible));
        if (visible) this.hiddenSeries.delete(button.dataset.series);
        else this.hiddenSeries.add(button.dataset.series);
      }
    };

    private setState(state: "loading" | "ready" | "empty" | "error", message = "") {
      const wrapper = this.querySelector<HTMLElement>(".chart-wrapper")!;
      wrapper.dataset.state = state;
      wrapper.setAttribute("aria-busy", String(state === "loading"));
      this.querySelector<HTMLElement>("[data-status]")!.hidden = state === "ready";
      this.querySelector<HTMLElement>("[data-status-message]")!.textContent = message;
      this.querySelector<HTMLButtonElement>("[data-retry]")!.hidden = state !== "error";
      this.querySelector<HTMLElement>("[data-legends]")!.hidden = state !== "ready";
      this.querySelector<HTMLElement>("[data-tooltip]")!.hidden = true;
      this.tooltipKey = "";
    }

    private async load(timeframe: FundTimeframe) {
      this.request?.abort();
      const request = new AbortController();
      this.request = request;
      this.timeframe = timeframe;
      this.querySelectorAll<HTMLButtonElement>("[data-timeframe]").forEach((button) => {
        const active = button.dataset.timeframe === timeframe;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      this.setState("loading", "در حال دریافت اطلاعات...");
      const returnRate = this.querySelector<HTMLElement>("[data-return-rate]")!;
      returnRate.textContent = "--٪";
      returnRate.dataset.negative = "false";

      try {
        let data = this.cache.get(timeframe);
        if (!data) {
          const response = await fetchFundChart(this.dataset.fund ?? "", timeframe, request.signal);
          if (this.request !== request || !this.isConnected) return;
          data = prepareFundChartData(response);
          this.cache.set(timeframe, data);
        }

        returnRate.textContent =
          data.returnRate === null
            ? "--٪"
            : `${new Intl.NumberFormat("fa-IR", { maximumFractionDigits: 2 }).format(data.returnRate)}٪`;
        returnRate.dataset.negative = String(data.returnRate !== null && data.returnRate < 0);

        if (!data.series.some((series) => series.values.some((value) => value !== null))) {
          this.setState("empty", "اطلاعاتی برای این بازه زمانی موجود نیست.");
          return;
        }

        this.axisLabels = data.axisLabels;
        this.updateChart(data);
        this.renderLegends(data);
        this.setState("ready");
      } catch (error) {
        if (this.request !== request || !this.isConnected) return;
        this.setState("error", getApiErrorMessage(error, "دریافت اطلاعات نمودار انجام نشد. لطفاً دوباره تلاش کنید."));
      } finally {
        if (this.request === request) this.request = null;
      }
    }

    private renderLegends(data: FundChartData) {
      const template = this.querySelector<HTMLTemplateElement>("[data-legend-template]")!;
      const items = data.series.map((series, index) => {
        const fragment = template.content.cloneNode(true) as DocumentFragment;
        const button = fragment.querySelector("button")!;
        button.dataset.series = series.key;
        button.dataset.index = String(index);
        button.style.color = series.color;
        button.setAttribute("aria-pressed", String(!this.hiddenSeries.has(series.key)));
        fragment.querySelector<HTMLElement>("[data-dot]")!.style.backgroundColor = series.color;
        fragment.querySelector("[data-label]")!.textContent = series.label;
        return fragment;
      });
      this.querySelector("[data-legends]")!.replaceChildren(...items);
    }

    private updateChart(data: FundChartData) {
      const datasets = data.series.map((series) => ({
        label: series.label,
        data: [...series.values],
        hidden: this.hiddenSeries.has(series.key),
        spanGaps: true,
        borderColor: series.color,
        borderWidth: 2,
        tension: 0.35,
        pointRadius: 0,
        pointHoverRadius: 6,
        pointHoverBackgroundColor: series.color,
        pointHoverBorderColor: "#ffffff",
        pointHoverBorderWidth: 2,
      }));

      if (this.chart) {
        this.chart.data = { labels: [...data.labels], datasets };
        data.series.forEach((series, index) =>
          this.chart!.setDatasetVisibility(index, !this.hiddenSeries.has(series.key)),
        );
        this.chart.update();
        return;
      }

      this.chart = new Chart(this.querySelector("canvas")!, {
        type: "line",
        data: { labels: [...data.labels], datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              enabled: false,
              itemSort: (a, b) => (b.parsed.y ?? 0) - (a.parsed.y ?? 0),
              external: ({ tooltip }) => this.renderTooltip(tooltip),
            },
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: {
                font: { family: '"IRANSansX", arial, sans-serif' },
                color: "#131722",
                maxTicksLimit: 12,
                maxRotation: 0,
                callback: (_value, index) => this.axisLabels[index] ?? "",
              },
            },
            y: {
              position: "left",
              border: { dash: [4, 4] },
              grid: { color: "#f4edef" },
              ticks: {
                font: { family: '"IRANSansX", arial, sans-serif' },
                color: "#131722",
                callback: (value) => toFarsiDigits(value),
              },
            },
          },
        },
      });
    }

    private renderTooltip(tooltip: TooltipModel<"line">) {
      const element = this.querySelector<HTMLElement>("[data-tooltip]")!;
      element.hidden = tooltip.opacity === 0 || element.parentElement?.dataset.state !== "ready";
      if (element.hidden || !this.chart) return;

      const key = JSON.stringify([
        tooltip.title,
        tooltip.dataPoints.map((point) => [point.datasetIndex, point.dataIndex, point.parsed.y]),
      ]);
      if (key !== this.tooltipKey) {
        this.tooltipKey = key;
        element.querySelector("[data-tooltip-title]")!.textContent = tooltip.title.join(" · ");
        const template = this.querySelector<HTMLTemplateElement>("[data-tooltip-template]")!;
        const rows = tooltip.dataPoints.map((point) => {
          const fragment = template.content.cloneNode(true) as DocumentFragment;
          const color = typeof point.dataset.borderColor === "string" ? point.dataset.borderColor : "#9ca3af";
          fragment.querySelector<HTMLElement>("[data-dot]")!.style.backgroundColor = color;
          fragment.querySelector("[data-label]")!.textContent = point.dataset.label ?? "";
          const value = fragment.querySelector<HTMLElement>("[data-value]")!;
          value.textContent = point.parsed.y === null ? "—" : `${toFarsiDigits(point.parsed.y)}٪`;
          value.style.color = color;
          return fragment;
        });
        element.querySelector("[data-tooltip-rows]")!.replaceChildren(...rows);
      }

      const wrapper = element.parentElement!;
      const canvas = this.chart.canvas;
      const x = canvas.offsetLeft + tooltip.caretX;
      const y = canvas.offsetTop + tooltip.caretY;
      element.style.left = `${Math.max(8, Math.min(x - element.offsetWidth / 2, wrapper.clientWidth - element.offsetWidth - 8))}px`;
      const above = y - element.offsetHeight - 12;
      element.style.top = `${Math.max(8, Math.min(above >= 8 ? above : y + 12, wrapper.clientHeight - element.offsetHeight - 8))}px`;
    }
  }

  if (!customElements.get("dynamic-fund-chart")) customElements.define("dynamic-fund-chart", DynamicFundChart);
</script>

<style>
  [data-return-rate][data-negative="true"] {
    background-color: var(--color-red-100);
    color: var(--color-red-500);
  }

  .fund-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    direction: rtl;
  }

  .chart-wrapper {
    position: relative;
    width: 100%;
    height: 380px;
    padding: 24px 16px;
    border-radius: 8px;
    background: var(--background-color-fg-primary);
    direction: ltr;
    font-family: var(--default-font-family);
  }

  .chart-wrapper:not([data-state="ready"]) canvas {
    visibility: hidden;
  }

  .chart-status {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 16px;
    color: var(--color-brand);
    text-align: center;
    direction: rtl;
  }

  .chart-tooltip {
    position: absolute;
    z-index: 2;
    width: max-content;
    min-width: 140px;
    max-width: calc(100% - 16px);
    padding: 8px 16px;
    overflow-wrap: anywhere;
    border-radius: var(--radius-xl);
    background: var(--background-color-fg-primary);
    box-shadow: var(--shadow-primary);
    pointer-events: none;
  }

  .legend-item {
    cursor: pointer;
  }

  .legend-item[aria-pressed="false"] {
    opacity: 0.4;
    filter: grayscale(100%);
  }

  .legend-item:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
  }

  [hidden] {
    display: none !important;
  }
</style>

---
import type { ImageMetadata } from "astro";

interface Props {
  classes?: string;
  desktopImage?: ImageMetadata;
  mobileImage?: ImageMetadata;
}

const { desktopImage, mobileImage, classes } = Astro.props;
---

<section
  class:list={["flex min-h-150 bg-cover bg-center bg-no-repeat px-4 py-8 lg:py-16", classes]}
  style={`--desktop-bg: url('${desktopImage?.src}'); --mobile-bg: url('${mobileImage?.src}')`}
>
  <div class="relative mx-auto flex w-full max-w-lg flex-col lg:flex-row">
    <slot />
    <div class="hidden flex-1 lg:flex"></div>
  </div>
</section>

<style>
  section {
    background-image: var(--mobile-bg);
  }

  @media (min-width: 1200px) {
    section {
      background-image: var(--desktop-bg);
    }
  }
</style>

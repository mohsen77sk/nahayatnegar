---
import type { ImageMetadata } from "astro";

interface Props {
  classes?: string;
  desktopImage?: ImageMetadata;
  mobileImage?: ImageMetadata;
}

const { desktopImage, mobileImage, classes } = Astro.props;
---

<section
  class:list={["flex min-h-150 py-8 lg:py-16 px-4 bg-center bg-cover bg-no-repeat", classes]}
  style={`--desktop-bg: url('${desktopImage?.src}'); --mobile-bg: url('${mobileImage?.src}')`}
>
  <div class="flex flex-col lg:flex-row max-w-lg w-full mx-auto relative">
    <slot />
    <div class="hidden lg:flex flex-1"></div>
  </div>
</section>

<style>
  section {
    background-image: var(--mobile-bg);
  }

  @media (min-width: 1200px) {
    section {
      background-image: var(--desktop-bg);
    }
  }
</style>

---
import type { ImageMetadata } from "astro";

interface Props {
  desktopImage: ImageMetadata;
  mobileImage: ImageMetadata;
}

const { desktopImage, mobileImage } = Astro.props;
---

<section
  class="flex min-h-225 py-8 lg:py-16 px-4 bg-center bg-cover bg-no-repeat"
  style={`--desktop-bg: url('${desktopImage.src}'); --mobile-bg: url('${mobileImage.src}')`}
>
  <div class="flex gap-4 max-w-lg w-full m-auto">
    <slot name="right" />
    <slot name="left" />
  </div>
</section>

<style>
  section {
    background-image: var(--mobile-bg);
  }

  @media (min-width: 1200px) {
    section {
      background-image: var(--desktop-bg);
    }
  }
</style>

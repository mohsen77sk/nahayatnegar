---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  classes?: string;
  desktopImage?: ImageMetadata;
  mobileImage?: ImageMetadata;
  hasGap?: boolean;
}

const { desktopImage, mobileImage, hasGap = true, classes } = Astro.props;
const desktopBackground = desktopImage ? await getImage({ src: desktopImage, format: "webp" }) : undefined;
const mobileBackground =
  mobileImage === desktopImage
    ? desktopBackground
    : mobileImage
      ? await getImage({ src: mobileImage, format: "webp" })
      : undefined;
---

<section
  class:list={[
    "flex min-h-225 bg-(image:--bg-mobile) bg-cover bg-center bg-no-repeat px-4 py-8 lg:bg-(image:--bg-desktop) lg:py-16",
    classes,
  ]}
  style={`--bg-desktop: url('${desktopBackground?.src}'); --bg-mobile: url('${mobileBackground?.src}')`}
>
  <div class:list={["relative mx-auto flex w-full max-w-lg flex-col lg:flex-row", { "gap-4": hasGap }]}>
    <slot name="right" />
    <slot name="left" />
  </div>
</section>

---
interface Props {
  desktopVideo: string;
  mobileVideo: any;
  poster?: any;
  hasGap?: boolean;
}

const { desktopVideo, mobileVideo, poster, hasGap } = Astro.props;
---

<section class="bg-center bg-cover bg-no-repeat relative flex min-h-225 py-8 lg:py-16 px-4 overflow-hidden">
  <!-- Background video -->
  <video
    class="absolute inset-0 h-full w-full object-cover z-0"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster}
  >
    <source src={desktopVideo} media="(min-width: 1200px)" type="video/mp4" />
    <source src={mobileVideo} type="video/mp4" />
  </video>

  <div class:list={["flex flex-col lg:flex-row max-w-lg w-full mx-auto relative", { "gap-4": hasGap }]}>
    <slot name="right" />
    <slot name="left" />
  </div>
</section>

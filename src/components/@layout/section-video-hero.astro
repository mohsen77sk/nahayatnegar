---
interface Props {
  desktopVideo: string;
  mobileVideo: any;
  poster?: any;
  hasGap?: boolean;
}

const { desktopVideo, mobileVideo, poster, hasGap } = Astro.props;
---

<section class="relative flex min-h-225 overflow-hidden bg-cover bg-center bg-no-repeat px-4 py-8 lg:py-16">
  <!-- Background video -->
  <video
    class="absolute inset-0 z-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster}
  >
    <source src={desktopVideo} media="(min-width: 1200px)" type="video/mp4" />
    <source src={mobileVideo} type="video/mp4" />
  </video>

  <div class:list={["relative mx-auto flex w-full max-w-lg flex-col lg:flex-row", { "gap-4": hasGap }]}>
    <slot name="right" />
    <slot name="left" />
  </div>
</section>

---
export interface StepItem {
  title: string;
  description: string;
  icon: any;
}

export interface Props {
  title: string;
  steps: StepItem[];
}

const { title, steps } = Astro.props;
---

<div class="flex flex-col gap-6 rounded-xl bg-fg-primary p-6">
  <h2 class="text-heading-medium leading-10">{title}</h2>
  <div class="flex flex-col">
    {steps.map((step) => {
      const IconComponent = step.icon;
      return (
        <div class="group relative flex items-start gap-4 pb-10 last:pb-0">
          <div class="relative flex flex-col items-center shrink-0"></div>
          <div class="flex items-start gap-4 z-10">
            <div class="group-last:hidden absolute top-6.5 -bottom-10 right-10 -translate-x-1/2 w-px border-r border-dashed border-secondary"></div>

            <div class="z-10 flex items-center justify-center w-13 h-13 bg-blue-100 rounded-full">
              <IconComponent class="text-brand" />
            </div>
          </div>

          <div class="flex flex-col gap-2 min-w-0 pt-2.5">
            <span class="text-title-medium"> {step.title}</span>
            <span class="text-body-medium text-secondary">{step.description}</span>
          </div>
        </div>
      );
    })}
  </div>
</div>

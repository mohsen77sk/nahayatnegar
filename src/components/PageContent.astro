---
import BreadCrumb from "@components/bread-crumb.astro";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  classes: string;
}

const { items, classes } = Astro.props;
---

<section class={classes}>
  <BreadCrumb items={items} />
  <slot />
</section>
